#!/bin/sh
# hostwarden-impact — what a disruptive step on a host reaches
# beyond that host, computed from memory and `ssh -G` alone
# (rules/coordination.md → Blast radius).
#
# Usage:
#   hostwarden-impact radius <host>... <kind>
#       One line per host the step reaches, the origins first:
#         <host> <relation> <through> [<detail>]
#       <relation> is origin, guest, via, behind, reached, depends,
#       cluster or unreadable; <through> is the host it is reached
#       through, - for an origin or an unreadable path; <detail> is
#       the rest of the line: a guest's ID, the hop, the dependency's
#       words, the cluster's name
#   hostwarden-impact radius --report <host>... <kind>
#       The same radius for a person: grouped by relation, each
#       host with its Role: and service lines, the oldest record it
#       relied on, and the hosts only registered, never onboarded
#   hostwarden-impact radius --jumps <host>...
#       The hosts grouped by the jump hosts they share, for
#       rules/multi-host.md → Order: one line per group,
#       "group <host>...", and "unreadable <host>" for each host
#       whose path cannot be read
#   hostwarden-impact announce <host>... <kind> [<minutes>]
#       Computes the radius, then the local sessions its presence
#       map shows on a radius host, and prints the impact's id
#       followed by one "<session> <host> <status>" line per
#       affected session (run, writer or idle), or "no live
#       session on the radius" where none is. <minutes> defaults
#       to 10 for reboot, 5 for network, 2 for firewall and for a
#       restart (rules/coordination.md → Announce, wait, go). Exit
#       status: 0 announced (affected or not), 1 the radius could
#       not be computed, 2 usage
#       In a team — two or more active handles in memory/operators.md
#       — it also writes a register entry and a journal line on each
#       radius host it may reach, then prints "team: register entry
#       and journal line on <k> of <n> hosts" and one line for each
#       host that did not get both: "journal only: <host> (<why>)",
#       "register only: <host> (<why>)" or "no entry: <host> (<why>)"
#       (rules/coordination.md → Teams)
#   hostwarden-impact wait <id>
#       Blocks up to two minutes until every session announce
#       found is safe: no run on a radius host, and every writer
#       there has acked safe. Prints "all safe" and exits 0 once
#       it is, or the sessions still not safe and exits 1 when the
#       two minutes run out
#   hostwarden-impact ack <id> safe|busy <words>...
#       Records this session's own answer to impact <id>, read by
#       wait on the origin session
#   hostwarden-impact done <id>
#       Ends impact <id>, and in a team removes the register entries
#       announce made. Idempotent: gone already is not an error
#   hostwarden-impact status <host>
#       Prints one line per active impact whose radius covers
#       <host>: "<origin> <kind> by <session> until <HH:MM>;
#       <host> <relation> <through>", then, where a planned
#       Downtime: window on <host> covers the current time
#       (rules/maintenance-windows.md), one line: "<host> is inside
#       its planned window <date> <start>-<end> (plan <slug>)". A
#       window whose plan file is missing, or whose Window: line
#       names no zone `date`/`date -j` can parse, is left out rather
#       than guessed at. Exit status: 0 either kind of line printed,
#       1 neither, 2 usage
#   hostwarden-impact coordinator
#       Prints the session of each live coordinator of this checkout
#       (rules/coordination.md → The coordinator) and exits 0, or
#       exits 1 where none is: an entry coordinator+<session>+<beat>
#       beside presence/ whose session `claude agents --json` lists,
#       or, without the claude CLI, whose beat is under 30 minutes
#       old. Marks nothing
#   hostwarden-impact watch
#       The coordinator's own run, for Monitor. Marks this session as
#       the coordinator, or exits 1 with "another coordinator runs:
#       <session>" where one was there first — or, when two marked
#       themselves at once, has the smaller session id. Then every 5
#       seconds it prints "+ <item>" or "- <item>" for each change
#       among the live touched and writer presence entries
#       ("presence <session> <host> touched|writer"), the impacts
#       ("impact <entry name>"), the acks ("ack <id> <session>") and
#       the plans ("plan <file> <checksum>"); "tick <HH:MM>" every 15
#       minutes while a plan has a Window: line; and renews its mark
#       every 5, exiting 1 as above once another coordinator stays
#   hostwarden-impact --help
#       Show this help
#
# <kind> is reboot, network, firewall or restart:<unit>. The first
# three, and a restart of a unit on the SSH path, of the firewall
# or of the network, take the whole radius: the host is out, and
# with it its guests and every host reached through it, and each
# host that is out takes along the hosts that depend on it and its
# cluster peers. Any other restart takes only the hosts whose
# Depends on: names that service of the host.
#
# Local and read-only: it connects to nothing. The graph it reads
# from memory and `ssh -G` is kept in radius.idx under
# ~/.cache/hostwarden/ws-<checkout ID>/ (mode.sh →
# hostwarden_cache_dir) and rebuilt whenever memory, memory/user.md,
# memory/ssh_config or a file of the SSH configuration it includes
# is newer: each file ssh -G read for the index, kept in radius-sources
# beside it, and any under ~/.ssh or /etc/ssh.
# Its format is this script's own; what other scripts read is the
# output above.
#
# announce, wait, ack, done and status read and write the presence
# map .claude/hooks/presence.sh keeps beside the index, under
# presence/, and their own state under impact/ — one directory per
# announced impact, named <id>+<origin>+<kind>+<until>+<session>
# (<origin> several hosts joined by a comma, <until> the epoch
# second the window ends, <session> $HOSTWARDEN_SESSION or a
# fallback of this process's own), holding radius/<host>+<relation>
# +<through> for each host the radius named, once a writer answers
# ack/<session>, and in a team remote/<host> for each host that got
# a register entry. Their format is this script's own too
# (rules/coordination.md → Announce, wait, go).
#
# The calls to radius hosts in a team are the only connections this
# script makes. They skip the pipeline of rules/first-connection.md,
# so they go only where it has run before: a host with memory, an SSH
# user, a key in memory/known_hosts, nothing on memory/blacklist.md
# on its way in, and never a first connection.
#
# Exit status: 0 done, 1 it could not be computed, 2 usage.
set -u

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_DIR" || exit 1
# shellcheck source=../lib/mode.sh
. lib/mode.sh
# shellcheck source=../lib/hops.sh
. lib/hops.sh
# shellcheck source=../lib/coord-tokenize.sh
. lib/coord-tokenize.sh
# shellcheck source=../lib/coord-lib.sh
. lib/coord-lib.sh
# shellcheck source=../lib/resolve.sh
. lib/resolve.sh

usage() {
  awk 'NR == 1 { next } /^[^#]/ { exit } { sub(/^# ?/, ""); print }' \
    "$SCRIPT_DIR/${0##*/}"
}
die() { echo "hostwarden-impact: $*" >&2; exit 1; }

# impact_setup — the operations-mode check and the cache directory
# announce, wait, ack, done and status all need; sets M and
# HOSTWARDEN_CACHE and creates the latter. radius keeps its own
# copy below, since it also needs ssh and memory/ssh_config, which
# the rest never touch.
impact_setup() {
  hostwarden_mode "$REPO_DIR"
  [ "$HOSTWARDEN_MODE" = operations ] \
    || die "reads the memory of an operations checkout, which this is not (AGENTS.md)"
  M=memory
  hostwarden_cache_dir "$REPO_DIR"
  # shellcheck disable=SC2174
  mkdir -p -m 700 "$HOSTWARDEN_CACHE" || die "cannot create $HOSTWARDEN_CACHE"
}

# shellcheck disable=SC2034 # read in lib/hostwarden-impact/
TAB=$(printf '\t')

# The subcommands' functions live in lib/hostwarden-impact/, one file
# per stage, sourced in this order into this shell: each reads what
# the ones before it set. The radius stages come after the dispatch
# below, since they run rather than define.
PARTS='session team announce watch'
for part in $PARTS; do
  [ -f "$REPO_DIR/lib/hostwarden-impact/$part.sh" ] || {
    echo "${0##*/}: lib/hostwarden-impact/$part.sh is missing" >&2
    exit 1
  }
done
for part in $PARTS; do
  # shellcheck source=/dev/null
  . "$REPO_DIR/lib/hostwarden-impact/$part.sh"
done

MODE='' KIND='' TARGETS='' last=''
case ${1:-} in
  radius) shift ;;
  announce) shift; do_announce "$@"; exit $? ;;
  wait) shift; do_wait "$@"; exit $? ;;
  ack) shift; do_ack "$@"; exit $? ;;
  done) shift; do_done "$@"; exit $? ;;
  status) shift; do_status "$@"; exit $? ;;
  coordinator) shift; do_coordinator "$@"; exit $? ;;
  watch) shift; do_watch "$@"; exit $? ;;
  -h | --help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
for a in "$@"; do
  case $a in
    -h | --help) usage; exit 0 ;;
    --report | --jumps)
      [ -z "$MODE" ] || { usage >&2; exit 2; }
      MODE=${a#--} ;;
    -*) usage >&2; exit 2 ;;
    *)
      # A name never holds a space, a quote or a path, and is never
      # read as an option by ssh.
      case $a in *[!A-Za-z0-9@._:%-]*) usage >&2; exit 2 ;; esac
      TARGETS="$TARGETS $last" last=$a ;;
  esac
done
# The last word is the kind, except for --jumps.
if [ "$MODE" = jumps ]; then
  TARGETS="$TARGETS $last"
else
  KIND=$last
  case $KIND in
    reboot | network | firewall) ;;
    restart:?*) case ${KIND#restart:} in *[!A-Za-z0-9@._:-]*) usage >&2; exit 2 ;; esac ;;
    *) usage >&2; exit 2 ;;
  esac
fi
case $TARGETS in *[!\ ]*) ;; *) usage >&2; exit 2 ;; esac

hostwarden_mode "$REPO_DIR"
[ "$HOSTWARDEN_MODE" = operations ] \
  || die "reads the memory of an operations checkout, which this is not (AGENTS.md)"
command -v ssh >/dev/null 2>&1 || die "ssh is missing"

# shellcheck disable=SC2034 # read in lib/hostwarden-impact/
M=memory
SSHCFG=$REPO_DIR/memory/ssh_config
[ -r "$SSHCFG" ] || sh bin/hostwarden-ssh-config >&2
[ -r "$SSHCFG" ] || die "no memory/ssh_config, and bin/hostwarden-ssh-config wrote none"

hostwarden_cache_dir "$REPO_DIR"
# shellcheck disable=SC2174
mkdir -p -m 700 "$HOSTWARDEN_CACHE" || die "cannot create $HOSTWARDEN_CACHE"
# shellcheck disable=SC2034 # read in lib/hostwarden-impact/
IDX=$HOSTWARDEN_CACHE/radius.idx
# shellcheck disable=SC2034 # read in lib/hostwarden-impact/
SRC=$HOSTWARDEN_CACHE/radius-sources
WORK=$(mktemp -d "${TMPDIR:-/tmp}/hostwarden-impact.XXXXXX") || die "no temp directory"
trap 'rm -rf "$WORK"' EXIT INT TERM

# radius: its stages, in the same directory, run in this order.
PARTS='memory radius report'
for part in $PARTS; do
  [ -f "$REPO_DIR/lib/hostwarden-impact/$part.sh" ] || {
    echo "${0##*/}: lib/hostwarden-impact/$part.sh is missing" >&2
    exit 1
  }
done
for part in $PARTS; do
  # shellcheck source=/dev/null
  . "$REPO_DIR/lib/hostwarden-impact/$part.sh"
done
