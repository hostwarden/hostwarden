#!/bin/sh
# hostwarden-tofu — an OpenTofu stack of the user's own, checked,
# planned and applied from this operations checkout, by the session
# or by the user from a terminal (rules/opentofu.md).
#
# Usage:
#   hostwarden-tofu <stack> check       fmt, init without backend,
#                                       validate, then tflint, Trivy
#                                       and Checkov where installed;
#                                       stops at the first failure
#   hostwarden-tofu <stack> plan [args] init where needed, then a plan
#                                       saved outside the workspace and
#                                       one summary line
#   hostwarden-tofu <stack> review      the saved plan, readable, and
#                                       every change by action
#   hostwarden-tofu <stack> apply       the saved plan, when it deletes
#                                       and replaces nothing and the
#                                       tree's Deployment is local or
#                                       mixed; the taboo guard asks the
#                                       user first, every time
#   hostwarden-tofu <stack> apply --destroys
#                                       the saved plan whatever it does:
#                                       the user's command alone, which
#                                       the guard denies the session
#   hostwarden-tofu <stack> drift       plan -refresh-only: exit 4 when
#                                       the real resources drifted
#   hostwarden-tofu <stack> test        tofu test, when every run block
#                                       plans, or the file mocks every
#                                       provider the tree requires
#   hostwarden-tofu <stack> test --applies
#                                       tofu test whatever it does: the
#                                       user's command alone
#   hostwarden-tofu <stack> fmt [args]  tofu fmt: formats the tree's
#                                       .tf files in place; paths
#                                       inside the tree
#   hostwarden-tofu <stack> init|validate|show|output|providers|
#                           graph|version|state list|state show|
#                           workspace list|show|select [args]
#                                       passed through, run in the tree
#   hostwarden-tofu --help
#
# <stack> is memory/infra/opentofu/<stack>/, or the name of a tree
# memory/user.md records under `# Infrastructure code`
# (lib/infra.sh). A stack with a terragrunt.hcl runs through
# terragrunt, with tofu behind it. Credentials come from the tree's
# secrets.env and the user's ~/hostwarden-keys/infra/opentofu/<stack>/
# (lib/infra.sh → Credentials); none is printed. The plan lives
# under this checkout's cache directory (lib/mode.sh →
# hostwarden_cache_dir), mode 600.
#
# Every other verb, and every option the header above does not name,
# is refused with exit 3: destroy, import, taint, untaint,
# force-unlock, state rm/mv/push/pull, workspace new/delete and
# select -or-create, providers mirror, a migration, and
# -auto-approve, -lock=false, -show-sensitive, -destroy, -target,
# -test-directory, a -var naming a secret, output -json or -raw and
# show -json, whose text can carry secrets into the session. The user
# runs those at a terminal, with the bare tool.
#
# Exit status: 0 done (a plan with changes included), 1 the tool
# failed, 2 a usage error, 3 refused, 4 drift found.

set -u
case $0 in */*) ROOT=${0%/*}/.. ;; *) ROOT=.. ;; esac
ROOT=$(cd "$ROOT" && pwd -P) || exit 1
# shellcheck source=../lib/mode.sh
. "$ROOT/lib/mode.sh"
# shellcheck disable=SC2034 # read by lib/passwords.sh and lib/infra.sh
PW_ROOT=$ROOT INFRA_ROOT=$ROOT INFRA_PROG=hostwarden-tofu
# shellcheck source=../lib/passwords.sh
. "$ROOT/lib/passwords.sh"
# shellcheck source=../lib/infra.sh
. "$ROOT/lib/infra.sh"

usage() {
  awk 'NR == 1 { next } /^[^#]/ { exit } { sub(/^# ?/, ""); print }' "$0"
}

case ${1:-} in
  -h|--help) usage; exit 0 ;;
  ''|-*) usage >&2; exit 2 ;;
esac
STACK=$1
shift
[ $# -ge 1 ] || { usage >&2; exit 2; }
VERB=$1
shift

infra_operations
infra_path
infra_tree opentofu "$STACK"
hostwarden_cache_dir "$ROOT"

pw_has tofu || infra_die "tofu is not installed: bin/hostwarden-doctor says how"
TOOL=tofu
if [ -f "$INFRA_TREE/terragrunt.hcl" ]; then
  pw_has terragrunt || infra_die "$INFRA_TREE has a terragrunt.hcl and" \
    "terragrunt is not installed: bin/hostwarden-doctor says how"
  TOOL=terragrunt
  TG_TF_PATH=$(command -v tofu) TG_NON_INTERACTIVE=true
  export TG_TF_PATH TG_NON_INTERACTIVE
fi
TF_IN_AUTOMATION=1 TF_INPUT=0
export TF_IN_AUTOMATION TF_INPUT

# The plan lives outside the workspace, since it can carry secrets
# in the clear (rules/secrets.md), one per stack and checkout.
PLANDIR=$HOSTWARDEN_CACHE/tofu
PLAN=$PLANDIR/$INFRA_TREE_WHERE-$INFRA_TREE_NAME.tfplan

# operator <args…> — the block the user types, for what this program
# refuses the session: the same program, so the credentials and the
# terragrunt detour come with it.
operator() {
  echo "  $ROOT/bin/hostwarden-tofu $STACK $*" >&2
}

# refused_arg <args…> — exits 3 on an option the header keeps from
# the session, whatever the verb.
# A boolean flag is on bare or with =true, =t, =T, =1 (Go's flag
# package); -lock is off with =false, =f, =F, =0. The case patterns
# below spell both.
refused_arg() {
  for ra; do
    case $ra in
      -auto-approve|--auto-approve|-auto-approve=[tT1]*|--auto-approve=[tT1]*)
        infra_refuse "-auto-approve skips the plan review" ;;
      -lock=[fF0]*|--lock=[fF0]*)
        infra_refuse "-lock=false runs beside another session's apply" ;;
      -show-sensitive|--show-sensitive|-show-sensitive=[tT1]*|--show-sensitive=[tT1]*)
        infra_refuse "-show-sensitive prints secrets" ;;
      -destroy|--destroy|-destroy=[tT1]*|--destroy=[tT1]*)
        infra_refuse "a destroy plan deletes every resource of the stack" ;;
      -target|--target|-target=*|--target=*)
        infra_refuse "-target plans a part of the stack, which OpenTofu" \
          "keeps for repairs" ;;
      -json|--json|-json=[tT1]*|--json=[tT1]*)
        [ "$VERB" = plan ] || [ "$VERB" = drift ] ||
        infra_refuse "-json prints every value, sensitive ones included" ;;
      -raw|--raw|-raw=[tT1]*|--raw=[tT1]*)
        infra_refuse "output -raw prints a value unredacted" ;;
      -or-create|--or-create|-or-create=[tT1]*|--or-create=[tT1]*)
        infra_refuse "workspace select -or-create creates a state" ;;
      -test-directory|--test-directory|-test-directory=*|--test-directory=*)
        infra_refuse "only the tree's own tests are read for what they apply" ;;
      -migrate-state|--migrate-state|-force-copy|--force-copy|-reconfigure|--reconfigure|-migrate-state=[tT1]*|--migrate-state=[tT1]*|-force-copy=[tT1]*|--force-copy=[tT1]*|-reconfigure=[tT1]*|--reconfigure=[tT1]*)
        infra_refuse "a backend migration copies or replaces the state" ;;
    esac
  done
  infra_refuse_secret_args -var --var "$@"
  # The S3 backend's key is the state's path, not a secret; its
  # secret_key and a password or token are.
  # shellcheck disable=SC2034 # read by infra_secret_word
  INFRA_SECRET_NOKEY=1
  infra_refuse_secret_args -backend-config --backend-config "$@"
  unset INFRA_SECRET_NOKEY
}

# step <label> <command…> — one step of check: its output passes
# through, a failure ends the run with the step named.
step() {
  st_label=$1
  shift
  echo "== $st_label"
  "$@" || infra_die "$st_label failed; fix the tree before a plan"
}

# skipped <label> <tool> — a checker that is not installed is named
# as such, never silently left out.
skipped() {
  echo "== $1: skipped, $2 is not installed (bin/hostwarden-doctor)"
}

# init_backend [-backend=false] — the backend initialised before a verb
# that reads it: a check leaves a .terraform without one, and a fresh
# clone has none. The output is shown only when init fails.
init_backend() {
  # Not through $( ): the credentials are read once per process, and a
  # subshell would lose that. -backend=false for a verb that needs the
  # providers and modules only.
  ib_f=$(mktemp "${TMPDIR:-/tmp}/hostwarden-tofu.XXXXXX") || exit 1
  if infra_run "$TOOL" init -input=false "$@" > "$ib_f" 2>&1; then
    rm -f "$ib_f"
  else
    cat "$ib_f" >&2
    rm -f "$ib_f"
    infra_die "init failed"
  fi
}

# plan_json <jq program> — the saved plan as JSON, piped into jq
# alone: nothing of it is written or printed by itself. One tofu
# start per call, so each verb calls it once; with the credentials,
# since an encrypted plan or a terragrunt stack needs them to read.
# Its status is jq's, which an empty input leaves at 0, so a caller
# that decides on the output checks the output.
plan_json() {
  pw_has jq ||
    infra_die "jq is needed to read the plan: bin/hostwarden-doctor says how"
  infra_run "$TOOL" show -json "$PLAN" | jq -r "$1"
}

# The summary line, and after it the changes by action where asked.
# shellcheck disable=SC2016 # jq programs, not shell
SUMMARY='[.resource_changes[]? | .change.actions] as $a
  | "plan: \($a | map(select(. == ["create"])) | length) to add, "
    + "\($a | map(select(. == ["update"])) | length) to change, "
    + "\($a | map(select(. == ["delete"])) | length) to destroy, "
    + "\($a | map(select(length == 2)) | length) to replace"'
# shellcheck disable=SC2016
BY_ACTION='.resource_changes[]?
  | select(.change.actions != ["no-op"])
  | "  \(.change.actions | join("/"))\t\(.address)"'
# shellcheck disable=SC2016
DELETES='[.resource_changes[]? | select(.change.actions | index("delete"))] | length'

# applying_tests — the test files whose run blocks apply: more run
# blocks than command = plan, and not every provider the tree requires
# or uses mocked in the file (a resource type's prefix names the
# provider it uses, declared or not). A tree that names no provider, or a file that
# mocks none, counts as applying; so does a test whose providers
# cannot be read.
applying_tests() {
  at_req=$(find "$INFRA_TREE" -name '*.tf' -not -path '*/.terraform/*' \
      -exec awk '
        /required_providers[[:space:]]*\{/ { on = 1; depth = 0 }
        on {
          line = $0
          if (depth == 1 && match(line, /^[[:space:]]*[A-Za-z0-9_-]+[[:space:]]*=/)) {
            nm = substr(line, RSTART, RLENGTH)
            sub(/^[[:space:]]*/, "", nm); sub(/[[:space:]]*=$/, "", nm)
            print nm
          }
          depth += gsub(/\{/, "{", line) - gsub(/\}/, "}", line)
          if (depth <= 0) on = 0
        }
        # A provisioner runs a command for real, whatever is mocked:
        # a tree that has one leaves every apply test to the user.
        /^[[:space:]]*provisioner[[:space:]]+"/ { print "__provisioner__" }
        # A provider a resource uses without declaring it: the
        # prefix of its type; terraform is the built-in provider
        # of OpenTofu itself, which no test mocks.
        match($0, /^[[:space:]]*(resource|data)[[:space:]]+"[a-z0-9]+_/) {
          p = substr($0, RSTART, RLENGTH); sub(/^[^"]*"/, "", p); sub(/_$/, "", p)
          if (p != "terraform") print p
        }' {} + 2>/dev/null | sort -u | tr '\n' ' ')
  find "$INFRA_TREE" -maxdepth 2 \
      \( -name '*.tftest.hcl' -o -name '*.tofutest.hcl' \) -type f \
      2>/dev/null | while IFS= read -r tf; do
    awk -v req="$at_req" '
      /^[[:space:]]*run[[:space:]]+"/ { runs++ }
      /^[[:space:]]*command[[:space:]]*=[[:space:]]*plan/ { plans++ }
      # A provider block of the file, or a run block that maps
      # providers, selects configurations by name; which of them is
      # real cannot be told from here.
      /^[[:space:]]*provider[[:space:]]+"/ { sel = 1 }
      /^[[:space:]]*providers[[:space:]]*=/ { sel = 1 }
      match($0, /^[[:space:]]*mock_provider[[:space:]]+"[^"]+"/) {
        cur = substr($0, RSTART, RLENGTH); sub(/^[^"]*"/, "", cur); sub(/"$/, "", cur)
        inmock = 1; nm++; depth = 0
      }
      # An aliased mock is a second configuration beside the default
      # one: the name no longer says the default is mocked. The block
      # ends where its braces do, an alias after a nested block
      # included.
      inmock {
        if ($0 ~ /alias[[:space:]]*=/) aliased[cur] = 1
        t = $0
        depth += gsub(/\{/, "{", t) - gsub(/\}/, "}", t)
        if (depth <= 0) {
          if (!(cur in aliased)) mocked[cur] = 1
          inmock = 0
        }
      }
      END {
        if (runs <= plans) exit 1
        if (sel) exit 0
        if (index(" " req " ", " __provisioner__ ")) exit 0
        n = split(req, r, " ")
        if (nm == 0 || n == 0) exit 0
        for (i = 1; i <= n; i++) if (!(r[i] in mocked)) exit 0
        exit 1
      }' "$tf" && printf '%s\n' "$tf"
  done
}

case $VERB in
  check)
    [ $# -eq 0 ] || { usage >&2; exit 2; }
    cd "$INFRA_TREE" || exit 1
    step "tofu fmt -check" tofu fmt -check -diff -recursive
    if [ "$TOOL" = terragrunt ]; then
      step "terragrunt hcl fmt --check" terragrunt hcl fmt --check
      step "terragrunt validate" infra_run terragrunt validate
    else
      step "tofu init -backend=false" tofu init -backend=false -input=false
      step "tofu validate" tofu validate
    fi
    if pw_has tflint; then
      [ ! -f .tflint.hcl ] || step "tflint --init" tflint --init
      step "tflint" tflint --recursive
    else
      skipped tflint tflint
    fi
    if pw_has trivy; then
      step "trivy config" trivy config --exit-code 1 .
    else
      skipped "trivy config" trivy
    fi
    if pw_has checkov; then
      step "checkov" checkov -d . --framework terraform --quiet --compact
    else
      skipped checkov checkov
    fi
    infra_say "check passed" ;;
  init)
    refused_arg "$@"
    infra_run "$TOOL" init -input=false "$@" ;;
  plan)
    refused_arg "$@"
    { mkdir -p "$PLANDIR" && chmod 700 "$PLANDIR"; } || exit 1
    rm -f "$PLAN"
    # Always: a check leaves a .terraform without the backend, and
    # init with everything in place costs a second.
    infra_run "$TOOL" init -input=false || exit 1
    (umask 077; : > "$PLAN") || exit 1
    infra_run "$TOOL" plan -input=false -lock-timeout=60s \
      -detailed-exitcode -out="$PLAN" "$@"
    rc=$?
    case $rc in
      0) rm -f "$PLAN"; infra_say "plan: no changes"; exit 0 ;;
      2) plan_json "$SUMMARY"; echo "plan saved: $PLAN (review, then apply)" ;;
      *) rm -f "$PLAN"; infra_die "plan failed" ;;
    esac ;;
  review)
    [ $# -eq 0 ] || { usage >&2; exit 2; }
    [ -f "$PLAN" ] || infra_die "no saved plan for $STACK: run plan first"
    init_backend -backend=false
    infra_run "$TOOL" show "$PLAN" || exit 1
    echo
    plan_json "($SUMMARY), ($BY_ACTION)" ;;
  apply)
    destroys=''
    case $# in
      0) ;;
      1) [ "$1" = --destroys ] || { usage >&2; exit 2; }; destroys=1 ;;
      *) usage >&2; exit 2 ;;
    esac
    [ -f "$PLAN" ] || infra_die "no saved plan for $STACK: run plan, then" \
      "review, then apply"
    dep=$(infra_conf Deployment | tr '[:upper:]' '[:lower:]')
    case $dep in
      ''|local*|mixed*) ;;
      ci*)
        echo "hostwarden-tofu: the tree's Deployment is ci: the pipeline" \
          "applies (rules/infra-code.md - Deployment modes)." >&2
        exit 3 ;;
      *) infra_die "Deployment: $dep is none of local, ci, mixed" ;;
    esac
    # One tofu start: the delete count, then the summary line. A
    # plan that cannot be read is not applied: the count has to be
    # a number.
    pw_has jq ||
      infra_die "jq is needed to read the plan: bin/hostwarden-doctor says how"
    report=$(plan_json "($DELETES), ($SUMMARY)")
    deletes=${report%%
*}
    case $deletes in
      ''|*[!0-9]*) infra_die "the saved plan could not be read, so it is" \
        "not applied: run plan again" ;;
    esac
    if [ -z "$destroys" ] && [ "$deletes" -gt 0 ]; then
      echo "${report#*
}" >&2
      echo "hostwarden-tofu: the plan deletes or replaces a resource;" \
        "only the user applies such a plan, at a terminal:" >&2
      operator apply --destroys
      exit 3
    fi
    infra_run "$TOOL" apply -input=false -lock-timeout=60s "$PLAN"
    rc=$?
    rm -f "$PLAN"
    [ $rc -eq 0 ] || infra_die "apply failed"
    infra_say "applied" ;;
  drift)
    refused_arg "$@"
    init_backend
    infra_run "$TOOL" plan -input=false -lock-timeout=60s -refresh-only \
      -detailed-exitcode "$@"
    rc=$?
    case $rc in
      0) infra_say "no drift" ;;
      2) infra_say "drift: the real resources differ from the state;" \
        "a plan shows what a run would change"
        exit 4 ;;
      *) infra_die "drift check failed" ;;
    esac ;;
  test)
    applies=''
    [ "${1:-}" != --applies ] || { applies=1; shift; }
    refused_arg "$@"
    # Every run block plans, or the file mocks every provider the
    # tree requires: an apply test creates real infrastructure and
    # destroys it after.
    bad=''
    [ -n "$applies" ] || bad=$(applying_tests)
    [ -z "$bad" ] || {
      echo "hostwarden-tofu: a run block without command = plan applies" \
        "for real; the user runs these tests:" >&2
      printf '%s\n' "$bad" | sed 's/^/  /' >&2
      operator test --applies
      exit 3
    }
    init_backend -backend=false
    infra_run "$TOOL" test "$@" ;;
  fmt)
    refused_arg "$@"
    # The tree's own files, which the session edits anyway; a path
    # has to be inside it.
    for a; do
      case $a in
        -*) ;;
        *) infra_inside "$a" ||
          infra_die "$a is outside the tree $INFRA_TREE" ;;
      esac
    done
    cd "$INFRA_TREE" || exit 1
    tofu fmt "$@" ;;
  validate|providers|graph|version)
    [ "$VERB" != providers ] || [ "${1:-}" != mirror ] ||
      infra_refuse "tofu providers mirror writes a directory of your choosing"
    refused_arg "$@"
    [ "$VERB" = version ] || init_backend -backend=false
    cd "$INFRA_TREE" || exit 1
    "$TOOL" "$VERB" "$@" ;;
  show|output)
    refused_arg "$@"
    init_backend
    infra_run "$TOOL" "$VERB" "$@" ;;
  state)
    case ${1:-} in
      list|show) ;;
      *) infra_refuse "tofu state ${1:-} writes or prints the state" ;;
    esac
    refused_arg "$@"
    init_backend
    infra_run "$TOOL" state "$@" ;;
  workspace)
    case ${1:-} in
      list|show|select) ;;
      *) infra_refuse "tofu workspace ${1:-} creates or deletes a state" ;;
    esac
    refused_arg "$@"
    init_backend
    infra_run "$TOOL" workspace "$@" ;;
  destroy|import|taint|untaint|force-unlock|refresh|console|login|logout)
    infra_refuse "tofu $VERB changes the state or the real resources" \
      "without a plan to review" ;;
  *)
    usage >&2
    exit 2 ;;
esac
