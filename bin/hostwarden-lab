#!/bin/sh
# hostwarden-lab — disposable Linux systems to try a command on
# while working on Hostwarden, instead of guessing its syntax.
#
# Usage:
#   hostwarden-lab up <family>[:<tag>]
#                                Start a container of that family
#   hostwarden-lab exec <family> -- <command...>
#                                Run a command in it, as root;
#                                starts it first when it is not up
#   hostwarden-lab down [<family>]
#                                Remove this checkout's containers,
#                                or the one of that family
#   hostwarden-lab list          This checkout's containers and VMs
#   hostwarden-lab vm up <family> --ops <test clone> [--key <file.pub>]
#                                Create a full VM for what a
#                                container cannot answer, and name
#                                the test clone that reaches it
#   hostwarden-lab vm down [<family>]
#                                Delete this checkout's VMs, or the
#                                one of that family
#   hostwarden-lab --help        Show this help
#
# Families: debian, ubuntu, rhel (AlmaLinux), fedora, suse
# (openSUSE Leap), alpine. A container runs the official image
# of the current stable release; :<tag> picks another tag of it.
#
# Development checkouts only. A lab container is neither a server
# nor local mode: it has no access lists, no memory and no
# pipeline, and a development session uses it directly. It runs
# with docker or podman (HOSTWARDEN_LAB_ENGINE picks one), without
# a published port, a host path, the engine's socket or any extra
# privilege, and carries the label hostwarden.lab=<checkout>-<sum>,
# the checkout's name and a checksum of its path, which is all
# that down removes by.
#
# A container has no init, no firewall and a shared kernel: systemd
# services, the firewall, kernel parameters, a reboot and the SSH
# pipeline need a VM. vm up creates one with OrbStack or Lima,
# without the Mac's files mounted. The development session never
# uses it: an operations clone kept for test servers does, through
# rules/server-check-handoff.md. FreeBSD and macOS have no lab.
#
# Never starts a container engine or a VM manager; it says how.

set -e

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
# shellcheck source=../.claude/hooks/mode.sh
. "$REPO_DIR/.claude/hooks/mode.sh"

usage() {
  awk '/^# hostwarden-lab/{in_help=1} in_help{if(/^[^#]/)exit; sub(/^# ?/,""); print}' \
    "$SCRIPT_DIR/hostwarden-lab"
}
die() { echo "hostwarden-lab: $*" >&2; exit 1; }

# The current stable release of each family, looked up on
# 2026-09-22 (https://endoflife.date/api/<product>.json, the tags
# checked on https://hub.docker.com, OrbStack's names from orb
# create --help, Lima's from github.com/lima-vm/lima templates/).
# Ubuntu is the newest LTS, a server's release. OrbStack's Alpine
# lags; it picks its own default there. Refresh them the same way,
# never from memory.
#
# release <family> <field> — 1 the container image, 2 OrbStack's
# distro, 3 Lima's template.
release() {
  while read -r fam image orb lima; do
    [ "$fam" = "$1" ] || continue
    case "$2" in 1) echo "$image" ;; 2) echo "$orb" ;; 3) echo "$lima" ;; esac
    return 0
  done <<EOF
debian docker.io/library/debian:13     debian:13    template:debian-13
ubuntu docker.io/library/ubuntu:26.04  ubuntu:26.04 template:ubuntu-26.04
rhel   docker.io/library/almalinux:10  alma:10      template:almalinux-10
fedora docker.io/library/fedora:44     fedora:44    template:fedora-44
suse   docker.io/opensuse/leap:16.0    opensuse:16.0 template:opensuse-leap-16
alpine docker.io/library/alpine:3.24   alpine       template:alpine
EOF
  return 1
}
family() {
  release "$1" 1 >/dev/null \
    || die "unknown family '$1': debian, ubuntu, rhel, fedora, suse or alpine"
}

hostwarden_mode "$REPO_DIR"
case "${1:-}" in
  -h|--help|help) usage; exit 0 ;;
  up|exec|down|list|vm) ;;
  *) usage >&2; exit 2 ;;
esac
[ "$HOSTWARDEN_MODE" != operations ] || die "this checkout operates \
servers; the lab belongs to a development checkout."

# Whose containers these are: the checkout's directory name, a
# worktree's own, cut short enough for a host name, and a checksum
# of its full path. Two clones both called hostwarden, or two
# worktrees, never share one.
TOP=$(cd "$(git -C "$REPO_DIR" rev-parse --show-toplevel 2>/dev/null \
  || echo "$REPO_DIR")" && pwd -P)
LAB=$(basename "$TOP" | cut -c1-24 | tr '[:upper:]' '[:lower:]' \
  | tr -c 'a-z0-9\n' '-')
LAB="${LAB%-}-$(printf '%s' "$TOP" | cksum | cut -d' ' -f1)"
name() { echo "hwlab-$LAB-$1"; }

TMP=
scratch() {
  [ -n "$TMP" ] && return 0
  TMP=$(mktemp -d "${TMPDIR:-/tmp}/hostwarden-lab.XXXXXX")
  trap 'rm -rf "$TMP"' EXIT
  trap 'exit 130' INT TERM
}

# engine — sets ENGINE to a container engine that answers, or
# fails saying why; die_engine turns that into the exit.
engine() {
  [ -z "${ENGINE:-}" ] || return 0
  e=${HOSTWARDEN_LAB_ENGINE:-}
  if [ -z "$e" ]; then
    for c in docker podman; do
      command -v "$c" >/dev/null 2>&1 && { e=$c; break; }
    done
  fi
  if [ -z "$e" ]; then
    WHY="no container engine: install OrbStack or Docker (it brings \
docker), or podman."
    return 1
  fi
  # Only the engine on this machine: DOCKER_HOST, a Docker context
  # or a podman connection can name another one, a server, and
  # the mode guard sees only this script's command line. podman
  # machine is a local VM reached over ssh to this machine.
  case "$e" in
    # DOCKER_CONTEXT outranks DOCKER_HOST, which outranks the
    # context docker context use chose.
    docker)
      if [ -n "${DOCKER_CONTEXT:-}" ] || [ -z "${DOCKER_HOST:-}" ]; then
        ep=$("$e" context inspect ${DOCKER_CONTEXT:+"$DOCKER_CONTEXT"} \
          --format '{{.Endpoints.docker.Host}}' 2>/dev/null) \
          || ep="context ${DOCKER_CONTEXT:-} that cannot be read"
      else
        ep=$DOCKER_HOST
      fi ;;
    podman)
      ep=${CONTAINER_HOST:-$("$e" system connection list \
        --format '{{if .Default}}{{.URI}}{{end}}' 2>/dev/null)}
      [ -z "${CONTAINER_CONNECTION:-}" ] || ep="connection $CONTAINER_CONNECTION" ;;
    *) ep= ;;
  esac
  case "$ep" in
    "" | unix://* | npipe://* | tcp://localhost[:/]* | tcp://127.0.0.1[:/]* \
      | ssh://*@localhost[:/]* | ssh://*@127.0.0.1[:/]*) ;;
    *)
      WHY="$e is set to reach $ep, which is not this machine's engine. \
A lab runs on the local engine only: unset DOCKER_HOST or \
CONTAINER_HOST, or switch to a local context or connection."
      return 1 ;;
  esac
  if [ "$e" = docker ] && [ -n "${DOCKER_CONTEXT:-}" ] \
      && [ -n "${DOCKER_HOST:-}" ]; then
    WHY="DOCKER_CONTEXT and DOCKER_HOST are both set, which docker \
refuses; unset one of them."
    return 1
  fi
  if ! "$e" info >/dev/null 2>&1; then
    WHY="$e is installed but its engine is not running. Start it \
yourself — OrbStack: orb start; Docker Desktop: open it; podman: \
podman machine start."
    return 1
  fi
  ENGINE=$e
}
need_engine() { engine || die "$WHY"; }

# ids [-a] [<family>] — this checkout's containers: running ones,
# or with -a every one, of all families or of one.
ids() {
  a=
  [ "${1:-}" = -a ] && { a=a; shift; }
  "$ENGINE" ps "-q$a" --filter "label=hostwarden.lab=$LAB" \
    ${1:+--filter "label=hostwarden.lab.family=$1"}
}

up() {
  f=${1%%:*}
  family "$f"
  img=$(release "$f" 1)
  case "$1" in *:*) img="${img%:*}:${1#*:}" ;; esac
  need_engine
  now=$("$ENGINE" ps --filter "label=hostwarden.lab=$LAB" \
    --filter "label=hostwarden.lab.family=$f" --format '{{.Image}}')
  if [ -n "$now" ]; then
    case "$img" in
      *"$now") echo "$(name "$f") is up: $img." ;;
      *) die "$(name "$f") is up with $now; down $f first." ;;
    esac
    return 0
  fi
  # --init reaps and stops at once; tail -f /dev/null is the one
  # idle command every one of these images has.
  "$ENGINE" run --detach --rm --init \
    --name "$(name "$f")" --hostname "hwlab-$f" \
    --label "hostwarden.lab=$LAB" --label "hostwarden.lab.family=$f" \
    --security-opt no-new-privileges \
    "$img" tail -f /dev/null >/dev/null
  echo "$(name "$f") is up: $img."
}

down() {
  [ -z "${1:-}" ] || family "$1"
  need_engine
  found=$(ids -a "${1:-}")
  [ -n "$found" ] || { echo "No lab container of $LAB is up."; return 0; }
  # shellcheck disable=SC2086 # one ID per word
  set -- $found
  "$ENGINE" rm -f "$@" >/dev/null
  echo "Removed $# lab container(s) of $LAB."
}

# --- VMs ------------------------------------------------------
# A VM has no label to find it by, so vm up writes each one it
# creates to a file named after this checkout, and vm down deletes
# what that file names and nothing else. Each line: manager, name,
# family, host name, the test clone that uses it. The file lives in
# the common git directory, not the worktree's own, which git
# worktree remove deletes: a worktree recreated at the same path
# still finds the VMs it left behind.
state() {
  g=$(cd "$REPO_DIR" && c=$(git rev-parse --git-common-dir 2>/dev/null) \
    && cd "$c" && pwd -P) || g="$REPO_DIR/.git"
  STATE="$g/hostwarden-lab-vms-$LAB"
}

vm_up() {
  f=$1; shift
  family "$f"
  OPS=${HOSTWARDEN_LAB_OPS:-} KEY=
  while [ $# -gt 0 ]; do
    case "$1" in
      --ops) OPS=${2:?--ops needs the test clone}; shift 2 ;;
      --key) KEY=${2:?--key needs a .pub file}; shift 2 ;;
      *) die "vm up: unknown option $1" ;;
    esac
  done
  # The clone that will reach the VM: an operations install, not the
  # one this worktree came from, with production on its blacklist
  # (docs/operations.md → Operations and development).
  [ -n "$OPS" ] || die "vm up needs --ops <test clone>: an operations \
clone kept for test servers (docs/operations.md → Operations and development)."
  OPS=$(cd "$OPS" 2>/dev/null && pwd -P) || die "no such directory: $OPS"
  (hostwarden_mode "$OPS"; [ "$HOSTWARDEN_MODE" = operations ]) \
    || die "$OPS is no operations clone: run bin/hostwarden-init there first."
  MAIN=$(cd "${HOSTWARDEN_MAIN:-$REPO_DIR}" && pwd -P)
  [ "$OPS" != "$MAIN" ] || die "$OPS is the checkout this one came \
from. A lab VM goes to a separate clone kept for test servers."
  grep -qE '^[[:space:]]*(-[[:space:]]+)?[^#[:space:]]' \
    "$OPS/memory/blacklist.md" 2>/dev/null || die "$OPS/memory/blacklist.md \
lists no host. Put your production hosts there first, so the test \
clone can never reach them."

  state
  n=$(name "$f")
  if grep -q " $n " "$STATE" 2>/dev/null; then
    echo "$n exists; vm down $f removes it."
    return 0
  fi
  if command -v orb >/dev/null 2>&1; then
    orb status >/dev/null 2>&1 || die "OrbStack is not running. Start \
it yourself: orb start."
    # OrbStack's own SSH server reaches a machine only as
    # user@machine@orb, one host name for all of them. A real sshd
    # with the developer's key for root gives the VM a host name of
    # its own, as a server has.
    scratch
    if [ -z "$KEY" ]; then
      for k in id_ed25519 id_ecdsa id_rsa; do
        [ -f "$HOME/.ssh/$k.pub" ] && { KEY="$HOME/.ssh/$k.pub"; break; }
      done
    fi
    # Keys held by an agent alone, a password manager's: every
    # public key it offers.
    if [ -z "$KEY" ] && ssh-add -L > "$TMP/agent.pub" 2>/dev/null \
        && [ -s "$TMP/agent.pub" ]; then
      KEY="$TMP/agent.pub"
    fi
    case "$KEY" in
      *.pub) [ -f "$KEY" ] || die "no such key: $KEY" ;;
      "") die "no public key in ~/.ssh or the SSH agent; name one \
with --key <file.pub>." ;;
      *) die "--key takes the public half, a .pub file." ;;
    esac
    # Alpine has neither the package name nor systemd.
    if [ "$f" = alpine ]; then
      pkg=openssh start='rc-update add sshd default && rc-service sshd start'
    else
      pkg=openssh-server start='systemctl enable --now ssh || systemctl enable --now sshd'
    fi
    {
      echo '#cloud-config'
      echo "packages: [$pkg]"
      echo 'write_files:'
      echo '  - path: /root/.ssh/authorized_keys'
      echo "    permissions: '0600'"
      echo '    content: |'
      sed 's/^/      /' "$KEY"
      echo 'runcmd:'
      echo "  - $start"
    } > "$TMP/user-data"
    # --isolated: no /mnt/mac with the whole home in it, no mac
    # commands, no route to the Mac. SSH from the Mac still works.
    orb create --isolated --user-data "$TMP/user-data" \
      "$(release "$f" 2)" "$n"
    host="$n.orb.local"
    echo "orbstack $n $f $host $OPS" >> "$STATE"
    case "$KEY" in
      "$TMP"/*) reach="ssh root@$host, with a key from your SSH agent" ;;
      *) reach="ssh root@$host, with the key in $KEY" ;;
    esac
  elif command -v limactl >/dev/null 2>&1; then
    # --mount-none: Lima's templates mount the home directory.
    # --plain: no port forwarding, no containerd.
    # Recorded as soon as it exists, so vm down finds one that then
    # fails to start.
    limactl create --tty=false --name="$n" --mount-none --plain \
      "$(release "$f" 3)"
    host="lima-$n"
    echo "lima $n $f $host $OPS" >> "$STATE"
    limactl start --tty=false "$n"
    reach="ssh $host as your own user, with passwordless sudo; the host \
name comes from ~/.lima/$n/ssh.config, which ~/.ssh/config needs to \
include: Include ~/.lima/*/ssh.config"
  else
    die "no VM manager: install OrbStack or Lima."
  fi
  cat <<EOF
$n is up: $host
  Reached as: $reach.
  It is a test server of $OPS and nothing else's. A development
  session never uses it; it hands the question to a session there
  (rules/server-check-handoff.md), which runs the full pipeline.
  Delete it with: bin/hostwarden-lab vm down $f
EOF
}

vm_down() {
  [ -z "${1:-}" ] || family "$1"
  state
  [ -s "$STATE" ] || { echo "No lab VM of $LAB."; return 0; }
  scratch
  : > "$TMP/keep"
  while read -r how n f host ops; do
    if [ -n "${1:-}" ] && [ "$f" != "$1" ]; then
      echo "$how $n $f $host $ops" >> "$TMP/keep"
      continue
    fi
    case "$how" in
      # Not from the loop's stdin, the state file.
      orbstack) orb delete --force "$n" </dev/null ;;
      lima) limactl delete --force "$n" </dev/null ;;
    esac && echo "Deleted $n ($host)." \
      || echo "$how $n $f $host $ops" >> "$TMP/keep"
  done < "$STATE"
  cp "$TMP/keep" "$STATE"
}

case "$1" in
up) up "${2:?Usage: hostwarden-lab up <family>}" ;;
exec)
  f=${2:?Usage: hostwarden-lab exec <family> -- <command...>}
  family "$f"
  shift 2
  [ "${1:-}" = -- ] && shift
  [ $# -gt 0 ] || die "Usage: hostwarden-lab exec <family> -- <command...>"
  need_engine
  [ -n "$(ids "$f")" ] || up "$f" >&2
  exec "$ENGINE" exec -i "$(name "$f")" "$@"
  ;;
down) down "${2:-}" ;;
list)
  if engine; then
    "$ENGINE" ps --filter "label=hostwarden.lab=$LAB" \
      --format 'container  {{.Names}}  {{.Image}}  {{.Status}}'
  fi
  state
  if [ -s "$STATE" ]; then
    while read -r how n f host ops; do
      echo "vm         $n  $host  ($how), reached from $ops"
    done < "$STATE"
  fi
  ;;
vm)
  case "${2:-}" in
    up)
      shift 2
      f=${1:?Usage: hostwarden-lab vm up <family> --ops <test clone>}
      shift
      vm_up "$f" "$@"
      ;;
    down) vm_down "${3:-}" ;;
    *) usage >&2; exit 2 ;;
  esac
  ;;
esac
