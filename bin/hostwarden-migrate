#!/bin/sh
# hostwarden-migrate — bring local state up to date
# after a pull: rename skill overrides from
# heinzel-* to hostwarden-*, and create the SSH
# socket directory.
# Idempotent: re-running on an already-migrated
# tree is a silent no-op.
#
# Usage:
#   hostwarden-migrate         Migrate
#   hostwarden-migrate --help  Show this help
#
# Called automatically by
# .claude/hooks/check-updates.sh and by
# bin/hostwarden-update. Safe to run by hand.
set -e

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_DIR"

usage() {
  awk 'NR == 1 { next } /^[^#]/ { exit } { sub(/^# ?/, ""); print }' \
    "$SCRIPT_DIR/${0##*/}"
}

case ${1:-} in
  -h | --help) usage; exit 0 ;;
  '') ;;
  *) usage >&2; exit 2 ;;
esac

MOVED=""

# move_override <old-path> <new-name-under-custom-rules>
# An override already at the new path wins: only the user
# can merge two overrides, so the old file stays and
# says so.
move_override() {
  [ -e "$1" ] || return 0
  if [ -e "memory/custom-rules/$2" ]; then
    echo "hostwarden: kept $1 — memory/custom-rules/$2 exists, merge by hand"
    return 0
  fi
  mkdir -p "memory/custom-rules/$(dirname "$2")"
  mv "$1" "memory/custom-rules/$2"
  MOVED="$MOVED\n  $1 → memory/custom-rules/$2"
}

# An override's path mirrors the path of what it
# overrides (rules/overrides.md). Topics that moved
# between rules/ and a skill therefore answer to a new
# path, and an override left at the old one is
# silently never read again — which is the one failure
# this file exists to prevent. Same rule as above: an
# override already at the new path wins and the old one
# stays for the user to merge.
#
# One line per topic that moved. A topic that only
# changes directory keeps its file name.
MAP='server-memory machine-memory.md
mise hostwarden-runtimes.md
deployment hostwarden-deploy-user.md
scheduled-housekeeping hostwarden-housekeeping/scheduled.md
os-replacement hostwarden-os-install/os-replacement.md
partition-staging hostwarden-os-install/partition-staging.md
dual-boot hostwarden-os-install/dual-boot.md
efi-boot hostwarden-os-install/efi-boot.md
cloud-image hostwarden-os-install/cloud-image.md
debian os/debian.md
rhel os/rhel.md
suse os/suse.md
freebsd os/freebsd.md
macos os/macos.md'

# This machine's own current name, `localhost` and `127.0.0.1`'s
# stand-in below and in memory/.gitignore (rules/machine-memory.md).
hn=$(hostname -s 2>/dev/null || hostname)

# memory/servers/ became memory/machines/ (rules/machine-memory.md).
# The connection pipeline only ever looks for a host under
# machines/ (rules/first-connection.md), so a host left behind
# under the old name looks brand new: the next connection would
# skip its decisions, overrides and other memory rather than read
# them. One entry at a time, so a directory already at the new
# name — already migrated, or a genuinely new host that landed
# there first — wins and the old one waits for a merge by hand,
# the same rule move_override uses above. `localhost` and
# `127.0.0.1` were this machine's own old local-mode name; moved
# under its real one instead, so a later local connection finds
# its history rather than starting a second directory for the
# same machine. Left at the ambient glob setting: this script
# never disables it, and turning it off after would silently
# break the heinzel-*.md loop below.
if [ -d memory/servers ]; then
  mkdir -p memory/machines
  for e in memory/servers/* memory/servers/.[!.]*; do
    { [ -e "$e" ] || [ -L "$e" ]; } || continue
    o=${e##*/}
    case $o in
      localhost | 127.0.0.1) n=$hn ;;
      *) n=$o ;;
    esac
    if [ -e "memory/machines/$n" ] || [ -L "memory/machines/$n" ]; then
      echo "hostwarden: kept memory/servers/$o — memory/machines/$n exists, merge by hand"
      continue
    fi
    mv "$e" "memory/machines/$n"
    MOVED="$MOVED\n  memory/servers/$o → memory/machines/$n"
  done
  rmdir memory/servers 2>/dev/null || true
fi

# memory/.gitignore's own /servers/... lines -- the two the
# template shipped, and any hostname a user added by hand under
# the old name (rules/machine-memory.md → Personal versus shared)
# -- still name a path nothing writes under any more once the
# directories above have moved, so the local machine they meant
# to keep personal would reach a shared remote unprotected until
# its next local-mode connection adds the new pattern (which by
# then may be too late for a commit already made in between). The
# two literal names move to the real one, the same as the
# directory itself did above.
GI=memory/.gitignore
if [ -f "$GI" ] && grep -q '^/servers/' "$GI"; then
  sed -i.bak \
    -e 's#^/servers/#/machines/#' \
    -e "s#^/machines/localhost/\$#/machines/$hn/#" \
    -e "s#^/machines/127\\.0\\.0\\.1/\$#/machines/$hn/#" \
    "$GI"
  rm -f "$GI.bak"
  MOVED="$MOVED\n  memory/.gitignore: /servers/... patterns → /machines/..."
fi

if [ -d memory/custom-rules ]; then
  # memory/custom-rules/heinzel-<skill>.md →
  # hostwarden-<skill>.md: a skill override is found by the
  # skill's name, which changed with the rename from Heinzel.
  # One named after a rule that still has the prefix
  # (rules/heinzel-legacy.md, rules/heinzel-takeover.md)
  # overrides that rule and stays where it is.
  for f in memory/custom-rules/heinzel-*.md; do
    [ -e "$f" ] || continue
    name=$(basename "$f")
    [ -e "rules/$name" ] && continue
    move_override "$f" "hostwarden-${name#heinzel-}"
  done

  # Fed by redirection, not `echo "$MAP" | while`: a pipeline
  # runs the loop in a subshell, where every move it recorded
  # would be lost before the summary below reads it.
  while read -r old new; do
    [ -n "$old" ] || continue
    move_override "memory/custom-rules/$old.md" "$new"
  done <<EOF
$MAP
EOF
fi

# A shared workspace's own memory/.gitattributes was copied from
# the template before the servers -> machines rename and still
# names the old directory, so two machines' changelog additions
# stop merging as a union and start conflicting
# (rules/machine-memory.md). hostwarden-init never touches a
# workspace's existing .gitattributes (only writes one where none
# exists yet), so nothing else brings this one line forward.
GA=memory/.gitattributes
if [ -f "$GA" ] \
    && grep -qxF '/servers/*/changelog.log merge=union' "$GA" \
    && ! grep -qxF '/machines/*/changelog.log merge=union' "$GA"; then
  sed -i.bak \
    's#^/servers/\*/changelog\.log merge=union$#/machines/*/changelog.log merge=union#' \
    "$GA"
  rm -f "$GA.bak"
  MOVED="$MOVED\n  memory/.gitattributes: servers -> machines changelog merge rule"
fi

if [ -n "$MOVED" ]; then
  printf "hostwarden migration — moved user state:%b\n" "$MOVED"
  echo "Review any personal scripts or cron jobs that"
  echo "reference the old paths."
fi

# SSH connection sharing needs its socket directory
# before the first remote call
# (rules/ssh-connections.md). A SessionStart hook
# creates it as well, but the session that pulls an
# update started with the old settings, and this
# script runs from the new tree. Last, so a failure
# here cannot stop the moves above.
# -m reaching only the last directory is what this wants: the
# sockets need 0700, ~/.cache keeps whatever the umask gives it.
# shellcheck disable=SC2174
mkdir -p -m 700 "$HOME/.cache/hostwarden" || true
