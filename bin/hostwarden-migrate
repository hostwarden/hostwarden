#!/bin/sh
# hostwarden-migrate — bring local state up to date
# after a pull: rename skill overrides from
# heinzel-* to hostwarden-*, and create the SSH
# socket directory.
# Idempotent: re-running on an already-migrated
# tree is a silent no-op.
#
# Called automatically by
# .claude/hooks/check-updates.sh and by
# bin/hostwarden-update. Safe to run by hand.
set -e

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_DIR"

MOVED=""

# memory/custom-rules/heinzel-<skill>.md →
# hostwarden-<skill>.md: skill overrides are found by
# the skill's name, which changed with the rename from
# heinzel. An existing hostwarden-* file wins; the
# heinzel-* one then stays for the user to merge.
if [ -d memory/custom-rules ]; then
  for f in memory/custom-rules/heinzel-*.md; do
    [ -e "$f" ] || continue
    name=$(basename "$f")
    new="hostwarden-${name#heinzel-}"
    if [ -e "memory/custom-rules/$new" ]; then
      echo "hostwarden: kept $f — memory/custom-rules/$new exists, merge by hand"
      continue
    fi
    mv "$f" "memory/custom-rules/$new"
    MOVED="$MOVED\n  $f → memory/custom-rules/$new"
  done
fi

if [ -n "$MOVED" ]; then
  printf "hostwarden migration — moved user state:%b\n" "$MOVED"
  echo "Review any personal scripts or cron jobs that"
  echo "reference the old paths."
fi

# SSH connection sharing needs its socket directory
# before the first remote call
# (rules/ssh-connections.md). A SessionStart hook
# creates it as well, but the session that pulls an
# update started with the old settings, and this
# script runs from the new tree. Last, so a failure
# here cannot stop the moves above.
mkdir -p -m 700 "$HOME/.cache/hostwarden" || true
