#!/bin/sh
# hostwarden-migrate — bring local state up to date
# after a pull: rename skill overrides from
# heinzel-* to hostwarden-*, and create the SSH
# socket directory.
# Idempotent: re-running on an already-migrated
# tree is a silent no-op.
#
# Called automatically by
# .claude/hooks/check-updates.sh and by
# bin/hostwarden-update. Safe to run by hand.
set -e

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_DIR"

MOVED=""

# memory/custom-rules/heinzel-<skill>.md →
# hostwarden-<skill>.md: skill overrides are found by
# the skill's name, which changed with the rename from
# heinzel. An existing hostwarden-* file wins; the
# heinzel-* one then stays for the user to merge.
if [ -d memory/custom-rules ]; then
  for f in memory/custom-rules/heinzel-*.md; do
    [ -e "$f" ] || continue
    name=$(basename "$f")
    new="hostwarden-${name#heinzel-}"
    if [ -e "memory/custom-rules/$new" ]; then
      echo "hostwarden: kept $f — memory/custom-rules/$new exists, merge by hand"
      continue
    fi
    mv "$f" "memory/custom-rules/$new"
    MOVED="$MOVED\n  $f → memory/custom-rules/$new"
  done
fi

# The disk, boot and OS-installation rules left
# rules/ for the hostwarden-os-install skill, and a
# skill has one override slot named after it. Five
# files cannot be merged into one mechanically, so
# they stay where they are and the user is told. The
# notice repeats until they are merged or deleted —
# a silent no-op here would mean a silently ignored
# override on the most destructive workflow there is.
STALE=""
for name in os-replacement dual-boot efi-boot \
            cloud-image partition-staging; do
  [ -e "memory/custom-rules/$name.md" ] || continue
  STALE="$STALE\n  memory/custom-rules/$name.md"
done

if [ -n "$STALE" ]; then
  printf "hostwarden: rule overrides no longer read:%b\n" "$STALE"
  echo "Those rules are now the hostwarden-os-install"
  echo "skill. Merge what you still want into"
  echo "memory/custom-rules/hostwarden-os-install.md,"
  echo "then delete the old files."
fi

# The five OS-family files moved from rules/<name>.md
# into rules/os/<name>.md, and an override answers to
# the path of what it overrides — so a personal
# debian.md is read at os/debian.md now, and one left
# at the old path is silently never read again. Unlike
# the five above, each of these has exactly one
# destination, so move it rather than ask.
for name in debian rhel suse freebsd macos; do
  f="memory/custom-rules/$name.md"
  [ -e "$f" ] || continue
  if [ -e "memory/custom-rules/os/$name.md" ]; then
    echo "hostwarden: kept $f — memory/custom-rules/os/$name.md exists, merge by hand"
    continue
  fi
  mkdir -p memory/custom-rules/os
  mv "$f" "memory/custom-rules/os/$name.md"
  MOVED="$MOVED\n  $f → memory/custom-rules/os/$name.md"
done

if [ -n "$MOVED" ]; then
  printf "hostwarden migration — moved user state:%b\n" "$MOVED"
  echo "Review any personal scripts or cron jobs that"
  echo "reference the old paths."
fi

# SSH connection sharing needs its socket directory
# before the first remote call
# (rules/ssh-connections.md). A SessionStart hook
# creates it as well, but the session that pulls an
# update started with the old settings, and this
# script runs from the new tree. Last, so a failure
# here cannot stop the moves above.
mkdir -p -m 700 "$HOME/.cache/hostwarden" || true
