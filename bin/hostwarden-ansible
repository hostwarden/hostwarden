#!/bin/sh
# hostwarden-ansible — an Ansible tree of the user's own, checked
# and applied from this operations checkout, by the session or by
# the user from a terminal (rules/workspace-playbook.md).
#
# Usage:
#   hostwarden-ansible [--tree <name>] check [playbook…]
#                              --syntax-check (site.yml by default),
#                              then ansible-lint --offline
#   hostwarden-ansible [--tree <name>] diff <playbook> [args]
#                              --check --diff; --limit <hosts> as args
#   hostwarden-ansible [--tree <name>] apply <playbook> [args]
#                              the run; the taboo guard asks the user
#                              first, every time
#   hostwarden-ansible [--tree <name>] verify <playbook> [args]
#                              the run again; fails unless every host
#                              ends with changed=0 failed=0
#   hostwarden-ansible [--tree <name>] playbook <args>
#                              ansible-playbook as given, with the
#                              tree's inventory and this checkout's
#                              SSH options; asked like apply unless it
#                              is --check, --syntax-check or a --list
#   hostwarden-ansible [--tree <name>] lint
#   hostwarden-ansible [--tree <name>] inventory [args]
#                              ansible-inventory, --graph by default
#   hostwarden-ansible [--tree <name>] galaxy
#                              the tree's requirements.yml into its
#                              collections/, every entry pinned
#   hostwarden-ansible [--tree <name>] doc <name>
#   hostwarden-ansible [--tree <name>] ping <pattern>
#   hostwarden-ansible [--tree <name>] facts <pattern> <filter>
#   hostwarden-ansible --help
#
# The tree is memory/infra/ansible/, or with --tree memory/infra/<name>/
# or the tree memory/user.md records under `# Infrastructure code`
# (lib/infra.sh). The call sets ANSIBLE_CONFIG to the tree's
# ansible.cfg, ANSIBLE_SSH_ARGS to this checkout's memory/ssh_config,
# the askpass helper for a host that takes only a password, and -i
# to the tree's inventory unless the arguments name one. A playbook
# is named relative to the tree and has to be inside it. Credentials
# come from the tree's secrets.env, the user's
# ~/hostwarden-keys/infra/ansible/<name>/env and, where that directory
# has a vault-password file, --vault-password-file (lib/infra.sh →
# Credentials); none is printed.
#
# -e or --extra-vars naming a password, secret, token or key= is
# refused: argv is read by ps and the shell history. Anything a
# playbook needs comes from a vars file or the vault.
#
# Exit status: 0 done, 1 the tool failed or verify found a change,
# 2 a usage error, 3 refused.

set -u
case $0 in */*) ROOT=${0%/*}/.. ;; *) ROOT=.. ;; esac
ROOT=$(cd "$ROOT" && pwd -P) || exit 1
# shellcheck source=../lib/mode.sh
. "$ROOT/lib/mode.sh"
# shellcheck disable=SC2034 # read by lib/passwords.sh and lib/infra.sh
PW_ROOT=$ROOT INFRA_ROOT=$ROOT INFRA_PROG=hostwarden-ansible
# shellcheck source=../lib/passwords.sh
. "$ROOT/lib/passwords.sh"
# shellcheck source=../lib/infra.sh
. "$ROOT/lib/infra.sh"

usage() {
  awk 'NR == 1 { next } /^[^#]/ { exit } { sub(/^# ?/, ""); print }' "$0"
}

TREE=''
case ${1:-} in
  -h|--help) usage; exit 0 ;;
  --tree) [ $# -ge 2 ] || { usage >&2; exit 2; }; TREE=$2; shift 2 ;;
  --tree=*) TREE=${1#--tree=}; shift ;;
esac
[ $# -ge 1 ] || { usage >&2; exit 2; }
VERB=$1
shift

infra_operations
infra_path
infra_tree ansible "$TREE"

for t in ansible-playbook ansible; do
  pw_has "$t" || infra_die "$t is not installed: bin/hostwarden-doctor says how"
done
[ -f "$ROOT/memory/ssh_config" ] || sh "$ROOT/bin/hostwarden-ssh-config" ||
  infra_die "memory/ssh_config is missing: run bin/hostwarden-ssh-config"

[ ! -f "$INFRA_TREE/ansible.cfg" ] || {
  ANSIBLE_CONFIG=$INFRA_TREE/ansible.cfg
  export ANSIBLE_CONFIG
}
# Ansible splits the string like a shell, so the quotes keep a path
# with a space in one word.
# shellcheck disable=SC2089,SC2090
ANSIBLE_SSH_ARGS="-F '$ROOT/memory/ssh_config'"
SSH_ASKPASS=$ROOT/bin/hostwarden-askpass SSH_ASKPASS_REQUIRE=force
# shellcheck disable=SC2090
export ANSIBLE_SSH_ARGS SSH_ASKPASS SSH_ASKPASS_REQUIRE
[ -t 1 ] || { ANSIBLE_NOCOLOR=1; export ANSIBLE_NOCOLOR; }
cd "$INFRA_TREE" || exit 1

# inventory — INV, the tree's inventory: ansible.cfg's, else the
# usual names in the tree; dies where there is none.
inventory() {
  INV=''
  [ ! -f ansible.cfg ] ||
    INV=$(awk -F= '/^[[:space:]]*inventory[[:space:]]*=/ { v = $2; sub(/^[[:space:]]+/, "", v); sub(/[[:space:]]+$/, "", v); print v; exit }' \
      ansible.cfg)
  [ -z "$INV" ] || return 0
  for c in inventory hosts.yml hosts.yaml hosts.ini hosts inventory.yml \
      inventory.yaml inventory.ini; do
    [ -e "$c" ] && { INV=$INFRA_TREE/$c; return 0; }
  done
  infra_die "the tree names no inventory: ansible.cfg inventory=, or" \
    "inventory/, hosts.yml, hosts.ini in $INFRA_TREE"
}

# has_inventory <args…> — true when the arguments name one.
has_inventory() {
  for a; do
    case $a in -i|-i?*|--inventory|--inventory=*|--inventory-file|--inventory-file=*) return 0 ;; esac
  done
  return 1
}

# playbook_path <name> — PB, the playbook, inside the tree.
playbook_path() {
  infra_inside "$1" || infra_die "$1 is outside the tree $INFRA_TREE"
  case $1 in /*) PB=$1 ;; *) PB=$INFRA_TREE/$1 ;; esac
  [ -f "$PB" ] || infra_die "no such playbook: $PB"
}

VAULT=$HOME/hostwarden-keys/infra/ansible/$INFRA_TREE_NAME/vault-password

# confined_inv <value> — an inventory is a path inside the tree; a
# comma list of hosts is not one, and reaches hosts outside it.
confined_inv() {
  case $1 in
    *,*) infra_die "a host list as inventory ($1) reaches hosts outside" \
      "the tree $INFRA_TREE" ;;
  esac
  infra_inside "$1" || infra_die "inventory $1 is outside the tree $INFRA_TREE"
}

# confined <args…> — every word that names a file — a playbook, an
# inventory, a vars file after @, attached to its option or not —
# stays inside the tree; an option, a pattern and a key=value pass
# as they are.
confined() {
  inv_next=''
  for a; do
    if [ -n "$inv_next" ]; then
      inv_next=''
      confined_inv "$a"
      continue
    fi
    case $a in
      -i|--inventory|--inventory-file) inv_next=1; continue ;;
      -i?*) confined_inv "${a#-i}"; continue ;;
      --inventory=*|--inventory-file=*) confined_inv "${a#*=}"; continue ;;
    esac
    v=$a
    case $a in
      --extra-vars=*) v=${a#*=} ;;
      -e?*) v=${a#-e} ;;
      -*) continue ;;
    esac
    case $v in
      *=*) ;;
      */*|*.yml|*.yaml|*.ini|*.json)
        infra_inside "${v#@}" || infra_die "$a is outside the tree $INFRA_TREE" ;;
    esac
  done
}

# run_playbook <args…> — ansible-playbook with the tree's inventory
# where the arguments name none, the vault where there is one, every
# file named inside the tree.
run_playbook() {
  infra_refuse_secret_args -e --extra-vars "$@"
  confined "$@"
  if [ -f "$VAULT" ]; then
    infra_mode600 "$VAULT"
    set -- --vault-password-file "$VAULT" "$@"
  fi
  has_inventory "$@" || { inventory; set -- -i "$INV" "$@"; }
  infra_run ansible-playbook "$@"
}

case $VERB in
  check)
    [ $# -gt 0 ] || set -- site.yml
    # Each playbook is taken off the front and its checked path put at
    # the back, so that a path with a space stays one word.
    n=$#
    while [ "$n" -gt 0 ]; do
      playbook_path "$1"
      shift
      set -- "$@" "$PB"
      n=$((n - 1))
    done
    echo "== ansible-playbook --syntax-check"
    run_playbook --syntax-check "$@" || infra_die "syntax check failed"
    if pw_has ansible-lint; then
      echo "== ansible-lint --offline"
      ansible-lint --offline || infra_die "ansible-lint found what the" \
        "tree has to fix before a run"
    else
      echo "== ansible-lint: skipped, not installed (bin/hostwarden-doctor)"
    fi
    infra_say "check passed" ;;
  diff|apply|verify)
    [ $# -ge 1 ] || { usage >&2; exit 2; }
    playbook_path "$1"
    shift
    case $VERB in
      diff) run_playbook --check --diff "$PB" "$@" ;;
      apply) run_playbook "$PB" "$@" ;;
      verify)
        OUT=$(mktemp "${TMPDIR:-/tmp}/hostwarden-ansible.XXXXXX") || exit 1
        trap 'rm -f "$OUT"' EXIT INT TERM
        # Not through a pipe: its status would be tee's.
        run_playbook "$PB" "$@" > "$OUT" 2>&1
        rc=$?
        cat "$OUT"
        [ $rc -eq 0 ] || infra_die "the second run failed"
        grep -q '^PLAY RECAP' "$OUT" ||
          infra_die "the second run printed no recap, so nothing is verified"
        # An empty inventory or a --limit that matches nothing ends with
        # an empty recap and a good status: nothing was checked.
        seen=$(awk '/^PLAY RECAP/ { on = 1; next } on && /: ok=/ { n++ } END { print n + 0 }' "$OUT")
        [ "$seen" -gt 0 ] || infra_die "the second run reached no host: the" \
          "recap names none, so nothing is verified (an empty inventory," \
          "or a --limit that matches nothing)"
        # The recap, one line per host: changed=0 and nothing failed
        # or unreachable, or the play is not idempotent.
        changed=$(awk '/^PLAY RECAP/ { on = 1; next } on && /: ok=/ {
            for (i = 1; i <= NF; i++) {
              split($i, kv, "=")
              if ((kv[1] == "changed" || kv[1] == "failed" || kv[1] == "unreachable") && kv[2] + 0 > 0) { print $1; break }
            }
          }' "$OUT")
        [ -z "$changed" ] || infra_die "the second run still changed," \
          "failed or could not reach: $(printf '%s' "$changed" | tr '\n' ' ')" \
          "- the play is not idempotent (rules/workspace-playbook.md)"
        infra_say "verified: changed=0 on every host" ;;
    esac ;;
  playbook)
    [ $# -ge 1 ] || { usage >&2; exit 2; }
    run_playbook "$@" ;;
  lint)
    pw_has ansible-lint ||
      infra_die "ansible-lint is not installed: bin/hostwarden-doctor says how"
    ansible-lint --offline "$@" ;;
  inventory)
    [ $# -gt 0 ] || set -- --graph
    has_inventory "$@" || { inventory; set -- -i "$INV" "$@"; }
    ansible-inventory "$@" ;;
  galaxy)
    [ $# -eq 0 ] || { usage >&2; exit 2; }
    req=$INFRA_TREE/requirements.yml
    [ -f "$req" ] || infra_die "no requirements.yml in $INFRA_TREE"
    # Every entry carries an exact version, or for a git source a
    # commit: a range, a star or a branch installs whatever is
    # newest that day (rules/workspace-playbook.md). source: names
    # a Galaxy server, not the entry, and a list nested under an
    # entry (signatures:) is no entry.
    GALAXY_AWK=$(cat <<'EOF'
function unq(v) {
  sub(/[ \t]+$/, "", v); sub(/^[ \t]+/, "", v)
  if (v ~ /^".*"$/ || v ~ /^'.*'$/) v = substr(v, 2, length(v) - 2)
  return v
}
function inl(body, k,   m) {
  if (!match(body, "(^|[ ,{])" k ":[ ]*[^,}]+")) return ""
  m = substr(body, RSTART, RLENGTH)
  sub(/^[ ,{]*[A-Za-z_]+:[ ]*/, "", m)
  return unq(m)
}
function setf(k, v) {
  v = unq(v)
  if (k == "name") nm = v
  else if (k == "src") sr = v
  else if (k == "version") ver = v
  else if (k == "type") ty = v
}
function flush(   git, ok) {
  if (!have) return
  if (nm == "") nm = sr
  git = (ty == "git" || nm ~ /:\/\// || nm ~ /^[^\/ ]+@[^\/ ]+:/ || nm ~ /\.git$/)
  if (git) ok = (ver ~ /^[0-9a-f]+$/ && length(ver) >= 7 && length(ver) <= 40)
  else ok = (ver ~ /^(==)?[0-9]+\.[0-9]+\.[0-9]+([-+][A-Za-z0-9.]+)?$/)
  if (!ok) print nm ": " (ver == "" ? "no version" : ver)
  have = 0; nm = ""; sr = ""; ver = ""; ty = ""
}
BEGIN { sec = "collections" }
{
  line = $0
  sub(/(^|[ \t])#.*$/, "", line)
  if (line ~ /^[ \t]*$/) next
}
line ~ /^[A-Za-z_]+:/ {
  flush(); sec = line; rest = line
  sub(/:.*$/, "", sec); sub(/^[^:]*:/, "", rest); item_ind = ""
  if (sec == "collections" && rest ~ /[^ \t\[\]]/)
    print "collections: a flow sequence is not read, write a block list"
  next
}
sec != "collections" { next }
line ~ /^[ \t]*-([ \t]|$)/ {
  match(line, /[^ \t]/); ind = RSTART - 1
  if (item_ind == "") item_ind = ind
  if (ind > item_ind) next
  flush()
  body = line; sub(/^[ \t]*-[ \t]*/, "", body)
  have = 1
  if (body ~ /^\{/) {
    nm = inl(body, "name")
    if (nm == "") nm = inl(body, "src")
    ver = inl(body, "version"); ty = inl(body, "type")
    flush(); next
  }
  if (match(body, /^(name|src|source|version|type):/)) {
    k = substr(body, 1, RLENGTH - 1); v = substr(body, RLENGTH + 1)
    setf(k, v); next
  }
  nm = unq(body); flush(); next
}
have && match(line, /^[ \t]+(name|src|source|version|type):/) {
  k = substr(line, RSTART, RLENGTH); sub(/^[ \t]+/, "", k); sub(/:$/, "", k)
  v = substr(line, RLENGTH + 1); setf(k, v)
}
END { flush() }
EOF
)
    loose=$(awk "$GALAXY_AWK" "$req")
    [ -z "$loose" ] || {
      echo "hostwarden-ansible: every entry of requirements.yml pins one" \
        "exact version; these do not:" >&2
      printf '%s\n' "$loose" | sed 's/^/  /' >&2
      exit 3
    }
    ansible-galaxy collection install -r "$req" -p "$INFRA_TREE/collections" ;;
  doc)
    [ $# -ge 1 ] || { usage >&2; exit 2; }
    ansible-doc "$@" ;;
  ping)
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    inventory
    infra_run ansible -i "$INV" "$1" -m ping ;;
  facts)
    [ $# -eq 2 ] || { usage >&2; exit 2; }
    inventory
    # Filtered, always: unfiltered setup prints ansible_env, the login
    # user's whole environment (rules/secrets.md).
    infra_run ansible -i "$INV" "$1" -m setup -a "filter=$2" ;;
  *)
    usage >&2
    exit 2 ;;
esac
