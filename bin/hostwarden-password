#!/bin/sh
# hostwarden-password — the SSH passwords of hosts that take no key,
# for this operations checkout on this machine
# (rules/ssh-passwords.md).
#
# Usage:
#   hostwarden-password set <user>@<host>
#                   Store the password in this machine's own store,
#                   asking for it twice without echo. The user runs
#                   it in a terminal of their own
#   hostwarden-password link <user>@<host> <source>
#                   Take the password from a password manager:
#                     1password op://<vault>/<item>/[<section>/]<field>
#                     rbw <profile>/<item name>
#                     bws <secret id>
#                   The entry must name the target (below)
#   hostwarden-password token 1password|bws
#                   Store a 1Password service account token or a
#                   Bitwarden Secrets Manager access token in this
#                   machine's own store, asking for it once without
#                   echo. The user runs it in a terminal of their own
#   hostwarden-password check <user>@<host>
#                   Say where the password comes from and whether it
#                   is there, without reading it
#
# set, link and check first ask the host which login methods it
# offers, with a login by the method none that authenticates nothing,
# and refuse a host that offers publickey: it takes a key or a
# certificate, and a password is never the way in there. The answer
# is kept for bin/hostwarden-askpass, which gives no password without
# one from the last 30 days, and asked again after a week.
#   hostwarden-password remove <user>@<host>
#                   Forget it: the entry in this machine's store, if
#                   any, and the line in memory/user.md. A password
#                   manager's entry stays
#   hostwarden-password --help
#
# <host> is the name Hostwarden connects by. The password belongs to
# the target ssh resolves it to, <user>@<hostname>:<port> from
# `ssh -G` with this checkout's memory/ssh_config, and every command
# prints it. A password manager's entry must hold exactly that
# target: in a field named `hostwarden` for 1Password and rbw, as
# the secret's name for Secrets Manager. `link` reads that field and
# nothing else.
#
# Each login gets its line in memory/user.md, `# SSH Passwords`,
# which is personal: on another machine, the password is set or
# linked again.
#
# No command prints a password or a token. Exit status: 0 on
# success, 1 on failure, 2 on a usage error.

set -u
case $0 in */*) ROOT=${0%/*}/.. ;; *) ROOT=.. ;; esac
ROOT=$(cd "$ROOT" && pwd -P) || exit 1
# shellcheck source=../lib/mode.sh
. "$ROOT/lib/mode.sh"
# shellcheck disable=SC2034 # read by lib/passwords.sh
PW_ROOT=$ROOT
# shellcheck source=../lib/passwords.sh
. "$ROOT/lib/passwords.sh"

say() { echo "hostwarden-password: $*"; }
die() { echo "hostwarden-password: $*" >&2; exit 1; }
usage() {
  awk 'NR == 1 { next } /^[^#]/ { exit } { sub(/^# ?/, ""); print }' "$0"
}

case ${1:-} in
  -h|--help) usage; exit 0 ;;
  set|link|token|check|remove) CMD=$1; shift ;;
  *) usage >&2; exit 2 ;;
esac

hostwarden_mode "$ROOT"
[ "$HOSTWARDEN_MODE" = operations ] ||
  die "only an operations checkout reaches servers; this is $HOSTWARDEN_MODE"
hostwarden_cache_dir "$ROOT"

needs_terminal() {
  [ -t 0 ] || die "asks for a secret and needs a terminal: the user runs" \
    "bin/hostwarden-password $CMD … in a terminal of their own"
}

# read_hidden <prompt> — one line from the terminal, not echoed, on
# stdout.
read_hidden() {
  printf '%s' "$1" > /dev/tty
  stty -echo 2>/dev/null
  IFS= read -r rh_v
  rh_rc=$?
  stty echo 2>/dev/null
  printf '\n' > /dev/tty
  [ $rh_rc -eq 0 ] && printf '%s' "$rh_v"
}

# store_secret <kind> <key> <prompt> [twice] — into this machine's
# store, B. The keychain asks twice itself and compares; for the
# others it is read here, and a second time with `twice`.
store_secret() {
  if [ "$B" = keychain ]; then
    pw_local_put keychain "$1" "$2" || die "the keychain kept nothing"
    return
  fi
  S1=$(read_hidden "$3") || die "nothing read"
  [ -n "$S1" ] || die "an empty secret is none"
  if [ -n "${4:-}" ]; then
    S2=$(read_hidden "The same again: ") || die "nothing read"
    [ "$S1" = "$S2" ] || die "the two differ; nothing was stored"
  fi
  printf '%s' "$S1" | pw_local_put "$B" "$1" "$2" ||
    die "the $B store kept nothing"
  S1='' S2=''
}

# resolve <user>@<host> — sets LOGIN, R_USER, R_NAME and TARGET.
resolve() {
  case ${1:-} in
    *@*) ;;
    *) die "name the login as <user>@<host>" ;;
  esac
  R_USER=${1%@*} R_NAME=${1##*@}
  [ -n "$R_USER" ] && [ -n "$R_NAME" ] || die "name the login as <user>@<host>"
  case $R_NAME in *[!A-Za-z0-9._:-]*|-*) die "not a host name: $R_NAME" ;; esac
  LOGIN=$R_USER@$R_NAME
  [ -f "$ROOT/memory/ssh_config" ] || sh "$ROOT/bin/hostwarden-ssh-config" ||
    die "memory/ssh_config is missing: run bin/hostwarden-ssh-config"
  G=$(ssh -F "$ROOT/memory/ssh_config" -G -l "$R_USER" "$R_NAME" 2>/dev/null) ||
    die "ssh -G could not resolve $LOGIN"
  g() { printf '%s\n' "$G" | awk -v k="$1" '$1 == k { print $2; exit }'; }
  TARGET=$(pw_target "$(g user)" "$(g hostname)" "$(g port)")
}

# keyless — dies unless TARGET takes no key: a host that offers
# publickey takes a key or a certificate, and gets no password. The
# host is asked again when its answer is older than a week, so a
# firmware that learned keys ends the password logins.
keyless() {
  pw_keyless "$TARGET" 7 ||
    pw_probe "$R_USER" "$R_NAME" "$TARGET" >/dev/null ||
    die "$LOGIN ($TARGET) named no login methods: unreachable, or its" \
      "host key is not in memory/known_hosts yet; nothing done"
  pw_keyless "$TARGET" && return
  grep -qs publickey "$(pw_methods_file "$TARGET")" &&
    die "$LOGIN ($TARGET) offers key logins (publickey): it takes a key" \
      "or a certificate, never a password. Set one up instead" \
      "(rules/accounts.md); nothing done"
  die "$LOGIN ($TARGET) offers no password login either; nothing done"
}

# source_of — the source recorded for LOGIN, or nothing.
source_of() { pw_source "$R_USER" "$R_NAME" 2>/dev/null || true; }

case $CMD in
  set)
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    resolve "$1"
    keyless
    needs_terminal
    B=$(pw_backend)
    say "the password for $TARGET goes into this machine's $B store"
    store_secret ssh "$TARGET" "Password for $TARGET: " twice
    pw_local_has "$B" ssh "$TARGET" || die "the $B store kept nothing"
    pw_record "$LOGIN" "local $B" || die "memory/user.md was not written"
    say "stored; memory/user.md: - $LOGIN: local $B" ;;
  link)
    [ $# -eq 2 ] || { usage >&2; exit 2; }
    resolve "$1"
    pw_valid_source "$2" || die "not a source: $2 (see --help)"
    case $2 in local*) die "a local password is stored with set" ;; esac
    keyless
    pw_manager_scoped "$2" ||
      die "a password manager is linked only through an identity that" \
        "sees Hostwarden's entries alone (rules/ssh-passwords.md)"
    if ! pw_manager_bound "$2" "$TARGET"; then
      die "the entry must hold $TARGET in its own field: named" \
        "$PW_BIND_FIELD for 1password and rbw, the secret's name for bws;" \
        "the manager must be unlocked, or its token stored (token)"
    fi
    pw_record "$LOGIN" "$2" || die "memory/user.md was not written"
    say "linked; memory/user.md: - $LOGIN: $2" ;;
  token)
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    case $1 in 1password|bws) ;; *) usage >&2; exit 2 ;; esac
    needs_terminal
    B=$(pw_backend)
    store_secret token "$1" "Token for $1: "
    say "the $1 token is in this machine's $B store" ;;
  check)
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    resolve "$1"
    keyless
    S=$(source_of)
    case $S in
      "")
        B=$(pw_backend)
        if pw_local_has "$B" ssh "$TARGET"; then
          say "$LOGIN ($TARGET): in the $B store, but memory/user.md has" \
            "no line for it"
        else
          say "$LOGIN ($TARGET): no password"
          exit 1
        fi ;;
      local*)
        B=$(pw_local_backend "$S")
        if pw_local_has "$B" ssh "$TARGET"; then
          say "$LOGIN ($TARGET): in the $B store"
        else
          say "$LOGIN ($TARGET): recorded as local $B, but the store has" \
            "none; the user runs bin/hostwarden-password set $LOGIN"
          exit 1
        fi ;;
      *)
        if pw_manager_scoped "$S" && pw_manager_bound "$S" "$TARGET"; then
          say "$LOGIN ($TARGET): ${S%% *}, reachable, entry names the target"
        else
          say "$LOGIN ($TARGET): ${S%% *} did not confirm the entry"
          exit 1
        fi ;;
    esac ;;
  remove)
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    resolve "$1"
    S=$(source_of)
    # Every local store, whatever the line names: a password stored
    # here before a link, or under another store, would otherwise
    # answer again once the line is gone.
    # A store that cannot be asked is not an empty one: nothing is
    # forgotten, the line stays, and the user is told which.
    for B in keychain file; do
      pw_local_probe "$B" ssh "$TARGET"
      case $? in
        0) pw_local_del "$B" ssh "$TARGET" || die "the $B store kept it" ;;
        2) die "the $B store could not be checked (locked or" \
             "unreachable), so the password may still be in it;" \
             "nothing was forgotten. Unlock it and run this again" ;;
      esac
    done
    pw_unrecord "$LOGIN" || die "memory/user.md was not written"
    say "forgotten: $LOGIN ($TARGET)" ;;
esac
