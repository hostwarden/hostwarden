#!/bin/sh
# hostwarden-doctor — what this workstation has of the tools
# Hostwarden runs locally, and what to install for the rest.
#
# Usage:
#   hostwarden-doctor           Full report
#   hostwarden-doctor --quiet   Only what is missing; nothing at
#                               all when nothing is (the
#                               SessionStart hook). Outside an
#                               operations checkout, what --dev
#                               checks
#   hostwarden-doctor --dev     What working on Hostwarden itself
#                               needs instead of what running it
#                               does (scripts/check.sh uses it)
#   hostwarden-doctor --help    Show this help
#
# Checks the machine the AI tool runs on, never a managed host.
# Prints install commands; never runs them. Outside --dev it also
# checks the SSH keys (lib/hostwarden-doctor/keys.sh). In an
# operations checkout whose shell runs in a VM apart from the
# workstation (Claude Cowork, Claude Code on the web) it prints one
# line naming the way out instead, and goes on only with --dev.
# Exit status: 1 when something required is missing, or without
# --dev in such a VM, else 0.
# --quiet prints only what is missing and, without --dev, always
# exits 0.

QUIET='' DEV=''
for a in "$@"; do
  case $a in
    --quiet) QUIET=1 ;;
    --dev) DEV=1 ;;
    # Help needs nothing the doctor might be about to report as
    # missing, sed included.
    -h|--help)
      while IFS= read -r l; do
        case $l in '#!'*) continue ;; '#'*) ;; *) break ;; esac
        l=${l#\#}
        echo "${l# }"
      done < "$0"
      exit 0 ;;
    *) echo "hostwarden-doctor: unknown option $a" >&2; exit 2 ;;
  esac
done

# --quiet without --dev is the SessionStart hook, which reports
# and exits 0: Claude Code passes a hook's output on only then.
# --dev keeps the verdict for scripts/check.sh, which a missing
# feature must not stop.
HOOK=''
[ -z "$QUIET" ] || [ -n "$DEV" ] || HOOK=1

has() { command -v "$1" >/dev/null 2>&1; }

# The shell alone from here to the probes: anything else could be
# one of the tools this is about to report missing.
case $0 in */*) ROOT=${0%/*}/.. ;; *) ROOT=.. ;; esac
ROOT=$(cd "$ROOT" && pwd)
# shellcheck source=../lib/mode.sh
. "$ROOT/lib/mode.sh"
# shellcheck source=../lib/follow.sh
. "$ROOT/lib/follow.sh"
# website/docs/getting-started/install.md, published — every row
# below that points a user there names it once.
INSTALL_DOCS=https://hostwarden.github.io/docs/getting-started/install
# CONTRIBUTING.md → Setup, published: one mise install per
# distribution.
CONTRIB_DOCS=https://github.com/hostwarden/hostwarden/blob/main/CONTRIBUTING.md#setup
# The SessionStart hook runs in every checkout. One that is not for
# operations reaches no server, so what it needs is what working on
# Hostwarden needs. Only the hook: a full report run by hand in a
# fresh clone, before bin/hostwarden-init, is for someone installing
# Hostwarden to run it.
hostwarden_mode "$ROOT"
# An operations checkout in a VM apart from the workstation (remote
# in lib/mode.sh) has no key to reach a server with, so there is
# nothing of operations to probe for: the one line names the way
# out, and it is the line a session without hooks reads, since
# Cowork fires none. It ends there, the hook with 0 and a run by
# hand with 1: the checkout stays read-only and runs no checks, so
# the tools --dev lists are not missing from it. Only --dev, asked
# for, goes on.
if [ "$HOSTWARDEN_MODE" = remote ] && [ -z "$DEV" ]; then
  hostwarden_why
  hostwarden_next_step
  echo "hostwarden: $HOSTWARDEN_WHY: no server is reached from here," \
    "and memory/ is left as it is. Next step: $HOSTWARDEN_NEXT_STEP" \
    "(AGENTS.md - Development or Operations)."
  [ -n "$HOOK" ] && exit 0
  exit 1
fi
[ -z "$HOOK" ] || [ "$HOSTWARDEN_MODE" = operations ] || DEV=1
# mise_tools <file> — the tools a mise file pins, as the commands a
# session runs, one line: an aqua tool by its repository's name, a
# pypi package by its name, ansible-core by the two commands the
# rules call, OpenTofu by its command tofu, python as python3, a
# plain key by itself. Matched
# with or without the spacing the files' own style uses, no
# external tool (this runs under the ssh shim's bare PATH too). A
# quoted key of another backend or an inline table matches
# nothing; neither file has one.
mise_tools() {
  [ -f "$1" ] || return 0
  while IFS= read -r l; do
    case $l in
      '"pypi:ansible-core"'*) printf 'ansible-playbook ansible-galaxy ' ;;
      '"aqua:opentofu/opentofu"'*) printf 'tofu ' ;;
      '"pypi:'*) t=${l#*:}; printf '%s ' "${t%%\"*}" ;;
      '"aqua:'*/*) t=${l#*/}; printf '%s ' "${t%%\"*}" ;;
      python*) printf 'python3 ' ;;
      [a-z]*' = "'*) printf '%s ' "${l%% *}" ;;
      [a-z]*'="'*) printf '%s ' "${l%%=*}" ;;
    esac
  done < "$1"
}
# What mise brings, and so what hint names mise install for:
# mise.toml's tools in every checkout, and with --dev
# mise.dev.toml's on top, as MISE_ENV=dev layers the files.
MISE_TOOLS=$(mise_tools "$ROOT/mise.toml")
MISE_DEV_TOOLS=''
if [ -n "$DEV" ]; then
  MISE_DEV_TOOLS=$(mise_tools "$ROOT/mise.dev.toml")
  MISE_TOOLS="$MISE_TOOLS $MISE_DEV_TOOLS"
fi
# Wherever mise put them, first on PATH: scripts/check.sh and the
# session-start hook bring them in before they ask, and a doctor
# run on its own has to see the same PATH, or it reports installed
# tools as missing. The helper installs nothing.
hostwarden_mise_bins "$ROOT" ${DEV:+dev}
# The PATH as the hooks have it, without mise's directories in front
# (jq_runs).
DOCTOR_PATH=$PATH
[ -z "$HOSTWARDEN_MISE_BINS" ] || PATH=$HOSTWARDEN_MISE_BINS:$PATH
OS=$(uname -s 2>/dev/null)

# The guards and connection sharing need a POSIX workstation, so
# nothing below is worth probing here. WSL 1 reports Linux as well;
# only its kernel release, which ends in -Microsoft there and names
# microsoft-standard under WSL 2, tells it apart.
# website/docs/getting-started/install.md supports WSL 2 alone, and
# gets the WSL checks below.
UNSUPPORTED='' WSL=''
case "$OS" in
  MINGW*|MSYS*|CYGWIN*)
    UNSUPPORTED="a Unix workstation — on Windows, run Hostwarden in\
 WSL 2 with Ubuntu: wsl --install in an administrator PowerShell,\
 then restart" ;;
  Linux)
    REL=
    { read -r REL < /proc/sys/kernel/osrelease; } 2>/dev/null || true
    case $REL in
      *-Microsoft)
        UNSUPPORTED="WSL 2 — this distribution runs on WSL 1; convert\
 it with wsl --set-version ${WSL_DISTRO_NAME:-<distribution>} 2 in\
 PowerShell" ;;
      *microsoft-standard*) WSL=1 ;;
    esac ;;
esac
if [ -n "$UNSUPPORTED" ]; then
  echo "hostwarden: required, missing: $UNSUPPORTED" \
    "($INSTALL_DOCS#windows)"
  [ -n "$HOOK" ] && exit 0
  exit 1
fi

PM=
for p in brew apt-get dnf yum zypper pkg pacman apk; do
  has "$p" && { PM=$p; break; }
done

# pkgname <tool> — the package that ships it under $PM.
pkgname() {
  case "$1:$PM" in
    dig:brew|dig:pacman) echo bind ;;
    dig:apt-get) echo dnsutils ;;
    dig:dnf|dig:yum|dig:zypper) echo bind-utils ;;
    dig:pkg|dig:apk) echo bind-tools ;;
    python3:brew|python3:pacman) echo python ;;
    node:apt-get|node:dnf|node:yum|node:zypper|node:pacman|node:apk) echo nodejs ;;
    # No separate formula: brew install node brings npm with it.
    npm:brew) echo node ;;
    gh:pacman|gh:apk) echo github-cli ;;
    # A command, not a package: awk is virtual under apt and
    # absent by that name elsewhere, mktemp is part of coreutils.
    awk:brew) echo awk ;;
    awk:*) echo gawk ;;
    mktemp:*|base64:*) echo coreutils ;;
    ssh:apt-get|ssh-keygen:apt-get) echo openssh-client ;;
    ssh:dnf|ssh:yum|ssh-keygen:dnf|ssh-keygen:yum) echo openssh-clients ;;
    ssh:*|ssh-keygen:*) echo openssh ;;
    shellcheck:dnf|shellcheck:yum|shellcheck:zypper) echo ShellCheck ;;
    shellcheck:pkg) echo hs-ShellCheck ;;
    *) echo "$1" ;;
  esac
}

# pm_cmd " <package> ..." — the package manager's install command.
pm_cmd() {
  case "$PM" in
    brew) echo "brew install$1" ;;
    apt-get|dnf|yum|zypper|pkg) echo "sudo $PM install$1" ;;
    pacman) echo "sudo pacman -S$1" ;;
    apk) echo "sudo apk add$1" ;;
    *) echo "install:$1" ;;
  esac
}

# hint "<tool> ..." — one install command for all of them. A tool
# a mise file pins comes from mise install in this checkout, with
# MISE_ENV=dev where --dev asked, and mise itself first where it is
# missing, from a package manager that carries it without a
# repository added; the rest from the package manager.
hint() {
  pkgs='' viamise=''
  # shellcheck disable=SC2086 # one word per tool is the point
  for t in $1; do
    # jq and ShellCheck publish no FreeBSD build, so mise has none.
    case "$PM:$t" in
      pkg:jq|pkg:shellcheck) pkgs="$pkgs $(pkgname "$t")"; continue ;;
    esac
    case " $MISE_TOOLS " in
      *" $t "*) viamise=1 ;;
      *) pkgs="$pkgs $(pkgname "$t")" ;;
    esac
  done
  if [ -n "$viamise" ]; then
    m=''
    has mise || case $PM in
      brew|pacman|apk|pkg) m="$(pm_cmd ' mise') && " ;;
      *) m="install mise ($CONTRIB_DOCS), then " ;;
    esac
    echo "${m}${DEV:+MISE_ENV=dev }mise -C \"$ROOT\" install${pkgs:+; $(pm_cmd "$pkgs")}"
    return
  fi
  [ -n "$pkgs" ] || {
    echo "see $INSTALL_DOCS"
    return
  }
  pm_cmd "$pkgs"
}

# Per tier: the labels of what is missing, and the tools to name
# in its install hint. Features get one hint line each.
NEED='' NEED_T='' WANT='' WANT_T='' FEAT='' WSLM='' SHM='' KEYM=''
row() { [ -n "$QUIET" ] || echo "  $1"; }

miss() {
  case $1 in
    need) NEED="$NEED, $2" NEED_T="$NEED_T $3" ;;
    want) WANT="$WANT, $2" WANT_T="$WANT_T $3" ;;
    feat) FEAT="$FEAT
  $2: $(hint "$3")" ;;
    # A WSL setting: the third argument is the fix, not a package.
    wsl) WSLM="$WSLM
  $2: $3" ;;
    # The agent's shell: the third argument is the fix too.
    shell) SHM="$SHM
  $2: $3" ;;
    # A key ssh would offer: the third argument is the finding.
    keys) KEYM="$KEYM
  $2: $3" ;;
  esac
}

# probe <tier> <label> <hint-tool> <command...> -- one row, and a
# miss when the command fails.
probe() {
  tier=$1 label=$2 tool=$3
  shift 3
  if "$@" >/dev/null 2>&1; then
    row "ok       $label"
  else
    row "missing  $label"
    miss "$tier" "$label" "$tool"
  fi
}

any() { for t in "$@"; do has "$t" && return 0; done; return 1; }
# The jq the hooks run, run: the one mise installed, which the doctor
# has found itself, or as the hooks find one (lib/json.sh →
# hook_jq_from_mise), on the PATH they have, in a subshell so mise's
# shims stay on the doctor's own. A jq that is a mise shim is found
# where the checkout's pin is not installed, and then fails.
jq_runs() {
  if [ -n "$HOSTWARDEN_MISE_JQ" ]; then
    "$HOSTWARDEN_MISE_JQ/jq" -n . >/dev/null 2>&1
    return
  fi
  (
    PATH=$DOCTOR_PATH
    # shellcheck source=../lib/json.sh
    . "$ROOT/lib/json.sh"
    hook_jq_from_mise "$ROOT"
    jq -n .
  ) >/dev/null 2>&1
}
all() { for t in "$@"; do has "$t" || return 1; done; }

# The probes' own checks, in lib/hostwarden-doctor/checks.sh.
# shellcheck source=../lib/hostwarden-doctor/checks.sh
. "$ROOT/lib/hostwarden-doctor/checks.sh"

[ -n "$QUIET" ] || echo "Required"
probe need ssh ssh real_ssh
for t in git awk sed grep tar mktemp; do
  probe need "$t" "$t" has "$t"
done
# Sharing is how a session reaches servers, which a development
# checkout never does. There the ssh on PATH is often the shim
# (.claude/hooks/shim.sh), which refuses even -G.
[ -n "$DEV" ] || ! real_ssh \
  || probe need "ssh connection sharing and Include (OpenSSH 7.3+)" ssh ssh_shares
# An update checks out only a release tag it can verify
# (bin/hostwarden-update); a development checkout verifies none.
# The program is the one git runs, by the checkout's own config.
checkout_verifies() { (cd "$ROOT" && hostwarden_follow_ssh_verifies); }
if [ -z "$DEV" ]; then
  probe need "release tag signatures in git (2.34+)" git \
    hostwarden_follow_git_verifies
  probe need "release tag signatures in $(cd "$ROOT" &&
    hostwarden_follow_ssh_program) (OpenSSH 8.7+)" ssh-keygen \
    checkout_verifies
fi
probe need "symbolic links ($INSTALL_DOCS#symbolic-links)" "" links_work

if [ -n "$DEV" ]; then
  [ -n "$QUIET" ] || echo "Development"
  # What scripts/check.sh runs: python3, npm for the website build
  # (node itself comes from mise.dev.toml, already in
  # $MISE_DEV_TOOLS), the linter mise.toml pins, and whatever else
  # mise.dev.toml pins; and jq, for tests/instructions.sh and the
  # hooks, which has to run (jq_runs).
  for t in python3 npm shellcheck $MISE_DEV_TOOLS; do
    probe need "$t" "$t" has "$t"
  done
  probe need jq jq jq_runs

  [ -n "$QUIET" ] || echo "Per feature"
  # The pull request workflow (CONTRIBUTING.md → Setup) needs gh
  # signed in too, which this does not probe: gh auth status asks
  # GitHub, and the doctor stays offline. An "ok" here is only
  # "installed".
  probe feat "gh, for pull requests from an agent session" gh has gh
else
  [ -n "$QUIET" ] || echo "Recommended"
  # Without one, the system's or the one mise installs, the guard
  # reads the raw hook
  # input and over-blocks (.claude/hooks/guard-taboos.sh); impact.sh
  # instead fails open and lets a disruptive command through
  # unchecked, silently, since it cannot read the command reliably
  # enough to judge it (rules/coordination.md → The hooks).
  probe want jq jq jq_runs
  # The ones rules/dns-aliases.md tries; any one resolves.
  probe want "hostname resolver" python3 any getent dscacheutil python3 dig

  [ -n "$QUIET" ] || echo "Per feature"
  # rules/ssh-connections.md → Why these values
  ! real_ssh || probe feat "switching off a KnownHostsCommand in \
memory/ssh_config (OpenSSH 8.5+)" ssh ssh_khc
  # rules/ssh-passwords.md
  ! real_ssh || probe feat "password logins, for a host that takes \
no key (OpenSSH 8.4+)" ssh ssh_askpass
  probe feat "an encrypted store for SSH passwords" openssl \
    any security openssl
  # rules/ssh-connections.md, rules/directory-copy.md
  probe feat "file transfer to and from servers" rsync any rsync scp
  # hostwarden-email: transport-local.md step 5L.1, send-verify.md
  probe feat "email from this workstation" msmtp mail_ok
  att=''
  has file || att='file'
  has base64 || att="$att base64"
  probe feat "email attachments from this workstation" "$att" test -z "$att"
  # hostwarden-deploy-user: references/ssh-key.md
  probe feat "SSH keys for a deploy user" ssh-keygen has ssh-keygen
  # rules/ssh-unreachable.md
  probe feat "reachability checks when SSH fails" curl has curl
  # rules/deployed-files.md
  probe feat "shellcheck, to lint a deployed shell script before \
writing it" shellcheck has shellcheck
  # rules/workspace-playbook.md. ansible-playbook and
  # ansible-galaxy come in one package; ansible-lint is its own
  # and brings yamllint with it.
  probe feat "an Ansible playbook from the workspace, checked and \
applied" ansible-playbook all ansible-playbook ansible-galaxy
  probe feat "ansible-lint, to check a playbook before it runs" \
    ansible-lint has ansible-lint
  # rules/opentofu.md: tofu plans and applies a stack, Terragrunt
  # where a stack has a terragrunt.hcl, and the three checkers
  # bin/hostwarden-tofu check runs before a plan, each optional on
  # its own.
  probe feat "an OpenTofu stack from the workspace, checked, planned \
and applied" tofu has tofu
  probe feat "Terragrunt, for a stack that carries a terragrunt.hcl" \
    terragrunt has terragrunt
  probe feat "tflint, to lint a stack before a plan" tflint has tflint
  probe feat "Trivy, to scan a stack and a plan for misconfigurations" \
    trivy has trivy
  probe feat "Checkov, to scan a stack and a plan against its policies" \
    checkov has checkov
  # rules/infra-code.md → Credentials: the two managers' CLIs hand a
  # tree's credentials to tofu or ansible without the session
  # reading them.
  probe feat "1Password CLI, for credentials a tree takes from \
1Password" op has op
  probe feat "Bitwarden Secrets Manager CLI, for credentials a tree \
takes from Secrets Manager" bws has bws
fi

# shellcheck source=../lib/hostwarden-doctor/agent-shell.sh
. "$ROOT/lib/hostwarden-doctor/agent-shell.sh"
# shellcheck source=../lib/hostwarden-doctor/keys.sh
. "$ROOT/lib/hostwarden-doctor/keys.sh"

# Hostwarden's own SSH identity, where memory/user.md records one
# (rules/ssh-identity.md): whether its agent answers and holds the
# key, and how long its certificate has left. Not a tool to
# install, so a line of its own below.
IDM=''
if [ "$HOSTWARDEN_MODE" = operations ] && [ -z "$DEV" ]; then
  # shellcheck disable=SC2034 # read by lib/identity.sh
  ID_ROOT=$ROOT
  # shellcheck source=../lib/identity.sh
  . "$ROOT/lib/identity.sh"
  # A line that does not parse is no identity; ssh-config says so.
  if id_read 2>/dev/null && id_recorded; then
    ID_OUT=$(sh "$ROOT/bin/hostwarden-identity" check --quiet 2>&1)
    case $? in
      0) row "ok       Hostwarden's SSH identity" ;;
      4) row "ok       Hostwarden's SSH identity"
         row "unusable Hostwarden's SSH certificate" ;;
      *) row "missing  Hostwarden's SSH identity" ;;
    esac
    # On success, a certificate that ends soon. One line, where the
    # agent and the certificate both have something to say.
    IDM=$(printf '%s\n' "$ID_OUT" | sed 's/^hostwarden-identity: //' |
      awk 'NF { printf "%s%s", (n++ ? "; " : ""), $0 }')
  fi
fi

# Running inside WSL: what
# website/docs/getting-started/install.md → Windows asks for.
if [ -n "$WSL" ]; then
  [ -n "$QUIET" ] || echo "WSL"
  probe wsl "clone in the distribution's own filesystem" "the clone \
is on the Windows drive under /mnt; clone it again under ~" in_distro_fs
  [ -n "$DEV" ] || probe wsl "an SSH key reachable from WSL" "no key \
in ~/.ssh or in an agent this distribution reaches" key_reachable
fi

[ -n "$QUIET" ] || echo
HINTS=''
if [ -n "$NEED" ]; then
  h=$(hint "$NEED_T") HINTS="$HINTS$h"
  echo "hostwarden: required, missing: ${NEED#, } — $h"
fi
if [ -n "$WANT" ]; then
  h=$(hint "$WANT_T") HINTS="$HINTS$h"
  echo "hostwarden: recommended, missing: ${WANT#, } — $h"
fi
if [ -n "$FEAT" ]; then
  echo "hostwarden: not available on this workstation:$FEAT"
fi
# The session reads where mise put the tools at its start, which a
# command a person can paste cannot say.
case "$HINTS$FEAT" in
  *"mise -C"*) echo "hostwarden: a session sees what mise installs at its next start." ;;
esac
if [ -n "$WSLM" ]; then
  echo "hostwarden: WSL setup, recommended ($INSTALL_DOCS#windows):$WSLM"
fi
if [ -n "$SHM" ]; then
  echo "hostwarden: agent shell, recommended:$SHM"
fi
if [ -n "$IDM" ]; then
  echo "hostwarden: Hostwarden's SSH identity: $IDM"
fi
if [ -n "$KEYM" ]; then
  echo "hostwarden: SSH keys, recommended:$KEYM"
fi
if [ -z "$QUIET$NEED$WANT$FEAT$WSLM$SHM$IDM$KEYM" ]; then
  echo "Everything Hostwarden runs locally is here."
fi

[ -n "$HOOK" ] || [ -z "$NEED" ]
