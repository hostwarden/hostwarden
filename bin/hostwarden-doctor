#!/bin/sh
# hostwarden-doctor — what this workstation has of the tools
# Hostwarden runs locally, and what to install for the rest.
#
# Usage:
#   hostwarden-doctor           Full report
#   hostwarden-doctor --quiet   Only what is missing; nothing at
#                               all when nothing is (the
#                               SessionStart hook). Outside an
#                               operations checkout, what --dev
#                               checks
#   hostwarden-doctor --dev     What working on Hostwarden itself
#                               needs instead of what running it
#                               does (scripts/check.sh uses it)
#   hostwarden-doctor --help    Show this help
#
# Checks the machine the AI tool runs on, never a managed host.
# Prints install commands; never runs them.
# Exit status: 1 when something required is missing, else 0.
# --quiet prints only what is missing and, without --dev, always
# exits 0.

QUIET='' DEV=''
for a in "$@"; do
  case $a in
    --quiet) QUIET=1 ;;
    --dev) DEV=1 ;;
    # Help needs nothing the doctor might be about to report as
    # missing, sed included.
    -h|--help)
      while IFS= read -r l; do
        case $l in '#!'*) continue ;; '#'*) ;; *) break ;; esac
        l=${l#\#}
        echo "${l# }"
      done < "$0"
      exit 0 ;;
    *) echo "hostwarden-doctor: unknown option $a" >&2; exit 2 ;;
  esac
done

# --quiet without --dev is the SessionStart hook, which reports
# and exits 0: Claude Code passes a hook's output on only then.
# --dev keeps the verdict for scripts/check.sh, which a missing
# feature must not stop.
HOOK=''
[ -z "$QUIET" ] || [ -n "$DEV" ] || HOOK=1

has() { command -v "$1" >/dev/null 2>&1; }

# The shell alone from here to the probes: anything else could be
# one of the tools this is about to report missing.
case $0 in */*) ROOT=${0%/*}/.. ;; *) ROOT=.. ;; esac
ROOT=$(cd "$ROOT" && pwd)
# shellcheck source=../.claude/hooks/mode.sh
. "$ROOT/.claude/hooks/mode.sh"
# website/docs/getting-started/install.md, published — every row
# below that points a user there names it once.
INSTALL_DOCS=https://hostwarden.github.io/docs/getting-started/install
# The SessionStart hook runs in every checkout. One that is not for
# operations reaches no server, so what it needs is what working on
# Hostwarden needs. Only the hook: a full report run by hand in a
# fresh clone, before bin/hostwarden-init, is for someone installing
# Hostwarden to run it.
if [ -n "$HOOK" ]; then
  hostwarden_mode "$ROOT"
  [ "$HOSTWARDEN_MODE" = operations ] || DEV=1
fi
MISE_TOOLS=''
if [ -f "$ROOT/mise.dev.toml" ]; then
  while IFS= read -r l; do
    case $l in '"aqua:'*/*) t=${l#*/}; MISE_TOOLS="$MISE_TOOLS ${t%%\"*}" ;; esac
    # A plain [tools] key, node the one there is today: the command
    # name is what is before its `=`. Matched with or without the
    # spacing mise.dev.toml's own style uses, no external tool
    # (this runs under the ssh shim's bare PATH too). A quoted key
    # or an inline table would not match either form; neither is in
    # mise.dev.toml.
    case $l in
      [a-z]*' = "'*) t=${l%% *}; MISE_TOOLS="$MISE_TOOLS $t" ;;
      [a-z]*'="'*) t=${l%%=*}; MISE_TOOLS="$MISE_TOOLS $t" ;;
    esac
  done < "$ROOT/mise.dev.toml"
fi
# The tools mise.dev.toml pins are on PATH only with MISE_ENV=dev.
# scripts/check.sh brings them in before it asks; a session start
# that asks on its own has to see the same PATH, or it reports
# installed tools as missing. mise bin-paths, not mise env: env
# installs what is missing, and the doctor installs nothing.
if [ -n "$DEV" ] && [ -n "$MISE_TOOLS" ] && has mise; then
  bins=$(cd "$ROOT" && MISE_ENV=dev mise bin-paths 2>/dev/null) || bins=''
  while IFS= read -r d; do
    [ -z "$d" ] || PATH=$d:$PATH
  done <<EOF
$bins
EOF
fi
OS=$(uname -s 2>/dev/null)

# The guards and connection sharing need a POSIX workstation, so
# nothing below is worth probing here. WSL 1 reports Linux as well;
# only its kernel release, which ends in -Microsoft there and names
# microsoft-standard under WSL 2, tells it apart.
# website/docs/getting-started/install.md supports WSL 2 alone, and
# gets the WSL checks below.
UNSUPPORTED='' WSL=''
case "$OS" in
  MINGW*|MSYS*|CYGWIN*)
    UNSUPPORTED="a Unix workstation — on Windows, run Hostwarden in\
 WSL 2 with Ubuntu: wsl --install in an administrator PowerShell,\
 then restart" ;;
  Linux)
    REL=
    { read -r REL < /proc/sys/kernel/osrelease; } 2>/dev/null || true
    case $REL in
      *-Microsoft)
        UNSUPPORTED="WSL 2 — this distribution runs on WSL 1; convert\
 it with wsl --set-version ${WSL_DISTRO_NAME:-<distribution>} 2 in\
 PowerShell" ;;
      *microsoft-standard*) WSL=1 ;;
    esac ;;
esac
if [ -n "$UNSUPPORTED" ]; then
  echo "hostwarden: required, missing: $UNSUPPORTED" \
    "($INSTALL_DOCS#windows)"
  [ -n "$HOOK" ] && exit 0
  exit 1
fi

PM=
for p in brew apt-get dnf yum zypper pkg pacman apk; do
  has "$p" && { PM=$p; break; }
done

# pkgname <tool> — the package that ships it under $PM.
pkgname() {
  case "$1:$PM" in
    dig:brew|dig:pacman) echo bind ;;
    dig:apt-get) echo dnsutils ;;
    dig:dnf|dig:yum|dig:zypper) echo bind-utils ;;
    dig:pkg|dig:apk) echo bind-tools ;;
    python3:brew|python3:pacman) echo python ;;
    node:apt-get|node:dnf|node:yum|node:zypper|node:pacman|node:apk) echo nodejs ;;
    # No separate formula: brew install node brings npm with it.
    npm:brew) echo node ;;
    gh:pacman|gh:apk) echo github-cli ;;
    # A command, not a package: awk is virtual under apt and
    # absent by that name elsewhere, mktemp is part of coreutils.
    awk:brew) echo awk ;;
    awk:*) echo gawk ;;
    mktemp:*|base64:*) echo coreutils ;;
    ssh:apt-get|ssh-keygen:apt-get) echo openssh-client ;;
    ssh:dnf|ssh:yum|ssh-keygen:dnf|ssh-keygen:yum) echo openssh-clients ;;
    ssh:*|ssh-keygen:*) echo openssh ;;
    shellcheck:dnf|shellcheck:yum|shellcheck:zypper) echo ShellCheck ;;
    shellcheck:pkg) echo hs-ShellCheck ;;
    *) echo "$1" ;;
  esac
}

# hint "<tool> ..." — one install command for all of them.
hint() {
  pkgs=
  # shellcheck disable=SC2086 # one word per tool is the point
  for t in $1; do pkgs="$pkgs $(pkgname "$t")"; done
  [ -n "$pkgs" ] || {
    echo "see $INSTALL_DOCS"
    return
  }
  case "$PM" in
    brew) echo "brew install$pkgs" ;;
    apt-get|dnf|yum|zypper|pkg) echo "sudo $PM install$pkgs" ;;
    pacman) echo "sudo pacman -S$pkgs" ;;
    apk) echo "sudo apk add$pkgs" ;;
    *) echo "install:$pkgs" ;;
  esac
}

# Per tier: the labels of what is missing, and the tools to name
# in its install hint. Features get one hint line each. A tool
# mise.dev.toml pins goes to MISE_T instead: no package manager
# has it under that name, mise does.
NEED='' NEED_T='' MISE_T='' WANT='' WANT_T='' FEAT='' WSLM=''
row() { [ -n "$QUIET" ] || echo "  $1"; }

miss() {
  case $1 in
    need) NEED="$NEED, $2"
      case " $MISE_TOOLS " in
        *" ${3:--} "*) MISE_T="$MISE_T $3" ;;
        *) NEED_T="$NEED_T $3" ;;
      esac ;;
    want) WANT="$WANT, $2" WANT_T="$WANT_T $3" ;;
    feat) FEAT="$FEAT
  $2: $(hint "$3")" ;;
    # A WSL setting: the third argument is the fix, not a package.
    wsl) WSLM="$WSLM
  $2: $3" ;;
  esac
}

# probe <tier> <label> <hint-tool> <command...> -- one row, and a
# miss when the command fails.
probe() {
  tier=$1 label=$2 tool=$3
  shift 3
  if "$@" >/dev/null 2>&1; then
    row "ok       $label"
  else
    row "missing  $label"
    miss "$tier" "$label" "$tool"
  fi
}

any() { for t in "$@"; do has "$t" && return 0; done; return 1; }

# An ssh on PATH that is not the shim (.claude/hooks/shim.sh): the
# one git-ssh.sh hands a push to, on the same PATH. Only looked
# for, never run.
real_ssh() {
  hostwarden_path_without_shim
  (PATH=$HOSTWARDEN_PATH && command -v ssh >/dev/null)
}

# Every call shares one connection and passes memory/ssh_config
# (AGENTS.md → SSH Options), whose Include and ProxyJump need
# OpenSSH 7.3: 7.2 rejects the file before connecting. -G parses
# and connects to nothing; the config on stdin holds only an
# Include of nothing, so the user's config, and any Match exec in
# it, stay out.
ssh_shares() {
  set --
  for o in $HOSTWARDEN_SSH_OPTIONS; do set -- "$@" -o "$o"; done
  printf 'Match all\n  Include /nonexistent/hostwarden-probe\n' |
    ssh -F /dev/stdin -G "$@" example.invalid
}

# KnownHostsCommand came with OpenSSH 8.5. An older ssh rejects the
# keyword, so bin/hostwarden-ssh-config leaves it out there; this
# names the case, and the install that brings it back.
ssh_khc() {
  ssh -F /dev/null -G -o KnownHostsCommand=none example.invalid
}

# .claude/skills and every DNS alias are links, and git writes a
# text file where it cannot link
# (website/docs/getting-started/install.md → Symbolic links).
# Probed in the clone: a temporary directory can sit on a
# filesystem that links when this one does not.
links_work() {
  d=$(mktemp -d "$ROOT/.link-probe.XXXXXX") || return 1
  ln -s "$d" "$d/l" 2>/dev/null
  [ -L "$d/l" ]
  rc=$?
  rm -rf "$d"
  return $rc
}

# The transport 5L.1 accepts. macOS ships a sendmail that delivers
# only while its Postfix is loaded.
mail_ok() {
  has msmtp && return 0
  # The absolute path too, as 5L.1 does: a PATH without /usr/sbin
  # is common, and the MTA puts it there.
  has sendmail || [ -x /usr/sbin/sendmail ] || return 1
  [ "$OS" = Darwin ] || return 0
  launchctl print system/com.apple.postfix.master
}

# The drives under /mnt are Windows' own filesystem: slow for git,
# and without Unix permissions unless mounted with metadata.
in_distro_fs() { case $ROOT in /mnt/?/*) return 1 ;; esac; }

# A key ssh can use from here: a key file ssh would try, or one an
# agent holds, the one in SSH_AUTH_SOCK or an IdentityAgent from
# ~/.ssh/config. Keys in Windows' ssh-agent or in a password
# manager on Windows are not reachable from WSL unless something
# relays them. Only names are checked, never contents; the common
# case, a default key file, costs no process.
key_reachable() {
  # The names ssh tries on its own (ssh_config(5) → IdentityFile).
  for f in id_rsa id_ecdsa id_ecdsa_sk id_ed25519 id_ed25519_sk; do
    [ -f "$HOME/.ssh/$f" ] && return 0
  done
  has ssh-add && ssh-add -l >/dev/null 2>&1 && return 0
  ssh_conf_key "$HOME/.ssh/config" 0
}

# ssh_conf_key <file> <depth> — an IdentityFile or IdentityAgent
# that works, in <file> or a file it includes, host blocks too.
# Read as text, never through ssh -G, which would run any Match
# exec at every session start. Include nests at most five deep,
# as a loop of includes must end somewhere.
ssh_conf_key() {
  [ "$2" -lt 5 ] && [ -r "$1" ] || return 1
  while read -r k f; do
    # Key value, Key=value and Key = value all occur.
    case $k in *=*) f=${k#*=} k=${k%%=*} ;; esac
    f=${f#=} f=${f# }
    # A quoted value ends at its closing quote; an unquoted one at
    # a # that starts a word, which ssh reads as a comment.
    case $f in
      \"*) f=${f#\"} f=${f%%\"*} ;;
      *) f=${f%%[[:space:]]#*} f=${f%"${f##*[![:space:]]}"} ;;
    esac
    case $f in \~/*) f=$HOME/${f#\~/} ;; esac
    case $k in
      [Ii][Dd][Ee][Nn][Tt][Ii][Tt][Yy][Ff][Ii][Ll][Ee]) [ -f "$f" ] && return 0 ;;
      [Ii][Dd][Ee][Nn][Tt][Ii][Tt][Yy][Aa][Gg][Ee][Nn][Tt]) [ -S "$f" ] \
        && has ssh-add && SSH_AUTH_SOCK=$f ssh-add -l >/dev/null 2>&1 \
        && return 0 ;;
      # Several names, each relative to ~/.ssh unless absolute,
      # each a glob. Split first, glob after the prefix.
      [Ii][Nn][Cc][Ll][Uu][Dd][Ee])
        set -f
        for i in $f; do
          case $i in \~/*) i=$HOME/${i#\~/} ;; /*) ;; *) i=$HOME/.ssh/$i ;; esac
          set +f
          for j in $i; do
            ssh_conf_key "$j" $(($2 + 1)) && return 0
          done
          set -f
        done
        set +f ;;
    esac
  done < "$1"
  return 1
}

[ -n "$QUIET" ] || echo "Required"
probe need ssh ssh real_ssh
for t in git awk sed grep tar mktemp; do
  probe need "$t" "$t" has "$t"
done
# Sharing is how a session reaches servers, which a development
# checkout never does. There the ssh on PATH is often the shim
# (.claude/hooks/shim.sh), which refuses even -G.
[ -n "$DEV" ] || ! real_ssh \
  || probe need "ssh connection sharing and Include (OpenSSH 7.3+)" ssh ssh_shares
probe need "symbolic links ($INSTALL_DOCS#symbolic-links)" "" links_work

if [ -n "$DEV" ]; then
  [ -n "$QUIET" ] || echo "Development"
  # What scripts/check.sh runs: python3, jq for
  # instructions-test.sh, npm for the website build (node itself
  # comes from mise.dev.toml, already in $MISE_TOOLS), and whatever
  # else mise.dev.toml pins.
  for t in python3 jq npm $MISE_TOOLS; do
    probe need "$t" "$t" has "$t"
  done

  [ -n "$QUIET" ] || echo "Per feature"
  # The pull request workflow (CONTRIBUTING.md → Setup) needs gh
  # signed in too, which this does not probe: gh auth status asks
  # GitHub, and the doctor stays offline. An "ok" here is only
  # "installed".
  probe feat "gh, for pull requests from an agent session" gh has gh
else
  [ -n "$QUIET" ] || echo "Recommended"
  # Without it the guard reads the raw hook input and over-blocks
  # (.claude/hooks/guard-taboos.sh); impact.sh instead fails open and
  # lets a disruptive command through unchecked, silently, since it
  # cannot read the command reliably enough to judge it
  # (rules/coordination.md → The hooks).
  probe want jq jq has jq
  # The ones rules/dns-aliases.md tries; any one resolves.
  probe want "hostname resolver" python3 any getent dscacheutil python3 dig

  [ -n "$QUIET" ] || echo "Per feature"
  # rules/ssh-connections.md → Why these values
  ! real_ssh || probe feat "switching off a KnownHostsCommand in \
memory/ssh_config (OpenSSH 8.5+)" ssh ssh_khc
  # rules/ssh-connections.md, rules/directory-copy.md
  probe feat "file transfer to and from servers" rsync any rsync scp
  # hostwarden-email: transport-local.md step 5L.1, send-verify.md
  probe feat "email from this workstation" msmtp mail_ok
  att=''
  has file || att='file'
  has base64 || att="$att base64"
  probe feat "email attachments from this workstation" "$att" test -z "$att"
  # hostwarden-deploy-user: references/ssh-key.md
  probe feat "SSH keys for a deploy user" ssh-keygen has ssh-keygen
  # rules/ssh-unreachable.md
  probe feat "reachability checks when SSH fails" curl has curl
  # rules/deployed-files.md
  probe feat "shellcheck, to lint a deployed shell script before \
writing it" shellcheck has shellcheck
fi

# Running inside WSL: what
# website/docs/getting-started/install.md → Windows asks for.
if [ -n "$WSL" ]; then
  [ -n "$QUIET" ] || echo "WSL"
  probe wsl "clone in the distribution's own filesystem" "the clone \
is on the Windows drive under /mnt; clone it again under ~" in_distro_fs
  [ -n "$DEV" ] || probe wsl "an SSH key reachable from WSL" "no key \
in ~/.ssh or in an agent this distribution reaches" key_reachable
fi

[ -n "$QUIET" ] || echo
if [ -n "$NEED" ]; then
  fix=''
  [ -z "$NEED_T" ] || fix=$(hint "$NEED_T")
  if [ -n "$MISE_T" ]; then
    # mise itself from a package manager that carries it without a
    # repository added first; CONTRIBUTING.md → Setup for the rest.
    m=''
    has mise || case $PM in
      brew|pacman|apk|pkg) m="$(hint mise) && " ;;
      *) m="install mise (CONTRIBUTING.md → Setup), then " ;;
    esac
    fix="${fix:+$fix; }${m}mise trust mise.dev.toml && MISE_ENV=dev mise install"
  fi
  echo "hostwarden: required, missing: ${NEED#, } — $fix"
fi
if [ -n "$WANT" ]; then
  echo "hostwarden: recommended, missing: ${WANT#, } — $(hint "$WANT_T")"
fi
if [ -n "$FEAT" ]; then
  echo "hostwarden: not available on this workstation:$FEAT"
fi
if [ -n "$WSLM" ]; then
  echo "hostwarden: WSL setup, recommended ($INSTALL_DOCS#windows):$WSLM"
fi
if [ -z "$QUIET$NEED$WANT$FEAT$WSLM" ]; then
  echo "Everything Hostwarden runs locally is here."
fi

[ -n "$HOOK" ] || [ -z "$NEED" ]
