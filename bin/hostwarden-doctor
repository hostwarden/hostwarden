#!/bin/sh
# hostwarden-doctor — what this workstation has of the tools
# hostwarden runs locally, and what to install for the rest.
#
# Usage:
#   hostwarden-doctor           Full report
#   hostwarden-doctor --quiet   Only what is missing; nothing
#                               at all when nothing is
#                               (the SessionStart hook)
#   hostwarden-doctor --help    Show this help
#
# Checks the workstation only — the machine the AI tool runs
# on. What a managed host has is found out over SSH, per host.
#
# It never installs anything. The workstation is the user's own
# machine, not a host hostwarden administers, and none of the
# consent gates that make a remote install safe cover it. It
# prints the command; the user runs it.
#
# Exit status: 0 when everything required is there, 1 when not.

QUIET=
case "${1:-}" in
  --quiet) QUIET=1 ;;
  -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  '') ;;
  *) echo "hostwarden-doctor: unknown option $1" >&2; exit 2 ;;
esac

has() { command -v "$1" >/dev/null 2>&1; }

# --- package manager, for the install hint ----------------------
PM=
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*) PM=gitbash ;;
esac
if [ -z "$PM" ]; then
  for p in brew apt-get dnf zypper pkg pacman apk; do
    has "$p" && { PM=$p; break; }
  done
fi

# pkgname <tool> — the package that ships it under $PM.
pkgname() {
  case "$1:$PM" in
    dig:brew|dig:pacman) echo bind ;;
    dig:apt-get) echo dnsutils ;;
    dig:dnf|dig:zypper) echo bind-utils ;;
    dig:pkg|dig:apk) echo bind-tools ;;
    python3:brew) echo python ;;
    python3:pacman) echo python ;;
    ssh:apt-get|ssh-keygen:apt-get) echo openssh-client ;;
    ssh:dnf|ssh-keygen:dnf) echo openssh-clients ;;
    ssh:*|ssh-keygen:*) echo openssh ;;
    *) echo "$1" ;;
  esac
}

# hint <tool...> — one install command for all of them.
hint() {
  pkgs=
  for t in "$@"; do pkgs="$pkgs $(pkgname "$t")"; done
  case "$PM" in
    brew) echo "brew install$pkgs" ;;
    apt-get) echo "sudo apt-get install$pkgs" ;;
    dnf) echo "sudo dnf install$pkgs" ;;
    zypper) echo "sudo zypper install$pkgs" ;;
    pkg) echo "sudo pkg install$pkgs" ;;
    pacman) echo "sudo pacman -S$pkgs" ;;
    apk) echo "sudo apk add$pkgs" ;;
    gitbash) echo "Git Bash cannot install these; WSL can (README → Windows)" ;;
    *) echo "install:$pkgs" ;;
  esac
}

REQ_MISSING=
SSH_OLD=
REC_MISSING=
FEAT_MISSING=
report() { [ -n "$QUIET" ] || echo "$@"; }

# --- required: without these hostwarden does not work ------------
report "Required"
for t in ssh git awk sed grep tar mktemp; do
  if has "$t"; then
    report "  ok       $t"
  else
    report "  MISSING  $t"
    REQ_MISSING="$REQ_MISSING $t"
  fi
done

# Every SSH call shares one connection (AGENTS.md → SSH Options).
# ssh -G only parses the options and connects to nothing, so an
# OpenSSH too old for them fails here instead of on a server.
if has ssh; then
  if ssh -G -o ControlMaster=auto \
      -o "ControlPath=$HOME/.cache/hostwarden/ssh-%C" \
      -o ControlPersist=10m example.invalid >/dev/null 2>&1; then
    report "  ok       ssh connection sharing"
  else
    report "  MISSING  ssh connection sharing (OpenSSH 6.8 or newer)"
    SSH_OLD=1
  fi
fi

# --- recommended: missing costs precision, not function ----------
report "Recommended"
check_rec() {
  # check_rec <tool> <what goes without it...>
  t=$1
  shift
  if has "$t"; then
    report "  ok       $t"
  else
    report "  missing  $t — $*"
    REC_MISSING="$REC_MISSING $t"
  fi
}
check_rec jq "the taboo guard reads the raw hook input" \
  "instead of the command, and blocks more than it has to"
# A resolver is needed to compare a hostname against the
# blacklist and to recognise a DNS alias (rules/dns-aliases.md).
# One of these is enough, in the order that file tries them.
if has getent || has dscacheutil || has python3 || has dig; then
  report "  ok       hostname resolver"
else
  report "  missing  hostname resolver — the blacklist and DNS" \
    "aliases can only be matched by name, not by address"
  REC_MISSING="$REC_MISSING python3"
fi

# --- per feature: missing switches off that one feature ----------
report "Per feature"
check_feat() {
  # check_feat <feature> <tool...> — any one of the tools will do.
  feat=$1
  shift
  for t in "$@"; do
    if has "$t"; then
      report "  ok       $feat ($t)"
      return
    fi
  done
  report "  missing  $feat — needs $*"
  FEAT_MISSING="$FEAT_MISSING
  $feat: $(hint "$1")"
}
check_feat "file transfer to and from servers" rsync scp
check_feat "email sent from this workstation" msmtp sendmail
check_feat "SSH keys for a deploy user" ssh-keygen
check_feat "reachability checks when SSH fails" curl

# --- summary -----------------------------------------------------
if [ -n "$QUIET" ]; then
  # Only what someone has to act on, in as few lines as it takes:
  # this lands in the session's context.
  if [ -n "$REQ_MISSING" ]; then
    echo "hostwarden: this workstation lacks required tools:$REQ_MISSING"
    # shellcheck disable=SC2086 # one word per tool is the point
    echo "  $(hint $REQ_MISSING)"
    echo "  Remote administration will not work until they are there."
  fi
  if [ -n "$SSH_OLD" ]; then
    echo "hostwarden: this ssh cannot share connections" \
      "(AGENTS.md → SSH Options needs OpenSSH 6.8 or newer)" \
      "— $(hint ssh)"
  fi
  if [ -n "$REC_MISSING" ]; then
    # shellcheck disable=SC2086
    echo "hostwarden: recommended but missing:$REC_MISSING" \
      "— $(hint $REC_MISSING)"
  fi
  if [ -n "$FEAT_MISSING" ]; then
    echo "hostwarden: not available on this workstation:$FEAT_MISSING"
  fi
else
  echo
  [ -n "$SSH_OLD" ] && echo "To share connections: $(hint ssh)"
  if [ -n "$REQ_MISSING$REC_MISSING" ]; then
    # shellcheck disable=SC2086 # one word per tool is the point
    echo "To install: $(hint $REQ_MISSING $REC_MISSING)"
  fi
  if [ -n "$FEAT_MISSING" ]; then
    echo "For the features above:$FEAT_MISSING"
  fi
  [ -z "$REQ_MISSING$REC_MISSING$FEAT_MISSING$SSH_OLD" ] \
    && echo "Everything hostwarden runs locally is here."
fi

[ -z "$REQ_MISSING$SSH_OLD" ]
