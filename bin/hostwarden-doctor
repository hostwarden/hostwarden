#!/bin/sh
# hostwarden-doctor — what this workstation has of the tools
# hostwarden runs locally, and what to install for the rest.
#
# Usage:
#   hostwarden-doctor           Full report
#   hostwarden-doctor --quiet   Only what is missing; nothing at
#                               all when nothing is (the
#                               SessionStart hook)
#   hostwarden-doctor --dev     What working on hostwarden itself
#                               needs instead of what running it
#                               does (scripts/check.sh uses it)
#   hostwarden-doctor --help    Show this help
#
# Checks the machine the AI tool runs on, never a managed host.
# Prints install commands; never runs them.
# Exit status: 1 when something required is missing, else 0 —
# but --quiet without --dev always exits 0: Claude Code passes a
# SessionStart hook's output to the session only then.

QUIET='' DEV=''
for a in "$@"; do
  case $a in
    --quiet) QUIET=1 ;;
    --dev) DEV=1 ;;
    -h|--help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "hostwarden-doctor: unknown option $a" >&2; exit 2 ;;
  esac
done

has() { command -v "$1" >/dev/null 2>&1; }

case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*) PM=gitbash ;;
  *)
    PM=
    for p in brew apt-get dnf zypper pkg pacman apk; do
      has "$p" && { PM=$p; break; }
    done ;;
esac

# pkgname <tool> — the package that ships it under $PM.
pkgname() {
  case "$1:$PM" in
    dig:brew|dig:pacman) echo bind ;;
    dig:apt-get) echo dnsutils ;;
    dig:dnf|dig:zypper) echo bind-utils ;;
    dig:pkg|dig:apk) echo bind-tools ;;
    python3:brew|python3:pacman) echo python ;;
    # A command, not a package: awk is virtual under apt and
    # absent by that name elsewhere, mktemp is part of coreutils.
    awk:brew) echo awk ;;
    awk:*) echo gawk ;;
    mktemp:*) echo coreutils ;;
    ssh:apt-get|ssh-keygen:apt-get) echo openssh-client ;;
    ssh:dnf|ssh-keygen:dnf) echo openssh-clients ;;
    ssh:*|ssh-keygen:*) echo openssh ;;
    *) echo "$1" ;;
  esac
}

# hint "<tool> ..." — one install command for all of them.
hint() {
  pkgs=
  # shellcheck disable=SC2086 # one word per tool is the point
  for t in $1; do pkgs="$pkgs $(pkgname "$t")"; done
  [ -n "$pkgs" ] || { echo "see the README"; return; }
  case "$PM" in
    brew) echo "brew install$pkgs" ;;
    apt-get|dnf|zypper|pkg) echo "sudo $PM install$pkgs" ;;
    pacman) echo "sudo pacman -S$pkgs" ;;
    apk) echo "sudo apk add$pkgs" ;;
    gitbash) echo "Git Bash cannot install$pkgs; WSL can (README → Windows)" ;;
    *) echo "install:$pkgs" ;;
  esac
}

# Per tier: the labels of what is missing, and the tools to name
# in its install hint. Features get one hint line each.
NEED='' NEED_T='' WANT='' WANT_T='' FEAT=''
row() { [ -n "$QUIET" ] || echo "  $1"; }

# check <tier> <label> <hint-tool> <tool...> — any one tool will do.
check() {
  tier=$1 label=$2 tool=$3
  shift 3
  for t in "$@"; do
    has "$t" && { row "ok       $label"; return; }
  done
  row "missing  $label"
  miss "$tier" "$label" "$tool"
}

miss() {
  case $1 in
    need) NEED="$NEED, $2" NEED_T="$NEED_T $3" ;;
    want) WANT="$WANT, $2" WANT_T="$WANT_T $3" ;;
    feat) FEAT="$FEAT
  $2: $(hint "$3")" ;;
  esac
}

# mail_ok -- the transport 5L.1 accepts. macOS ships a sendmail
# that delivers only while its Postfix is loaded.
mail_ok() {
  has msmtp && return 0
  has sendmail || return 1
  [ "$(uname -s)" = Darwin ] || return 0
  launchctl print system/com.apple.postfix.master >/dev/null 2>&1
}

[ -n "$QUIET" ] || echo "Required"
for t in ssh git awk sed grep tar mktemp; do
  check need "$t" "$t" "$t"
done
# Every call shares one connection (AGENTS.md → SSH Options).
# ssh -G parses the options and connects to nothing.
if has ssh; then
  if ssh -G -o ControlMaster=auto \
      -o "ControlPath=$HOME/.cache/hostwarden/ssh-%C" \
      -o ControlPersist=10m example.invalid >/dev/null 2>&1; then
    row "ok       ssh connection sharing"
  else
    row "missing  ssh connection sharing"
    miss need "ssh connection sharing (OpenSSH 6.8+)" ssh
  fi
fi

# .claude/skills and every DNS alias are links. Git Bash copies
# where it should link unless MSYS says otherwise, and says
# nothing (README → Windows), so make one and look.
d=$(mktemp -d 2>/dev/null) && {
  if ln -s "$d" "$d/l" 2>/dev/null && [ -L "$d/l" ]; then
    row "ok       symbolic links"
  else
    row "missing  symbolic links"
    miss need "symbolic links (README → Windows)" ""
  fi
  rm -rf "$d"
}

if [ -n "$DEV" ]; then
  # The tools scripts/check.sh runs, pinned in mise.dev.toml.
  [ -n "$QUIET" ] || echo "Development"
  for t in python3 shellcheck actionlint betterleaks; do
    check need "$t" "$t" "$t"
  done
else
  [ -n "$QUIET" ] || echo "Recommended"
  # Without it the guard reads the raw hook input and over-blocks
  # (.claude/hooks/guard-taboos.sh).
  check want jq jq jq
  # The order rules/dns-aliases.md tries them in; any one resolves.
  check want "hostname resolver" python3 getent dscacheutil python3 dig

  [ -n "$QUIET" ] || echo "Per feature"
  # rules/ssh-connections.md, rules/directory-copy.md
  check feat "file transfer to and from servers" rsync rsync scp
  # hostwarden-email: transport-local.md step 5L.1, send-verify.md
  if mail_ok; then
    row "ok       email from this workstation"
  else
    row "missing  email from this workstation"
    miss feat "email from this workstation" msmtp
  fi
  if has file && has base64; then
    row "ok       email attachments from this workstation"
  else
    row "missing  email attachments from this workstation"
    miss feat "email attachments from this workstation" file
  fi
  # hostwarden-deploy-user: references/ssh-key.md
  check feat "SSH keys for a deploy user" ssh-keygen ssh-keygen
  # rules/ssh-unreachable.md
  check feat "reachability checks when SSH fails" curl curl
fi

[ -n "$QUIET" ] || echo
if [ -n "$NEED" ]; then
  fix=$(hint "$NEED_T")
  # mise.dev.toml pins these three and nothing else, so it is an
  # alternative only when they are all that is missing.
  case "$DEV:$NEED_T" in
    1:*[!\ ]*) mise_only=1
      for t in $NEED_T; do
        case $t in shellcheck|actionlint|betterleaks) ;;
          *) mise_only= ;; esac
      done
      [ -z "$mise_only" ] || fix="$fix, or MISE_ENV=dev mise install" ;;
  esac
  echo "hostwarden: required, missing: ${NEED#, } — $fix"
fi
if [ -n "$WANT" ]; then
  echo "hostwarden: recommended, missing: ${WANT#, } — $(hint "$WANT_T")"
fi
if [ -n "$FEAT" ]; then
  echo "hostwarden: not available on this workstation:$FEAT"
fi
if [ -z "$QUIET$NEED$WANT$FEAT" ]; then
  echo "Everything hostwarden runs locally is here."
fi

[ -z "$NEED" ] && exit 0
[ -n "$QUIET" ] && [ -z "$DEV" ] && exit 0
exit 1
