#!/bin/sh
# hostwarden-doctor — what this workstation has of the tools
# hostwarden runs locally, and what to install for the rest.
#
# Usage:
#   hostwarden-doctor           Full report
#   hostwarden-doctor --quiet   Only what is missing; nothing at
#                               all when nothing is (the
#                               SessionStart hook)
#   hostwarden-doctor --dev     What working on hostwarden itself
#                               needs instead of what running it
#                               does (scripts/check.sh uses it)
#   hostwarden-doctor --help    Show this help
#
# Checks the machine the AI tool runs on, never a managed host.
# Prints install commands; never runs them.
# Exit status: 1 when something required is missing, else 0.
# --quiet always exits 0 and prints only what is missing.

QUIET='' DEV=''
for a in "$@"; do
  case $a in
    --quiet) QUIET=1 ;;
    --dev) DEV=1 ;;
    # Help needs nothing the doctor might be about to report as
    # missing, sed included.
    -h|--help)
      while IFS= read -r l; do
        case $l in '#!'*) continue ;; '#'*) ;; *) break ;; esac
        l=${l#\#}
        echo "${l# }"
      done < "$0"
      exit 0 ;;
    *) echo "hostwarden-doctor: unknown option $a" >&2; exit 2 ;;
  esac
done

has() { command -v "$1" >/dev/null 2>&1; }

# The shell alone from here to the probes: anything else could be
# one of the tools this is about to report missing.
case $0 in */*) ROOT=${0%/*}/.. ;; *) ROOT=.. ;; esac
ROOT=$(cd "$ROOT" && pwd)
MISE_TOOLS=''
if [ -f "$ROOT/mise.dev.toml" ]; then
  while IFS= read -r l; do
    case $l in '"aqua:'*/*) t=${l#*/}; MISE_TOOLS="$MISE_TOOLS ${t%%\"*}" ;; esac
  done < "$ROOT/mise.dev.toml"
fi
OS=$(uname -s 2>/dev/null)

case "$OS" in
  MINGW*|MSYS*|CYGWIN*) PM=gitbash ;;
  *)
    PM=
    for p in brew apt-get dnf zypper pkg pacman apk; do
      has "$p" && { PM=$p; break; }
    done ;;
esac

# pkgname <tool> — the package that ships it under $PM.
pkgname() {
  case "$1:$PM" in
    dig:brew|dig:pacman) echo bind ;;
    dig:apt-get) echo dnsutils ;;
    dig:dnf|dig:zypper) echo bind-utils ;;
    dig:pkg|dig:apk) echo bind-tools ;;
    python3:brew|python3:pacman) echo python ;;
    # A command, not a package: awk is virtual under apt and
    # absent by that name elsewhere, mktemp is part of coreutils.
    awk:brew) echo awk ;;
    awk:*) echo gawk ;;
    mktemp:*|base64:*) echo coreutils ;;
    ssh:apt-get|ssh-keygen:apt-get) echo openssh-client ;;
    ssh:dnf|ssh-keygen:dnf) echo openssh-clients ;;
    ssh:*|ssh-keygen:*) echo openssh ;;
    *) echo "$1" ;;
  esac
}

# hint "<tool> ..." — one install command for all of them.
hint() {
  pkgs=
  # shellcheck disable=SC2086 # one word per tool is the point
  for t in $1; do pkgs="$pkgs $(pkgname "$t")"; done
  [ -n "$pkgs" ] || { echo "see the README"; return; }
  case "$PM" in
    brew) echo "brew install$pkgs" ;;
    apt-get|dnf|zypper|pkg) echo "sudo $PM install$pkgs" ;;
    pacman) echo "sudo pacman -S$pkgs" ;;
    apk) echo "sudo apk add$pkgs" ;;
    gitbash) echo "Git Bash cannot install$pkgs; WSL can (README → Windows)" ;;
    *) echo "install:$pkgs" ;;
  esac
}

# Per tier: the labels of what is missing, and the tools to name
# in its install hint. Features get one hint line each. A tool
# mise.dev.toml pins goes to MISE_T instead: no package manager
# has it under that name, mise does.
NEED='' NEED_T='' MISE_T='' WANT='' WANT_T='' FEAT=''
row() { [ -n "$QUIET" ] || echo "  $1"; }

miss() {
  case $1 in
    need) NEED="$NEED, $2"
      case " $MISE_TOOLS " in
        *" ${3:--} "*) MISE_T="$MISE_T $3" ;;
        *) NEED_T="$NEED_T $3" ;;
      esac ;;
    want) WANT="$WANT, $2" WANT_T="$WANT_T $3" ;;
    feat) FEAT="$FEAT
  $2: $(hint "$3")" ;;
  esac
}

# probe <tier> <label> <hint-tool> <command...> -- one row, and a
# miss when the command fails.
probe() {
  tier=$1 label=$2 tool=$3
  shift 3
  if "$@" >/dev/null 2>&1; then
    row "ok       $label"
  else
    row "missing  $label"
    miss "$tier" "$label" "$tool"
  fi
}

any() { for t in "$@"; do has "$t" && return 0; done; return 1; }

# Every call shares one connection (AGENTS.md → SSH Options).
# -G parses the options and connects to nothing; -F /dev/null
# leaves the user's config, and any Match exec in it, out.
ssh_shares() {
  ssh -F /dev/null -G -o ControlMaster=auto \
    -o "ControlPath=$HOME/.cache/hostwarden/ssh-%C" \
    -o ControlPersist=10m example.invalid
}

# .claude/skills and every DNS alias are links, and Git Bash copies
# where it should link unless MSYS says otherwise (README →
# Windows). Probed in the clone: a temporary directory can sit on
# a filesystem that links when this one does not.
links_work() {
  d=$(mktemp -d "$ROOT/.link-probe.XXXXXX") || return 1
  ln -s "$d" "$d/l" 2>/dev/null
  [ -L "$d/l" ]
  rc=$?
  rm -rf "$d"
  return $rc
}

# The transport 5L.1 accepts. macOS ships a sendmail that delivers
# only while its Postfix is loaded.
mail_ok() {
  has msmtp && return 0
  has sendmail || return 1
  [ "$OS" = Darwin ] || return 0
  launchctl print system/com.apple.postfix.master
}

attach_ok() { has file && has base64; }

[ -n "$QUIET" ] || echo "Required"
for t in ssh git awk sed grep tar mktemp; do
  probe need "$t" "$t" has "$t"
done
has ssh && probe need "ssh connection sharing (OpenSSH 6.8+)" ssh ssh_shares
probe need "symbolic links (README → Windows)" "" links_work

if [ -n "$DEV" ]; then
  [ -n "$QUIET" ] || echo "Development"
  # What scripts/check.sh runs: python3, and what mise.dev.toml pins.
  for t in python3 $MISE_TOOLS; do
    probe need "$t" "$t" has "$t"
  done
else
  [ -n "$QUIET" ] || echo "Recommended"
  # Without it the guard reads the raw hook input and over-blocks
  # (.claude/hooks/guard-taboos.sh).
  probe want jq jq has jq
  # The ones rules/dns-aliases.md tries; any one resolves.
  probe want "hostname resolver" python3 any getent dscacheutil python3 dig

  [ -n "$QUIET" ] || echo "Per feature"
  # rules/ssh-connections.md, rules/directory-copy.md
  probe feat "file transfer to and from servers" rsync any rsync scp
  # hostwarden-email: transport-local.md step 5L.1, send-verify.md
  probe feat "email from this workstation" msmtp mail_ok
  att=''
  has file || att='file'
  has base64 || att="$att base64"
  probe feat "email attachments from this workstation" "$att" attach_ok
  # hostwarden-deploy-user: references/ssh-key.md
  probe feat "SSH keys for a deploy user" ssh-keygen has ssh-keygen
  # rules/ssh-unreachable.md
  probe feat "reachability checks when SSH fails" curl has curl
fi

[ -n "$QUIET" ] || echo
if [ -n "$NEED" ]; then
  fix=''
  [ -z "$NEED_T" ] || fix=$(hint "$NEED_T")
  [ -z "$MISE_T" ] \
    || fix="${fix:+$fix; }mise trust mise.dev.toml && MISE_ENV=dev mise install"
  echo "hostwarden: required, missing: ${NEED#, } — $fix"
fi
if [ -n "$WANT" ]; then
  echo "hostwarden: recommended, missing: ${WANT#, } — $(hint "$WANT_T")"
fi
if [ -n "$FEAT" ]; then
  echo "hostwarden: not available on this workstation:$FEAT"
fi
if [ -z "$QUIET$NEED$WANT$FEAT" ]; then
  echo "Everything hostwarden runs locally is here."
fi

# --quiet reports and exits 0: Claude Code passes a SessionStart
# hook's output on only then, and a caller that needs a verdict
# reads whether anything was printed.
[ -n "$QUIET" ] || [ -z "$NEED" ]
