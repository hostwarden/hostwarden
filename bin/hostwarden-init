#!/bin/sh
# hostwarden-init — turn this checkout into an operations
# install: memory/ becomes a git repository of its own,
# marked as the workspace.
#
# Usage:
#   hostwarden-init              Create the workspace. Run in a
#                                terminal on a new one, it asks
#                                whether to share it, and how
#   hostwarden-init --clone URL  Join a team: clone its shared
#                                workspace into an empty memory/,
#                                or in place of a new workspace
#                                nothing has been written to yet
#   hostwarden-init --remote URL [--create]
#                                Share this workspace: refuse a
#                                public or non-empty URL, create a
#                                missing GitHub one private with gh
#                                where --create asks for that, then
#                                commit the workspace and push it
#   hostwarden-init --local      Record in memory/user.md that the
#                                workspace stays on this machine
#   hostwarden-init --help       Show this help
#
# Idempotent: on a workspace it fills in whatever is
# missing and changes nothing else.
#
# Solo use needs nothing more. A team, or one admin on
# several machines, shares the workspace by giving memory/
# a private remote; bin/hostwarden-sync keeps it in step.
# The files that are always personal are ignored there
# already.
set -e

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_DIR"
# shellcheck source=../lib/mode.sh
. lib/mode.sh

usage() {
  awk 'NR == 1 { next } /^[^#]/ { exit } { sub(/^# ?/, ""); print }' \
    "$SCRIPT_DIR/${0##*/}"
}

CLONE="" REMOTE="" CREATE="" LOCAL=""
while [ $# -gt 0 ]; do
  case "$1" in
    --clone) CLONE="${2:?Usage: hostwarden-init --clone URL}"; shift ;;
    --remote) REMOTE="${2:?Usage: hostwarden-init --remote URL}"; shift ;;
    --create) CREATE=1 ;;
    --local) LOCAL=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
  shift
done
case "$CLONE$REMOTE" in -*)
  echo "hostwarden-init: a URL cannot start with a dash." >&2; exit 1 ;;
esac
# One way to share at most, and --create only with --remote.
case "${CLONE:+c}${REMOTE:+r}${LOCAL:+l}" in ??*) usage >&2; exit 1 ;; esac
if [ -n "$CREATE" ] && [ -z "$REMOTE" ]; then usage >&2; exit 1; fi

hostwarden_mode "$REPO_DIR"
WAS=$HOSTWARDEN_MODE
if [ "$WAS" = worktree ]; then
  echo "hostwarden-init: this is a linked git worktree, which never" >&2
  echo "  carries memory/. Run this in the main checkout." >&2
  exit 1
fi
if [ ! -d .git ]; then
  echo "hostwarden-init: this is not a git clone (an archive" >&2
  echo "  download?). An operations install has to be able to" >&2
  echo "  update, so clone the repository and run this there." >&2
  exit 1
fi

# check_hooks <dir> — whether git will run the secret scan in the
# repository <dir>. It will not when core.hooksPath sends it
# elsewhere (unless that is <dir>/.git/hooks itself, which is also
# how a global setting is overridden for one repository), and ours
# cannot go where a hook of the user's own already sits. Checked
# before anything marks a directory as the workspace, rather than
# leave one that looks scanned and is not.
check_hooks() {
  mkdir -p "$1/.git/hooks"
  hp=$(git -C "$1" config core.hooksPath || true)
  if [ -n "$hp" ]; then
    case "$hp" in /*) ;; *) hp="$1/$hp" ;; esac
    if [ "$(cd "$hp" 2>/dev/null && pwd -P)" != \
         "$(cd "$1/.git/hooks" && pwd -P)" ]; then
      echo "hostwarden-init: core.hooksPath sends git elsewhere, so it would" >&2
      echo "  not run the workspace's secret scan. Point it at the" >&2
      echo "  workspace's own hooks and run this again:" >&2
      echo "    git -C memory config core.hooksPath .git/hooks" >&2
      return 1
    fi
  fi
  for h in pre-commit pre-push; do
    if [ -e "$1/.git/hooks/$h" ] &&
       ! grep -q 'Installed by bin/hostwarden-init' "$1/.git/hooks/$h"; then
      echo "hostwarden-init: memory/.git/hooks/$h is a hook of your own," >&2
      echo "  and the workspace needs its secret scan there. Move it" >&2
      echo "  aside, run this again, then call yours from the new one." >&2
      return 1
    fi
  done
}

# pristine — memory/ is a workspace nothing has been written to:
# no commit, and no file but the ones init puts there, unchanged,
# the ssh_config it writes and the personal user.md, which a clone
# carries across. Only such a one makes way for a clone; anything
# more is somebody's work.
pristine() {
  [ -d memory/.git ] || return 1
  if git -C memory rev-parse -q --verify HEAD >/dev/null; then return 1; fi
  find memory -path memory/.git -prune -o ! -type d -print |
    while IFS= read -r f; do
      case ${f#memory/} in ssh_config|user.md) continue ;; esac
      cmp -s "$f" "templates/workspace/${f#memory/}" || echo "$f"
    done | grep -q . && return 1
  return 0
}

# github_slug <url> — owner/repo of a github.com URL, or nothing.
github_slug() {
  printf '%s\n' "$1" | sed -n -E \
    's#^(https://|ssh://)?([^@/]+@)?github\.com[:/]([^/]+/[^/]+)$#\3#p' |
    sed 's#\.git$##; s#/$##'
}

# anon_url <url> — where anyone could read <url> without a
# credential: its https address, with any user or token taken out.
# git:// is anonymous by design and stays as it is. A path on this
# machine or a mount gives nothing: nobody else reaches it.
anon_url() {
  case $1 in
  git://*) printf '%s\n' "$1" ;;
  http://*|https://*) printf '%s\n' "$1" | sed -E 's#^(https?://)[^/@]*@#\1#' ;;
  ssh://*) printf '%s\n' "$1" |
    sed -E 's#^ssh://([^/@]*@)?([^/:]+)(:[0-9]+)?/#https://\2/#' ;;
  /*|./*|../*|file://*) ;;
  *:*) printf '%s\n' "$1" | sed -E 's#^([^@:/]*@)?([^:/]+):/?#https://\2/#' ;;
  esac
}

# readable_anonymously <url> — git can list <url> with nothing of
# the user's: no configuration, credential helper, .netrc or prompt.
# Then anyone can, and the repository is public.
readable_anonymously() {
  ra_home=$(mktemp -d) || return 1
  if (unset GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS GIT_SSH_COMMAND
      HOME=$ra_home XDG_CONFIG_HOME=$ra_home GIT_CONFIG_NOSYSTEM=1 \
      GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0 \
      GIT_ASKPASS=false SSH_ASKPASS=false \
      git -c credential.helper= -c http.lowSpeedLimit=1 \
        -c http.lowSpeedTime=20 ls-remote -- "$1" >/dev/null 2>&1); then
    rm -rf "$ra_home"; return 0
  fi
  rm -rf "$ra_home"; return 1
}

# suggest_url — the address the question below offers for a new
# workspace: hostwarden-workspace under the account gh is signed in
# to, in the protocol gh clones with, or nothing.
suggest_url() {
  command -v gh >/dev/null 2>&1 || return 0
  su_login=$(gh api user --jq .login 2>/dev/null) || return 0
  [ -n "$su_login" ] || return 0
  su_host=github.com
  if [ "$(gh config get git_protocol -h "$su_host" 2>/dev/null)" = ssh ]; then
    echo "git@$su_host:$su_login/hostwarden-workspace.git"
  else
    echo "https://$su_host/$su_login/hostwarden-workspace.git"
  fi
}

# Asked in a terminal, of a new workspace only: a checkout that
# already operates keeps what it has, and a script or a session
# that runs init is asked nothing. What this leaves open, the first
# session asks (rules/session-start.md → The workspace remote).
if [ -z "$CLONE$REMOTE$LOCAL" ] && [ "$WAS" != operations ] \
    && [ -t 0 ] && [ -t 1 ]; then
  echo "Share the workspace through a private git remote? It will hold"
  echo "hostnames, addresses and the layout of your network."
  echo "  1) Join an existing workspace: clone it"
  echo "  2) Publish this new one to a private, empty repository,"
  echo "     created with gh on GitHub where it does not exist yet"
  echo "  3) Keep it on this machine only"
  echo "  4) Decide later: the first session asks again"
  printf 'Choice [4]: '
  read -r ans || ans=
  case $ans in
  1)
    printf 'URL of the workspace: '
    read -r CLONE || CLONE= ;;
  2)
    s=$(suggest_url)
    printf 'URL of the repository%s: ' "${s:+ [$s]}"
    read -r REMOTE || REMOTE=
    REMOTE=${REMOTE:-$s}
    CREATE=1 ;;
  3) LOCAL=1 ;;
  esac
  case "$CLONE$REMOTE" in -*)
    echo "hostwarden-init: a URL cannot start with a dash." >&2; exit 1 ;;
  esac
fi

if [ -n "$CLONE" ]; then
  # The staging directory is ours only once this run made it. One
  # already there is not ignored by git, so it may well be the
  # user's, and deleting it unasked is not a step to take.
  if [ -e memory.clone ] || [ -L memory.clone ]; then
    echo "hostwarden-init: memory.clone/ is in the way; --clone clones" >&2
    echo "  into it first. Move it aside or delete it, then run this again." >&2
    exit 1
  fi
  # rmdir succeeds on an empty directory only.
  REPLACE=""
  if [ -e memory ] && ! rmdir memory 2>/dev/null; then
    if pristine; then REPLACE=1
    else
      echo "hostwarden-init: memory/ already holds work. --clone needs an" >&2
      echo "  empty one, or a new workspace nothing has been written to;" >&2
      echo "  move the existing state aside first." >&2
      exit 1
    fi
  fi
  # The clone brings the workspace marker, so it only becomes
  # memory/ once it has passed the checks.
  hostwarden_git_batch
  git clone --quiet -- "$CLONE" memory.clone
  if ! check_hooks memory.clone; then
    rm -rf memory.clone
    echo "  (nothing was kept; clone again after that)" >&2
    exit 1
  fi
  if [ -n "$REPLACE" ]; then
    # user.md is personal, so the clone has none: this machine's
    # answers stay.
    if [ -f memory/user.md ] && [ ! -e memory.clone/user.md ]; then
      cp -p memory/user.md memory.clone/
    fi
    rm -rf memory
  fi
  mv memory.clone memory
  # DNS aliases are symlinks under memory/machines/. A clone that
  # cannot make links turns each into a text file, and alias
  # resolution stops working without a word.
  if [ "$(git -C memory config --bool core.symlinks)" = false ]; then
    echo "hostwarden: git made no symlinks in memory/, so DNS aliases"
    echo "  arrive as text files. See"
    echo "  https://hostwarden.github.io/docs/getting-started/install#symbolic-links,"
    echo "  then clone again."
  fi
  a=$(anon_url "$CLONE")
  if [ -n "$a" ] && readable_anonymously "$a"; then
    echo "hostwarden: WARNING — $CLONE is public: anyone can read the"
    echo "  hostnames, addresses and network layout it holds. Make it"
    echo "  private now."
  else
    echo "hostwarden: keep this remote private — the workspace holds"
    echo "  hostnames, addresses and the layout of your network."
  fi
fi

# Every step only fills in what is missing, so running this on
# a workspace repairs it and changes nothing else.
mkdir -p memory/machines memory/custom-rules
[ -e memory/.git ] || {
  git -C memory init --quiet
  git -C memory symbolic-ref HEAD refs/heads/main
}
check_hooks memory || exit 1

# templates/workspace/ holds exactly the files a workspace
# starts with; bin/hostwarden-backup reads the same list.
for f in templates/workspace/.[!.]* templates/workspace/*; do
  [ -f "$f" ] || continue
  [ -e "memory/${f##*/}" ] || cp "$f" memory/
done

# Keep a secret out of every commit the workspace makes. The
# hook lives in the workspace's own .git, so each clone gets
# it from here rather than from the remote.
HOOK=memory/.git/hooks/pre-commit
if [ ! -e "$HOOK" ]; then
  cat > "$HOOK" <<'EOF'
#!/bin/sh
# Installed by bin/hostwarden-init: scan what is about to be
# committed for secrets (rules/secrets.md).
if command -v betterleaks >/dev/null 2>&1; then
  exec betterleaks git --pre-commit --staged --redact --verbose \
    --no-banner .
fi
# Without a remote nothing leaves this machine, so a warning
# will do. With one, an unscanned commit could be pushed.
if [ -n "$(git remote)" ]; then
  echo "hostwarden: betterleaks is not installed, and this workspace" >&2
  echo "  has a remote — commit refused unscanned. Install it" >&2
  echo "  (https://github.com/betterleaks/betterleaks) and retry." >&2
  exit 1
fi
echo "hostwarden: betterleaks is not installed, so this workspace" >&2
echo "  commit was not scanned for secrets." >&2
EOF
  chmod +x "$HOOK"
fi
# A commit made before the remote existed was only warned about,
# so the push scans again, and never goes out unscanned.
HOOK=memory/.git/hooks/pre-push
if [ ! -e "$HOOK" ]; then
  cat > "$HOOK" <<'EOF'
#!/bin/sh
# Installed by bin/hostwarden-init: scan the workspace's history
# for secrets before anything leaves this machine.
if ! command -v betterleaks >/dev/null 2>&1; then
  echo "hostwarden: betterleaks is not installed — push refused" >&2
  echo "  unscanned. Install it" >&2
  echo "  (https://github.com/betterleaks/betterleaks) and retry." >&2
  exit 1
fi
exec betterleaks git --redact --verbose --no-banner .
EOF
  chmod +x "$HOOK"
fi

# The file every SSH call passes with -F (AGENTS.md → SSH
# Options), now that memory/ is the workspace it lives in.
sh bin/hostwarden-ssh-config || true

if [ "$WAS" = operations ]; then
  echo "hostwarden: memory/ is already the workspace"
else
  echo "hostwarden: memory/ is now the workspace — this checkout operates servers"
fi

# publish <url> — give the workspace <url> as its remote, commit it
# and push it. Refused: a remote of another address already there,
# a public repository, one that already holds commits (that is a
# workspace to join, with --clone). A missing one is created private
# where --create asks for it and gh can; otherwise the steps to
# create it are printed, and it returns 3. Run again after a
# failure, it picks up where it stopped.
publish() {
  url=$1
  cur=$(git -C memory remote get-url origin 2>/dev/null) || cur=
  if [ -n "$cur" ] && [ "$cur" != "$url" ]; then
    echo "hostwarden-init: memory/ already syncs with $cur." >&2
    return 1
  fi
  # The hooks refuse a commit and a push unscanned once there is a
  # remote; saying so first leaves nothing half done.
  if ! command -v betterleaks >/dev/null 2>&1; then
    echo "hostwarden-init: betterleaks is not installed, and nothing leaves" >&2
    echo "  this machine unscanned. Install it" >&2
    echo "  (https://github.com/betterleaks/betterleaks) and run this again." >&2
    return 1
  fi
  hostwarden_git_batch memory

  # gh knows GitHub's answer, a repository that does not exist yet
  # included. Anywhere else, a read without any credential is the
  # test: what anyone can list is public.
  slug=$(github_slug "$url")
  vis=
  if [ -n "$slug" ] && command -v gh >/dev/null 2>&1 \
      && gh auth status --hostname github.com >/dev/null 2>&1; then
    vis=$(gh repo view "$slug" --json visibility --jq .visibility \
      2>/dev/null) || vis=missing
  fi
  anon=$(anon_url "$url")
  if [ "$vis" = PUBLIC ] || { [ -z "$vis" ] && [ -n "$anon" ] \
      && readable_anonymously "$anon"; }; then
    echo "hostwarden-init: $url is public: anyone can read it, and the" >&2
    echo "  workspace holds hostnames, addresses and the layout of your" >&2
    echo "  network. Make it private or choose another, then run this again." >&2
    return 1
  fi
  if [ "$vis" = INTERNAL ]; then
    echo "hostwarden: $slug is internal: every member of its GitHub"
    echo "  enterprise can read it."
  fi

  if [ -z "$cur" ]; then
    if [ "$vis" != missing ] && refs=$(git ls-remote -- "$url" 2>&1); then
      if [ -n "$refs" ]; then
        echo "hostwarden-init: $url already holds commits. To join the" >&2
        echo "  workspace in it, use --clone; to publish this one, give an" >&2
        echo "  empty repository." >&2
        return 1
      fi
    elif [ "$vis" = missing ] && [ -n "$CREATE" ]; then
      gh repo create "$slug" --private \
        --description "Hostwarden workspace" >/dev/null || return 1
      echo "hostwarden: created $slug on GitHub, private"
    elif [ -n "$vis" ] && [ "$vis" != missing ]; then
      echo "hostwarden-init: $slug exists, but git cannot reach it:" >&2
      printf '%s\n' "$refs" | sed 's/^/  /' >&2
      return 1
    else
      echo "hostwarden-init: $url does not exist, or git cannot reach it" >&2
      echo "  with your credentials. Create it private and empty — no README," >&2
      echo "  licence or .gitignore — then run this again:" >&2
      if [ -n "$slug" ]; then
        echo "    gh repo create $slug --private" >&2
        echo "  or https://github.com/new, Visibility: Private." >&2
      else
        echo "  in your git host's web interface, visibility private, or on" >&2
        echo "  a server of your own: git init --bare <path>." >&2
      fi
      return 3
    fi
    git -C memory remote add origin "$url" || return 1
  fi
  sh "$SCRIPT_DIR/hostwarden-sync" commit "Start the shared workspace" \
    || return 1
  branch=$(git -C memory symbolic-ref --short HEAD) || return 1
  git -C memory push --quiet -u origin "$branch" || return 1
  echo "hostwarden: memory/ now syncs with $url"
}

if [ -n "$REMOTE" ]; then
  publish "$REMOTE" || exit $?
fi

# Workspace remote: none, under # Preferences in the personal
# user.md, is the answer that keeps init and the session start
# from asking again.
if [ -n "$LOCAL" ]; then
  if [ -n "$(git -C memory remote)" ]; then
    echo "hostwarden-init: memory/ already has a remote." >&2
    exit 1
  fi
  U=memory/user.md
  if grep -q '^Workspace remote:' "$U" 2>/dev/null; then
    awk '/^Workspace remote:/ { print "Workspace remote: none"; next }
      { print }' "$U" > "$U.tmp"
  elif grep -q '^# Preferences[[:space:]]*$' "$U" 2>/dev/null; then
    awk '{ print }
      /^# Preferences[[:space:]]*$/ && !d { print ""; print "Workspace remote: none"; d = 1 }' \
      "$U" > "$U.tmp"
  else
    { if [ -s "$U" ]; then cat "$U"; echo; fi
      printf '# Preferences\n\nWorkspace remote: none\n'; } > "$U.tmp"
  fi
  mv "$U.tmp" "$U"
  echo "hostwarden: the workspace stays on this machine (memory/user.md)"
fi
