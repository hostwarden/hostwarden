#!/bin/sh
# hostwarden-update — update, pin, or check Hostwarden version.
#
# Usage:
#   hostwarden-update               Update: move to the newest
#                                   release on the line this
#                                   checkout follows, or pull main
#   hostwarden-update --check       Show current version and
#                                   check for updates
#   hostwarden-update --follow L    Follow release line L: 1 for
#                                   every 1.x.y, 1.2 for 1.2.x
#                                   only; the auto-update moves on
#   hostwarden-update --pin VER     Pin to a version tag
#                                   (e.g. --pin v0.1.0)
#   hostwarden-update --unpin       Follow main: return to it,
#                                   pull, and stay there
#   hostwarden-update --help        Show this help
#
# A checkout on main that never chose follows main until a
# release exists, then the major line of the newest release.
# An operations checkout checks a release tag out only once its
# signature verifies against the release key of the version it is
# on.
set -e

# Find the repo root (this script lives in bin/).
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_DIR"

current_version() {
  if [ -f VERSION ]; then
    cat VERSION
  else
    echo "unknown"
  fi
}

# Bring an older state layout up to date. Idempotent and silent
# when there's nothing to do.
run_migration() {
  if [ -f bin/hostwarden-migrate ]; then sh bin/hostwarden-migrate; fi
}

# report <old version> <old HEAD> — what the update did, once it
# is done.
report() {
  NEW=$(current_version)
  if [ "$1" = "$NEW" ]; then
    if [ "$2" = "$(git rev-parse HEAD)" ]; then
      echo "hostwarden $NEW — already up to date."
    else
      echo "hostwarden $NEW — updated to $(git rev-parse --short HEAD)."
    fi
    return
  fi
  echo "hostwarden updated: $1 -> $NEW"
  show_changelog_section "$NEW"
  if [ "${1%%.*}" != "${NEW%%.*}" ]; then
    echo ""
    echo "BREAKING CHANGES — read CHANGELOG.md"
  fi
}

show_changelog_section() {
  VER="$1"
  # Match the version heading exactly ("## 2.8.0"
  # must not also match "## 2.8.0-rc1"): compare
  # the whole second field, not a prefix.
  if [ -f CHANGELOG.md ]; then
    awk -v ver="$VER" '
      /^## / { if (insec) exit; insec = ($2 == ver); next }
      insec && NF { print }
    ' CHANGELOG.md
  fi
}

# notes <rev> — every entry no release has yet at <rev>: the
# fragments in changelog.d/ and a `## Unreleased` section of
# CHANGELOG.md (.claude/rules/repo-release.md → CHANGELOG.md). One
# line each: section, lead clause, the whole entry, tab-separated.
notes() {
  {
    git show "$1:CHANGELOG.md" 2>/dev/null |
      awk '/^## / { on = ($0 == "## Unreleased"); next } on'
    for f in $(git ls-tree --name-only "$1" changelog.d/ 2>/dev/null); do
      case $f in
      changelog.d/*.md) echo; git show "$1:$f" ;;
      esac
    done
  } | awk '
    function flush(   i) {
      if (buf != "" && (i = index(buf, "**")))
        print sec "\t" substr(buf, 1, i - 1) "\t" buf
      buf = ""
    }
    !NF { flush(); next }
    /^#+ / { flush(); sec = $0; sub(/^#+ /, "", sec); next }
    /^- \*\*/ { flush(); buf = substr($0, 5); next }
    buf != "" { t = $0; sub(/^[ \t]+/, "", t); buf = buf " " t }
    END { flush() }
  '
}

# news <old HEAD> — how the entries no release has yet changed
# since <old HEAD>: each new or changed one by its lead clause, and
# each one no longer listed — withdrawn, reworded under another
# lead, or only on the branch left behind. A release folds them all
# away, and its own notes say what it brought, so across a release
# nothing is called that.
news() {
  NEWS_TMP=$(mktemp -d "${TMPDIR:-/tmp}/hostwarden-news.XXXXXX")
  notes "$1" > "$NEWS_TMP/old"
  notes HEAD > "$NEWS_TMP/new"
  GONE=
  [ "$(git show "$1:VERSION" 2>/dev/null)" != "$(current_version)" ] \
    || GONE=1
  awk -F '\t' -v gone="$GONE" '
    FILENAME == ARGV[1] { old[$2] = $3; next }
    { seen[$2] = 1
      if (!($2 in old)) out = out "  " $1 ": " $2 "\n"
      else if (old[$2] != $3) out = out "  " $1 ": " $2 " (changed)\n"
    }
    END {
      if (gone) for (l in old) if (!(l in seen))
        out = out "  no longer listed: " l "\n"
      if (out != "") printf "\nOn main, not released yet:\n%s", out
    }
  ' "$NEWS_TMP/old" "$NEWS_TMP/new"
  rm -rf "$NEWS_TMP"
}

usage() {
  awk 'NR == 1 { next } /^[^#]/ { exit } { sub(/^# ?/, ""); print }' \
    "$SCRIPT_DIR/${0##*/}"
}

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
esac

# Without git every git call below fails and --check would report
# a detached HEAD: the wrong cause.
if ! command -v git >/dev/null 2>&1; then
  echo "hostwarden-update: git is not installed" >&2
  exit 1
fi
# shellcheck source=../lib/follow.sh
. lib/follow.sh
# shellcheck source=../lib/mode.sh
. lib/mode.sh
if ! hostwarden_clone_top; then
  echo "hostwarden-update: this is not a git clone (an archive" \
    "download?); clone the repository to get updates" >&2
  exit 1
fi
FOLLOW=$(hostwarden_follow)
hostwarden_mode "$REPO_DIR"

# The release key an operations checkout trusts: the
# .github/release-signers of the commit it is on, copied outside
# the working tree before anything is fetched. Never the file of the
# tag being checked: whoever serves a forged tag serves its key too
# (docs/adr/20260926-release-key-from-the-checked-out-version.md).
# trust_head — take the file of the commit checked out: at the start,
# and after each checkout of a tag that verified.
trust_head() {
  [ -z "$SIGNERS" ] || git show HEAD:.github/release-signers \
    > "$SIGNERS" 2>/dev/null || : > "$SIGNERS"
}
SIGNERS=
if [ "$HOSTWARDEN_MODE" = operations ]; then
  SIGNERS=$(mktemp "${TMPDIR:-/tmp}/hostwarden-signers.XXXXXX")
  trap 'rm -f "$SIGNERS" "$SIGNERS.chain" "$SIGNERS.next"' EXIT
  trap 'exit 1' INT TERM
  trust_head
fi

# signed_by <tag> <allowed signers> — true when <tag> is an annotated
# tag of that name signed by a key the file lists; sets WHY
# otherwise. A signed tag object of another release, under this
# name, would verify too, hence the name.
signed_by() {
  if [ "$(git for-each-ref --format='%(objecttype) %(tag)' \
    "refs/tags/$1")" != "tag $1" ]; then
    WHY="it is no annotated tag named $1"
    return 1
  fi
  # A key the file lists is trusted fully; a gpg.minTrustLevel of
  # the user's own must not let an unlisted one pass.
  if ! WHY=$(git -c gpg.ssh.allowedSignersFile="$2" \
    -c gpg.minTrustLevel=fully verify-tag "$1" 2>&1); then
    WHY="its signature does not verify against the release key this
  checkout trusts:
$(printf '%s\n' "$WHY" | sed 's/^/    /')
  Compare .github/release-signers with the release key on the
  updates page (Release signatures)."
    return 1
  fi
}

# verify_tag <tag> — true when <tag> verifies against the key this
# checkout trusts; sets WHY otherwise. Always true in a development
# checkout, which is not verified.
#
# Every release between the checkout and <tag> that verifies hands
# its own file on to the next, so a new key, listed by a release the
# old key signed, is trusted from there on although the update
# skips that release (.claude/rules/repo-release.md → VERSION).
verify_tag() {
  [ -n "$SIGNERS" ] || return 0
  if [ ! -s "$SIGNERS" ]; then
    WHY="this checkout has no .github/release-signers to check it with"
    return 1
  fi
  if ! hostwarden_follow_can_verify; then
    WHY="this machine cannot verify a signature: that needs git 2.34
  and OpenSSH 8.7 or later (bin/hostwarden-doctor)"
    return 1
  fi
  cp "$SIGNERS" "$SIGNERS.chain"
  for vt in $(git tag -l 'v*' --merged "$1" --no-merged HEAD \
    --sort=v:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$'); do
    [ "$vt" != "$1" ] && signed_by "$vt" "$SIGNERS.chain" &&
      git show "$vt:.github/release-signers" > "$SIGNERS.next" \
        2>/dev/null && mv "$SIGNERS.next" "$SIGNERS.chain" || :
  done
  signed_by "$1" "$SIGNERS.chain"
}

# checkout_tag <tag> — the one way a release tag is checked out:
# verified first, and nothing moves when it does not verify.
checkout_tag() {
  if ! verify_tag "$1"; then
    echo "hostwarden update refused: $1 — $WHY"
    echo "  Nothing was checked out."
    exit 1
  fi
  if ! OUTPUT=$(git checkout --quiet "$1" 2>&1); then
    echo "hostwarden update failed: $OUTPUT"
    echo "Likely cause: local changes (run 'git status')."
    exit 1
  fi
  trust_head
}

# follow_target <line> — sets TAG to the newest release on the
# line, from origin; exits when there is none to be had.
follow_target() {
  if ! OUTPUT=$(hostwarden_follow_fetch 2>&1); then
    echo "hostwarden update failed: $OUTPUT"
    exit 1
  fi
  TAG=$(hostwarden_follow_tag "$1")
  if [ -z "$TAG" ]; then
    echo "Error: no release v$1.x on origin."
    echo "Newest tags:"
    git tag --sort=-v:refname | head -10
    exit 1
  fi
}

# need_arg <value> <usage> — an option's argument, or the usage. Not
# ${2:?}: under set -e with an EXIT trap, bash 3.2 as macOS /bin/sh
# exits 0 on that error.
need_arg() {
  [ -n "$1" ] && return
  echo "Usage: hostwarden-update $2" >&2
  exit 1
}

# pull_failed — why main could not move; $OUTPUT is git's own word.
pull_failed() {
  echo "hostwarden update failed: $OUTPUT"
  echo "Likely causes: local changes (run 'git status',"
  echo "stash them with 'git stash'), local commits on a"
  echo "diverged main, or no network. Fix and re-run."
  exit 1
}

at_tag() { [ "$(git rev-parse HEAD)" = "$(git rev-parse "$1^{commit}")" ]; }

# on_tag <tag> — true when the checkout needs no checkout to be at
# <tag>. On a branch it checks out, and so verifies, even when the
# branch is at the tag already, or the line would look like a
# checkout of main. The update and --check both decide by this.
on_tag() { at_tag "$1" && ! git symbolic-ref -q HEAD >/dev/null; }

# settle_line — the release line an operations checkout that never
# chose settles on, or nothing. A development checkout stays where
# its developer put it.
settle_line() {
  [ "$HOSTWARDEN_MODE" != operations ] || hostwarden_follow_default
}

# line_notice <line> — says so when the newest release is on
# another line: only the newest release gets fixes (SECURITY.md),
# and a line never moves past itself. The line it names is of the
# same kind: a major for a major, a major.minor for a major.minor.
line_notice() {
  NEWEST=$(hostwarden_follow_tag '[0-9]*')
  [ -n "$NEWEST" ] && [ "$NEWEST" != "$(hostwarden_follow_tag "$1")" ] \
    || return 0
  NEXT=${NEWEST#v}
  case $1 in
  *.*) NEXT=${NEXT%.*} ;;
  *) NEXT=${NEXT%%.*} ;;
  esac
  echo "hostwarden: $NEWEST is out, and line $1 gets no more fixes."
  if ! verify_tag "$NEWEST"; then
    echo "  An update refuses it: $WHY"
    return 0
  fi
  echo "  Read what it changes, 'git show $NEWEST:CHANGELOG.md', then"
  echo "  'hostwarden-update --follow $NEXT'."
}

# follow_update <line> [set] — check out the newest release on the
# line; with set, record the line as soon as the checkout is on it,
# before anything after that can fail and leave the tag looking
# like a pin.
# OLD_VERSION and OLD_HEAD, where the caller set them, are what the
# report starts from.
follow_update() {
  follow_target "$1"
  OLD_VERSION=${OLD_VERSION:-$(current_version)}
  OLD_HEAD=${OLD_HEAD:-$(git rev-parse HEAD)}
  on_tag "$TAG" || checkout_tag "$TAG"
  [ -z "${2:-}" ] || hostwarden_follow_set "$1"
  run_migration
  report "$OLD_VERSION" "$OLD_HEAD"
  line_notice "$1"
}

case "${1:-}" in
  --check)
    echo "hostwarden $(current_version)"
    if [ -n "$FOLLOW" ]; then
      echo "Following $FOLLOW (the newest v$FOLLOW.x release)."
      follow_target "$FOLLOW"
      if on_tag "$TAG"; then
        echo "Up to date."
      elif verify_tag "$TAG"; then
        echo "$TAG is available."
      else
        echo "$TAG is out, and an update refuses it: $WHY"
      fi
      line_notice "$FOLLOW"
      exit 0
    fi
    BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || true)
    if [ -z "$BRANCH" ]; then
      TAG=$(git describe --tags --exact-match 2>/dev/null || true)
      if [ -n "$TAG" ]; then
        echo "Pinned to $TAG"
      else
        echo "On detached HEAD"
      fi
      exit 0
    fi
    if [ "$BRANCH" != "main" ]; then
      echo "On branch '$BRANCH' (not main)"
      exit 0
    fi
    # Without a refspec the fetch brings the tags on main along.
    git fetch --quiet origin
    LINE=$(settle_line)
    if [ -n "$LINE" ]; then
      follow_target "$LINE"
      echo "The next update follows release line $LINE, at"
      echo "$TAG. 'hostwarden-update --unpin' follows main instead."
      verify_tag "$TAG" || echo "It refuses $TAG: $WHY"
      exit 0
    fi
    LOCAL=$(git rev-parse HEAD)
    REMOTE=$(git rev-parse origin/main)
    if [ "$LOCAL" = "$REMOTE" ]; then
      echo "Up to date."
    else
      AHEAD=$(git rev-list --count origin/main..HEAD)
      BEHIND=$(git rev-list --count HEAD..origin/main)
      [ "$BEHIND" -gt 0 ] && echo "$BEHIND commit(s) behind origin/main."
      [ "$AHEAD" -gt 0 ] && echo "$AHEAD commit(s) ahead of origin/main."
    fi
    ;;

  --follow)
    LINE=${2:-}
    need_arg "$LINE" "--follow LINE (e.g. 1 or 1.2)"
    if ! hostwarden_follow_valid "$LINE"; then
      echo "Error: '$LINE' is no release line: give a major (1)"
      echo "or a major.minor (1.2)."
      exit 1
    fi
    follow_update "$LINE" set
    echo "hostwarden follows $LINE: the auto-update moves to each"
    echo "new v$LINE.x release. 'hostwarden-update --unpin' follows"
    echo "main instead."
    ;;

  --pin)
    VER=${2:-}
    need_arg "$VER" "--pin VERSION (e.g. v2.0.0)"
    # Fresh/shallow clones may not have tags yet.
    # Fetch them before checking so --pin can reach
    # remote-only tags.
    git fetch --tags --quiet 2>/dev/null || true
    if ! git rev-parse "$VER" >/dev/null 2>&1; then
      echo "Error: tag '$VER' not found."
      echo "Available tags:"
      git tag --sort=-v:refname | head -10
      exit 1
    fi
    checkout_tag "$VER"
    # An exact version replaces a line.
    hostwarden_follow_clear
    echo "hostwarden pinned to $VER ($(current_version))"
    echo "Auto-update is disabled while pinned."
    echo "'hostwarden-update --follow' follows a release line"
    echo "again, 'hostwarden-update --unpin' follows main."
    ;;

  --unpin)
    OLD_HEAD=$(git rev-parse HEAD)
    git checkout main
    # Only once off the tag: a failed checkout keeps the line, or
    # the next session would take the tag for a pin. Recorded, not
    # cleared: a checkout on main that never chose moves to the
    # newest release line.
    hostwarden_follow_set main
    git pull --ff-only --quiet
    # Same as the default path: a pinned checkout can be many
    # releases behind, so this is exactly where an override
    # left at an obsolete path needs moving. Without it the
    # update succeeds and the override is silently dead.
    run_migration
    echo "hostwarden follows main ($(current_version))"
    news "$OLD_HEAD"
    ;;


  "")
    if [ -n "$FOLLOW" ]; then
      follow_update "$FOLLOW"
      exit 0
    fi
    # No line: pull main, then settle on a release line where this
    # checkout never chose and a release exists by now.
    BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || true)
    if [ -z "$BRANCH" ]; then
      echo "Error: not on a branch. Use --unpin first."
      exit 1
    fi
    if [ "$BRANCH" != "main" ]; then
      echo "Error: on branch '$BRANCH', not main."
      echo "Switch to main first or use --unpin."
      exit 1
    fi

    OLD_VERSION=$(current_version)
    OLD_HEAD=$(git rev-parse HEAD)
    # Capture a failure so set -e doesn't kill us with a raw git
    # error. Without a refspec the fetch brings the tags on main
    # along.
    if ! OUTPUT=$(git fetch --quiet origin 2>&1); then
      pull_failed
    fi
    # Before main moves: settling goes to the tag, or, refused,
    # leaves main where it was.
    LINE=$(settle_line)
    if [ -n "$LINE" ]; then
      follow_update "$LINE" set
      echo "hostwarden follows release line $LINE from now on."
      echo "'hostwarden-update --unpin' follows main instead."
      exit 0
    fi
    # --ff-only: never create a silent merge commit on a diverged
    # main.
    if ! OUTPUT=$(git merge --ff-only --quiet '@{upstream}' 2>&1); then
      pull_failed
    fi
    run_migration
    report "$OLD_VERSION" "$OLD_HEAD"
    news "$OLD_HEAD"
    ;;

  *)
    echo "Unknown option: $1"
    echo "Run 'hostwarden-update --help' for usage."
    exit 1
    ;;
esac
