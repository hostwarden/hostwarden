#!/bin/sh
# hostwarden-update — update, pin, or check hostwarden version.
#
# Usage:
#   hostwarden-update               Update: pull main, or move to
#                                the newest release on the line
#                                this checkout follows
#   hostwarden-update --check       Show current version and
#                                check for updates
#   hostwarden-update --follow L    Follow release line L, a major
#                                (1) or a major.minor (1.2)
#   hostwarden-update --pin VER     Pin to a version tag
#                                (e.g. --pin v0.1.0)
#   hostwarden-update --unpin       Return to main and pull
set -e

# Find the repo root (this script lives in bin/).
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_DIR"

current_version() {
  if [ -f VERSION ]; then
    cat VERSION
  else
    echo "unknown"
  fi
}

# Bring an older state layout up to date. Idempotent and silent
# when there's nothing to do.
run_migration() {
  if [ -f bin/hostwarden-migrate ]; then sh bin/hostwarden-migrate; fi
}

# report <old version> — what the update did, once it is done.
report() {
  NEW=$(current_version)
  if [ "$1" = "$NEW" ]; then
    echo "hostwarden $NEW — already up to date."
    return
  fi
  echo "hostwarden updated: $1 -> $NEW"
  show_changelog_section "$NEW"
  if [ "${1%%.*}" != "${NEW%%.*}" ]; then
    echo ""
    echo "BREAKING CHANGES — read CHANGELOG.md"
  fi
}

show_changelog_section() {
  VER="$1"
  # Match the version heading exactly ("## 2.8.0"
  # must not also match "## 2.8.0-rc1"): compare
  # the whole second field, not a prefix.
  if [ -f CHANGELOG.md ]; then
    awk -v ver="$VER" '
      /^## / { if (insec) exit; insec = ($2 == ver); next }
      insec && NF { print }
    ' CHANGELOG.md
  fi
}

case "${1:-}" in
  --help|-h)
    echo "Usage: hostwarden-update [--check|--follow L|--pin VER|--unpin]"
    echo ""
    echo "  (no args)    Pull latest from main, or move to the newest"
    echo "               release on the line this checkout follows"
    echo "  --check      Show version and update status"
    echo "  --follow L   Follow release line L: 1 for every 1.x.y,"
    echo "               1.2 for 1.2.x only; the auto-update moves on"
    echo "  --pin VER    Pin to a version tag (e.g. v0.1.0)"
    echo "  --unpin      Return to main and pull latest"
    exit 0 ;;
esac

# Without git, or outside a clone, every git call below fails and
# --check would report a detached HEAD: the wrong cause. The top
# of a clone, too, not merely inside one: unpacked into some other
# repository, git would pull that one.
if ! command -v git >/dev/null 2>&1; then
  echo "hostwarden-update: git is not installed" >&2
  exit 1
fi
# And a clone of hostwarden: unpacked at the top of some other
# checkout, the first test passes, but git does not track this
# script there.
if [ "$(git rev-parse --show-toplevel 2>/dev/null)" != "$(pwd -P)" ] \
    || ! git ls-files --error-unmatch bin/hostwarden-update \
      >/dev/null 2>&1; then
  echo "hostwarden-update: this is not a git clone (an archive" \
    "download?); clone the repository to get updates" >&2
  exit 1
fi

# shellcheck source=../.claude/hooks/follow.sh
. .claude/hooks/follow.sh
FOLLOW=$(hostwarden_follow)

# follow_update <line> — check out the newest release on the line.
follow_update() {
  if ! OUTPUT=$(hostwarden_follow_fetch 2>&1); then
    echo "hostwarden update failed: $OUTPUT"
    exit 1
  fi
  TAG=$(hostwarden_follow_tag "$1")
  if [ -z "$TAG" ]; then
    echo "Error: no release v$1.x on origin."
    echo "Newest tags:"
    git tag --sort=-v:refname | head -10
    exit 1
  fi
  OLD_VERSION=$(current_version)
  if [ "$(git rev-parse HEAD)" != "$(git rev-parse "$TAG^{commit}")" ] \
      && ! OUTPUT=$(git checkout --quiet "$TAG" 2>&1); then
    echo "hostwarden update failed: $OUTPUT"
    echo "Likely cause: local changes (run 'git status')."
    exit 1
  fi
  run_migration
  report "$OLD_VERSION"
}

case "${1:-}" in
  --check)
    echo "hostwarden $(current_version)"
    if [ -n "$FOLLOW" ]; then
      hostwarden_follow_fetch
      TAG=$(hostwarden_follow_tag "$FOLLOW")
      echo "Following $FOLLOW (the newest v$FOLLOW.x release)."
      if [ -z "$TAG" ]; then
        echo "No v$FOLLOW.x release on origin yet."
      elif [ "$(git rev-parse HEAD)" = "$(git rev-parse "$TAG^{commit}")" ]; then
        echo "Up to date."
      else
        echo "$TAG is available."
      fi
      exit 0
    fi
    BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || true)
    if [ -z "$BRANCH" ]; then
      TAG=$(git describe --tags --exact-match 2>/dev/null || true)
      if [ -n "$TAG" ]; then
        echo "Pinned to $TAG"
      else
        echo "On detached HEAD"
      fi
      exit 0
    fi
    if [ "$BRANCH" != "main" ]; then
      echo "On branch '$BRANCH' (not main)"
      exit 0
    fi
    git fetch --quiet origin main
    LOCAL=$(git rev-parse HEAD)
    REMOTE=$(git rev-parse origin/main)
    if [ "$LOCAL" = "$REMOTE" ]; then
      echo "Up to date."
    else
      AHEAD=$(git rev-list --count origin/main..HEAD)
      BEHIND=$(git rev-list --count HEAD..origin/main)
      [ "$BEHIND" -gt 0 ] && echo "$BEHIND commit(s) behind origin/main."
      [ "$AHEAD" -gt 0 ] && echo "$AHEAD commit(s) ahead of origin/main."
    fi
    ;;

  --follow)
    LINE="${2:?Usage: hostwarden-update --follow LINE (e.g. 1 or 1.2)}"
    if ! hostwarden_follow_valid "$LINE"; then
      echo "Error: '$LINE' is no release line: give a major (1)"
      echo "or a major.minor (1.2)."
      exit 1
    fi
    follow_update "$LINE"
    hostwarden_follow_set "$LINE"
    echo "hostwarden follows $LINE: the auto-update moves to each"
    echo "new v$LINE.x release. 'hostwarden-update --unpin' returns"
    echo "to main."
    ;;

  --pin)
    VER="${2:?Usage: hostwarden-update --pin VERSION (e.g. v2.0.0)}"
    # Fresh/shallow clones may not have tags yet.
    # Fetch them before checking so --pin can reach
    # remote-only tags.
    git fetch --tags --quiet 2>/dev/null || true
    if ! git rev-parse "$VER" >/dev/null 2>&1; then
      echo "Error: tag '$VER' not found."
      echo "Available tags:"
      git tag --sort=-v:refname | head -10
      exit 1
    fi
    git checkout "$VER"
    # An exact version replaces a line.
    hostwarden_follow_clear
    echo "hostwarden pinned to $VER ($(current_version))"
    echo "Auto-update is disabled while pinned."
    echo "Run 'hostwarden-update --unpin' to return to main."
    ;;

  --unpin)
    hostwarden_follow_clear
    git checkout main
    git pull --ff-only --quiet
    # Same as the default path: a pinned checkout can be many
    # releases behind, so this is exactly where an override
    # left at an obsolete path needs moving. Without it the
    # update succeeds and the customization is silently dead.
    run_migration
    echo "hostwarden unpinned — now on main ($(current_version))"
    ;;


  "")
    if [ -n "$FOLLOW" ]; then
      follow_update "$FOLLOW"
      exit 0
    fi
    # Default: pull latest.
    BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || true)
    if [ -z "$BRANCH" ]; then
      echo "Error: not on a branch. Use --unpin first."
      exit 1
    fi
    if [ "$BRANCH" != "main" ]; then
      echo "Error: on branch '$BRANCH', not main."
      echo "Switch to main first or use --unpin."
      exit 1
    fi

    OLD_VERSION=$(current_version)
    # --ff-only: never create a silent merge commit
    # on a diverged main. Capture the failure so
    # set -e doesn't kill us with a raw git error.
    if ! OUTPUT=$(git pull --ff-only --quiet 2>&1); then
      echo "hostwarden update failed: $OUTPUT"
      echo "Likely causes: local changes (run 'git status',"
      echo "stash them with 'git stash'), local commits on a"
      echo "diverged main, or no network. Fix and re-run."
      exit 1
    fi
    run_migration
    report "$OLD_VERSION"
    ;;

  *)
    echo "Unknown option: $1"
    echo "Run 'hostwarden-update --help' for usage."
    exit 1
    ;;
esac
