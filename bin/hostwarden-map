#!/bin/sh
# hostwarden-map — draw the infrastructure as Mermaid maps, and the
# workspace's overview page, computed from memory alone
# (rules/network-topology.md, rules/machine-memory.md,
# rules/hypervisors.md), never drawn or edited by hand.
#
# Usage:
#   hostwarden-map          Write every level under memory/maps/,
#                           and memory/README.md
#   hostwarden-map --help   Show this help
#
# Four levels, each a Markdown file with a Mermaid diagram first and
# a table of the full fields after it:
#   memory/maps/wan.md               sites, their gateways, the WAN
#                                     links between them
#   memory/maps/sites/<site>.md      the site's ranges and hosts
#   memory/maps/clusters/<name>.md   a cluster's members and guests
#   memory/maps/hosts/<hv>.md        a hypervisor's guests, for one
#                                     outside a cluster
#   memory/maps/README.md            the index, one line per map
#
# memory/README.md is the workspace's entry point: the sites, the
# open findings of each host's last housekeeping run and security
# audit, the hosts not reached within their cadence, and one line
# for each section whose facts no rule records yet. It counts and
# links, never repeating a host's detail. One a person wrote, without
# this script's first line, is left as it is.
#
# Local and read-only: it reads memory/topology.md,
# memory/machines/*/memory.md, memory/machines/*/guests.md and
# memory/clusters/*/{cluster,guests}.md, and each drawn host's
# changelog.log, and writes only under memory/maps/ and
# memory/README.md. It never reads memory/user.md, memory/blacklist.md,
# memory/readonly.md or memory/ssh_config — those are personal,
# never shared, and the maps are (rules/machine-memory.md → Personal
# versus shared). A `Role: workstation` host, and localhost and
# 127.0.0.1 by name, are personal the same way and never draw either
# (rules/network-topology.md → Excluded from the store).
#
# A gap in memory draws as "not known", never a guess; a fact this
# script cannot parse is left out of the diagram but still shown, as
# the source line, in the table. Every file starts with the comment
# hostwarden-wrap's own skip pattern recognises
# (bin/hostwarden-wrap → GENRE), so a generated table or Mermaid
# block is never rewrapped. Run again over unchanged memory on the
# same day, it writes the same bytes: node IDs derive from names, and
# every list this script builds is sorted before it is rendered.
# Across two different days the same memory can still change what it
# draws — a host's freshness crossing the 90-day staleness line
# (rules/machine-memory.md → Onboarded and stale lines) — since a map
# that never showed staleness would not be telling the truth either.
#
# `bin/hostwarden-sync commit` runs this before staging. On its own
# it runs on request, and POSIX sh and awk are all it needs — the one
# true awk included, macOS's own (#278).
set -u

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_DIR" || exit 1
# shellcheck source=../lib/mode.sh
. lib/mode.sh

usage() {
  awk 'NR == 1 { next } /^[^#]/ { exit } { sub(/^# ?/, ""); print }' \
    "$SCRIPT_DIR/${0##*/}"
}
die() { echo "hostwarden-map: $*" >&2; exit 1; }

case ${1:-} in
  -h | --help) usage; exit 0 ;;
  '') ;;
  *) usage >&2; exit 2 ;;
esac

hostwarden_mode "$REPO_DIR"
[ "$HOSTWARDEN_MODE" = operations ] \
  || die "draws the memory of an operations checkout, which this is not (AGENTS.md)"

M=memory
MAPS=$M/maps
# shellcheck disable=SC2034 # read in lib/hostwarden-map/
TODAY=$(date +%Y-%m-%d)
HWVERSION=$(cat VERSION 2>/dev/null) || HWVERSION=unknown
# A tab is IFS whitespace to `read` even when IFS holds nothing
# else, so it collapses a run of them and loses an empty field
# between two tabs — verified live, not folklore. Every TSV this
# script reads back with `read` (never with awk, which has no such
# problem) is first turned into this instead, one field per read
# --- the same reason bin/hostwarden-impact keeps a $TAB of its own,
# a level short of where it bites.
US=$(printf '\037')
# us <tsv> -- writes <tsv>.us beside it, $US in place of every tab.
us() { tr '\t' "$US" <"$1" >"$1.us"; }

WORK=$(mktemp -d "${TMPDIR:-/tmp}/hostwarden-map.XXXXXX") || die "no temp directory"
trap 'rm -rf "$WORK"' EXIT INT TERM

mkdir -p "$MAPS/sites" "$MAPS/clusters" "$MAPS/hosts" || die "cannot write $MAPS"

# The rest lives in lib/hostwarden-map/, one file per stage, sourced
# in this order into this shell: each reads what the ones before it
# set.
PARTS='palette read classify wan site cluster-host overview'
for part in $PARTS; do
  [ -f "$REPO_DIR/lib/hostwarden-map/$part.sh" ] || {
    echo "${0##*/}: lib/hostwarden-map/$part.sh is missing" >&2
    exit 1
  }
done
for part in $PARTS; do
  # shellcheck source=/dev/null
  . "$REPO_DIR/lib/hostwarden-map/$part.sh"
done

# --- step 9: the index -----------------------------------------------
{
  printf '<!-- Generated by bin/hostwarden-map from memory/maps/. Do not edit by hand. -->\n'
  echo
  echo "# Infrastructure maps"
  echo
  echo "Generated by \`bin/hostwarden-map\` from memory, never drawn or"
  echo "edited by hand. Each line is a level; its date is the newest"
  echo "source it was drawn from."
  echo
  printf -- '- [WAN](wan.md) — newest source %s\n' "${WAN_DATE:-not known}"
  if [ -s "$WORK/site-dates.tsv" ]; then
    echo "- Sites:"
    LC_ALL=C sort -t '	' -k1,1 "$WORK/site-dates.tsv" | while IFS='	' read -r s d; do
      [ -n "$s" ] || continue
      printf -- '  - [%s](sites/%s.md) — newest source %s\n' \
        "$s" "$(slug_sh "$s")" "${d:-not known}"
    done
  fi
  if [ -s "$WORK/cluster-dates.tsv" ]; then
    echo "- Clusters:"
    LC_ALL=C sort -t '	' -k1,1 "$WORK/cluster-dates.tsv" | while IFS='	' read -r cl d; do
      [ -n "$cl" ] || continue
      printf -- '  - [%s](clusters/%s.md) — newest source %s\n' \
        "$cl" "$(slug_sh "$cl")" "${d:-not known}"
    done
  fi
  if [ -s "$WORK/host-dates.tsv" ]; then
    echo "- Hypervisors outside a cluster:"
    LC_ALL=C sort -t '	' -k1,1 "$WORK/host-dates.tsv" | while IFS='	' read -r hv d; do
      [ -n "$hv" ] || continue
      printf -- '  - [%s](hosts/%s.md) — newest source %s\n' \
        "$hv" "$(slug_sh "$hv")" "${d:-not known}"
    done
  fi
  echo
  echo "Generated by Hostwarden $HWVERSION."
} >"$MAPS/README.md"

# A last check before this hands its exit status to
# bin/hostwarden-sync, which stages whatever is here as though the
# run succeeded: an awk step could still abort silently past the
# checks above (macOS's own awk, again; #278) without this catching
# it any other way. The index and the WAN level always exist and
# are never empty.
for f in "$MAPS/README.md" "$MAPS/wan.md"; do
  [ -s "$f" ] || die "$f was not written; the maps were not regenerated"
done
