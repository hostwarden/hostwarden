#!/bin/sh
# hostwarden-sync — keep the workspace in step with its
# remote, so a second machine or a teammate sees the same
# server memory.
#
# Usage:
#   hostwarden-sync pull         Bring in the remote's changes
#   hostwarden-sync commit MSG [PATH...]
#                                Commit PATHs (relative to the
#                                workspace or under memory/), or
#                                every change when none is named
#   hostwarden-sync push         Send local commits to the remote
#   hostwarden-sync --help       Show this help
#
# Each verb is silent and does nothing where there is
# nothing to do: in a development checkout, in a workspace
# without a remote, with no change to commit. pull rebases
# local commits onto the remote's and leaves a conflict
# alone: it is aborted, reported, and the workspace stays
# as it was. The remote must be private — the workspace
# holds hostnames, addresses and the network's layout.
#
# Several sessions can share one workspace. pull leaves it
# alone while it holds uncommitted changes — they belong to
# another session, or to one that ended before committing —
# rather than stash them from under that session. commit
# with PATHs takes only those files, whatever else another
# session has changed or staged, and waits out a moment when
# another session holds the index.
set -e

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_DIR"
# shellcheck source=../.claude/hooks/mode.sh
. .claude/hooks/mode.sh

usage() {
  awk '/^# hostwarden-sync/{in_help=1} in_help{if(/^[^#]/)exit; sub(/^# ?/,""); print}' \
    "$SCRIPT_DIR/hostwarden-sync"
}

hostwarden_mode "$REPO_DIR"
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  pull|push|commit) [ "$HOSTWARDEN_MODE" = operations ] || exit 0 ;;
  *) usage >&2; exit 1 ;;
esac

hostwarden_git_batch

W() { git -C memory "$@"; }
# The files a merge left unresolved, one per line.
conflicts() { W diff --name-only --diff-filter=U 2>/dev/null; }

# retry CMD... — run CMD, and run it again for a few seconds
# while another session's git holds the workspace's index.lock.
retry() {
  n=0
  while :; do
    if OUT=$("$@" 2>&1); then
      [ -z "$OUT" ] || printf '%s\n' "$OUT"
      return 0
    fi
    case "$OUT" in
      *index.lock*) n=$((n + 1)); [ "$n" -lt 10 ] && { sleep 1; continue; } ;;
    esac
    printf '%s\n' "$OUT" >&2
    return 1
  done
}

# The branch's upstream, or nothing when there is no remote
# to follow.
upstream() {
  W rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' \
    2>/dev/null || true
}

# A rebase, merge or conflict the user is in the middle of is
# theirs to finish. Pulling, committing or pushing across it
# would at best fail, at worst abort their half-resolved work or
# commit its conflict markers as server memory.
GITDIR=$(W rev-parse --git-dir 2>/dev/null) || exit 0
case "$GITDIR" in /*) ;; *) GITDIR="memory/$GITDIR" ;; esac
if [ -d "$GITDIR/rebase-merge" ] || [ -d "$GITDIR/rebase-apply" ] \
    || [ -f "$GITDIR/MERGE_HEAD" ] \
    || [ -n "$(conflicts)" ]; then
  echo "hostwarden: the workspace is in the middle of a rebase, a"
  echo "  merge or an unresolved conflict; finish it with git -C memory"
  echo "  first. Nothing synced."
  exit 0
fi

case "$1" in
pull)
  [ -n "$(upstream)" ] || exit 0
  # Uncommitted changes belong to another session, or to one
  # that ended before committing. Stashing them would pull
  # files out from under a session at work, and the stash is
  # shared by every session in this checkout.
  if [ -n "$(W status --porcelain)" ]; then
    echo "hostwarden: the workspace holds uncommitted changes, so it"
    echo "  was not brought up to date with its remote:"
    W status --short | sed 's/^/    /'
    echo "  rules/parallel-sessions.md -> The workspace says whose"
    echo "  they are and what to do with them."
    exit 0
  fi
  if ! OUT=$(W pull --quiet --rebase 2>&1); then
    W rebase --abort >/dev/null 2>&1 || true
    echo "hostwarden: the workspace could not be brought up to"
    echo "  date with its remote, and was left as it was:"
    printf '%s\n' "$OUT" | sed 's/^/    /'
    echo "  Resolve it with git -C memory pull before relying on"
    echo "  server memory another machine may have changed."
  fi
  ;;
commit)
  MSG="${2:?Usage: hostwarden-sync commit MESSAGE [PATH...]}"
  shift 2
  if [ "$#" -eq 0 ]; then
    retry W add -A
    W diff --cached --quiet && exit 0
    retry W commit --quiet -m "$MSG"
    exit 0
  fi
  # Named paths, relative to the workspace: memory/servers/x
  # and servers/x name the same file.
  n=$#
  while [ "$n" -gt 0 ]; do
    p=$1; shift; set -- "$@" "${p#memory/}"; n=$((n - 1))
  done
  retry W add -- "$@"
  W diff --cached --quiet -- "$@" && exit 0
  retry W commit --quiet -m "$MSG" -- "$@"
  ;;
push)
  [ -n "$(upstream)" ] || exit 0
  [ -n "$(W log --oneline '@{upstream}..' 2>/dev/null)" ] || exit 0
  W push --quiet
  ;;
esac
