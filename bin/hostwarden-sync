#!/bin/sh
# hostwarden-sync — keep the workspace in step with its
# remote, so a second machine or a teammate sees the same
# machine memory.
#
# Usage:
#   hostwarden-sync pull         Bring in the remote's changes,
#                                then write memory/ssh_config
#   hostwarden-sync commit MSG [PATH...]
#                                Redraw the infrastructure maps
#                                (hostwarden-map), then commit PATHs
#                                (relative to the workspace or under
#                                memory/), or every change when none
#                                is named, its Markdown rewrapped at
#                                80 (hostwarden-wrap --changed)
#   hostwarden-sync push         Send local commits to the remote
#   hostwarden-sync --help       Show this help
#
# Each verb is silent and does nothing where there is
# nothing to do: in a development checkout, in a workspace
# without a remote, with no change to commit. pull rebases
# local commits onto the remote's and leaves a conflict
# alone: it is aborted, reported, and the workspace stays
# as it was. The remote must be private — the workspace
# holds hostnames, addresses and the network's layout.
#
# Several sessions can share one workspace. Uncommitted
# changes in it belong to another session, or to one that
# ended before committing, so pull never stashes them from
# under that session: it only fast-forwards past them, and
# leaves the workspace alone when that is not possible.
# commit with PATHs takes only those files, whatever else
# another session has changed or staged, and waits out a
# moment when another session holds the index.
set -e

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_DIR"
# shellcheck source=../lib/mode.sh
. lib/mode.sh

usage() {
  awk 'NR == 1 { next } /^[^#]/ { exit } { sub(/^# ?/, ""); print }' \
    "$SCRIPT_DIR/${0##*/}"
}

hostwarden_mode "$REPO_DIR"
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  pull|push|commit) [ "$HOSTWARDEN_MODE" = operations ] || exit 0 ;;
  *) usage >&2; exit 1 ;;
esac

# Every pull ends by writing memory/ssh_config, whatever it
# found: a session start runs it, and a new memory/ssh_hosts may
# have come in with it. A workspace without a remote needs the file
# as much as one with. Its complaints go to stdout, like this
# script's own: that is what a session-start hook hands the session.
if [ "$1" = pull ]; then
  trap 'sh "$SCRIPT_DIR/hostwarden-ssh-config" 2>&1 || true' EXIT
fi

hostwarden_git_batch memory

W() { git -C memory "$@"; }
# The files a merge left unresolved, one per line.
conflicts() { W diff --name-only --diff-filter=U 2>/dev/null; }

# retry CMD... — run CMD, and run it again for a few seconds
# while another session's git holds the workspace's index.lock.
# A lock older than a minute is a crashed git's, not a busy
# one: that fails at once.
retry() {
  tries=0
  until OUT=$("$@" 2>&1); do
    case "$OUT" in
      *index.lock*)
        tries=$((tries + 1))
        if [ "$tries" -lt 10 ] \
            && [ -z "$(find "$GITDIR/index.lock" -mmin +1 2>/dev/null)" ]; then
          sleep 1; continue
        fi ;;
    esac
    printf '%s\n' "$OUT" >&2
    return 1
  done
}

# The branch's upstream, or nothing when there is no remote
# to follow.
upstream() {
  W rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' \
    2>/dev/null || true
}

# A rebase, merge, cherry-pick, revert or conflict the user is in
# the middle of is theirs to finish. Pulling, committing or pushing
# across it would at best fail, at worst abort their half-resolved
# work, commit its conflict markers as machine memory, or conclude a
# resolved cherry-pick under the journal headline.
GITDIR=$(W rev-parse --git-dir 2>/dev/null) || exit 0
case "$GITDIR" in /*) ;; *) GITDIR="memory/$GITDIR" ;; esac
if [ -d "$GITDIR/rebase-merge" ] || [ -d "$GITDIR/rebase-apply" ] \
    || [ -f "$GITDIR/MERGE_HEAD" ] || [ -f "$GITDIR/CHERRY_PICK_HEAD" ] \
    || [ -f "$GITDIR/REVERT_HEAD" ] || [ -d "$GITDIR/sequencer" ] \
    || [ -n "$(conflicts)" ]; then
  echo "hostwarden: the workspace is in the middle of a rebase, a"
  echo "  merge, a cherry-pick or revert, or an unresolved conflict;"
  echo "  finish it with git -C memory first. Nothing synced."
  exit 0
fi

case "$1" in
pull)
  [ -n "$(upstream)" ] || exit 0
  # With uncommitted changes, only a fast-forward: git refuses
  # it by itself where it would overwrite one of them.
  ST=$(W status --porcelain)
  if [ -n "$ST" ]; then
    W fetch --quiet \
      && W merge --quiet --ff-only '@{upstream}' >/dev/null 2>&1 \
      && exit 0
    echo "hostwarden: the workspace holds uncommitted changes, so it"
    echo "  was not brought up to date with its remote:"
    printf '%s\n' "$ST" | sed 's/^/    /'
    echo "  rules/parallel-sessions.md -> Changes a session left"
    echo "  behind says whose they are and what to do with them."
    exit 0
  fi
  # README.md and maps/ are drawn from the rest on every commit, so
  # where two machines both changed one, the version pulled is kept
  # and the next commit redraws it: the workspace's .gitattributes
  # names this driver for them. It keeps a side only when all three
  # versions carry hostwarden-map's first line, or both sides do and
  # there is no ancestor (both added it); a README.md a person
  # wrote merges as any other file does.
  GEN_DRIVER="sh -c 'm=\"<!-- Generated by bin/hostwarden-map \"; for f in \"\$1\" \"\$2\" \"\$3\"; do [ \"\$f\" = \"\$1\" ] && [ ! -s \"\$f\" ] && continue; case \$(head -n 1 \"\$f\") in \"\$m\"*) ;; *) exec git merge-file \"\$2\" \"\$1\" \"\$3\" ;; esac; done' - %O %A %B"
  if ! OUT=$(W -c merge.hostwarden-generated.name='generated by hostwarden-map' \
      -c merge.hostwarden-generated.driver="$GEN_DRIVER" pull --quiet --rebase 2>&1); then
    W rebase --abort >/dev/null 2>&1 || true
    echo "hostwarden: the workspace could not be brought up to"
    echo "  date with its remote, and was left as it was:"
    printf '%s\n' "$OUT" | sed 's/^/    /'
    echo "  Resolve it with git -C memory pull before relying on"
    echo "  machine memory another machine may have changed."
  fi
  ;;
commit)
  MSG="${2:?Usage: hostwarden-sync commit MESSAGE [PATH...]}"
  shift 2
  # No path means the whole workspace. Named paths are relative
  # to it: memory/machines/x and machines/x name the same file.
  [ "$#" -gt 0 ] || set -- .
  for p do shift; set -- "$@" "${p#memory/}"; done
  # The maps redraw before anything else is staged, so a map is
  # committed together with the memory it came from
  # (bin/hostwarden-map). A path list narrower than the whole
  # workspace still picks up what changed: maps/ and the overview
  # page, README.md, are added to it unless they, or the whole
  # workspace, are there already. A README.md a person wrote, which
  # hostwarden-map leaves alone, is committed only when named.
  if sh "$SCRIPT_DIR/hostwarden-map"; then
    case " $* " in
      *' . '* | *' maps '*) ;;
      *) set -- "$@" maps ;;
    esac
    case " $* " in
      *' . '* | *' README.md '*) ;;
      *) head -n 1 memory/README.md 2>/dev/null \
           | grep -q '^<!-- Generated by bin/hostwarden-map ' \
           && set -- "$@" README.md ;;
    esac
  else
    echo "hostwarden: bin/hostwarden-map failed; memory/maps/ was" >&2
    echo "  not regenerated" >&2
  fi
  # Markdown goes in wrapped at 80, whichever tool wrote it. What
  # the wrap cannot mend is committed as it is: a journal entry
  # matters more than its line lengths.
  (cd memory && sh "$SCRIPT_DIR/hostwarden-wrap" --changed -- "$@") \
    >/dev/null 2>&1 || true
  retry W add -- "$@"
  W diff --cached --quiet -- "$@" && exit 0
  retry W commit --quiet -m "$MSG" -- "$@"
  ;;
push)
  [ -n "$(upstream)" ] || exit 0
  [ -n "$(W log --oneline '@{upstream}..' 2>/dev/null)" ] || exit 0
  W push --quiet
  ;;
esac
