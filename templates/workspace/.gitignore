# Personal, never shared — not even when this workspace
# has a team remote (rules/server-memory.md). Every pattern
# starts at the workspace root: unanchored, user.md would
# match at any depth, and on macOS in any case.
/user.md
/opencode.json
/blacklist.md
/readonly.md
# The memory of this machine itself. Add the directory of
# your own hostname here as well.
/servers/localhost/
/servers/127.0.0.1/

.DS_Store
*.lock
# Written by bin/hostwarden-ssh-config for this machine alone.
/ssh_config
# What ssh-keygen -R leaves beside memory/known_hosts.
/known_hosts.old
# What a symlink probe leaves behind when it is interrupted.
.link-probe.*
