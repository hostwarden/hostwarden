# Personal, never shared — not even when this workspace
# has a team remote (rules/machine-memory.md). Every pattern
# starts at the workspace root: unanchored, user.md would
# match at any depth, and on macOS in any case.
/user.md
/opencode.json
/blacklist.md
/readonly.md
/refusals.log
# The memory of this machine itself. Its first local-mode
# connection adds its own directory here (rules/machine-memory.md);
# these two only cover a workspace from before that.
/machines/localhost/
/machines/127.0.0.1/

# What ansible-galaxy fetches beside a playbook tree, and
# ansible-lint's cache there (rules/workspace-playbook.md).
/infra/*/collections/
/infra/*/.ansible/
# What OpenTofu and Terragrunt fetch or write beside a stack, and a
# state or plan that must never be committed: both hold every
# attribute in the clear (rules/opentofu.md → State).
/infra/opentofu/**/.terraform/
/infra/opentofu/**/.terragrunt-cache/
/infra/opentofu/**/*.tfstate
/infra/opentofu/**/*.tfstate.*
/infra/opentofu/**/*.tfplan
/infra/opentofu/**/crash.log

.DS_Store
*.lock
# Written by bin/hostwarden-ssh-config for this machine alone.
/ssh_config
# What ssh-keygen -R leaves beside memory/known_hosts.
/known_hosts.old
# What a symlink probe leaves behind when it is interrupted.
.link-probe.*
