#!/bin/sh
# Master copy: Hostwarden workspace,
# fleet/fleet-read/files/usr/local/sbin/fleet-read.
# Edits here are kept and reported, not overwritten.
#
# fleet-read — the forced command of an operations host's key.
# The operator adds the key to root's authorized_keys as one line,
# the operations host's name as the one argument:
#
#   from="<address>",restrict,command="/usr/local/sbin/fleet-read <name>" <key>
#
# The key then reaches exactly two verbs, sent as the SSH command:
#
#   collect [<section>…]
#            stdin: an armored SSH signature, directly followed by
#            the bundle it signs. The bundle runs as this account
#            only when a key in $SIGNERS signed it for the namespace
#            $NS and its "# valid-until: YYYY-MM-DD" line is not
#            past. It runs from a private copy: the file that was
#            verified is the file that runs. Section names, at most
#            32, each a word of lowercase letters, digits and
#            underscores, pass to the bundle as its arguments, and
#            only names its
#            SECTIONS='…' line carries are passed: the signed bundle
#            decides what each name runs, this file never picks
#            lines out of it. A name the line does not carry, or a
#            bundle without the line, refuses the whole request
#            before anything runs.
#   log      stdin: one line. It goes to the journal under the tag
#            hostwarden, behind a prefix this file sets:
#            "[<name> as <user>] read-only: <line>".
#
# Anything else is refused before anything runs. No shell, no
# other command, no argument to log.
#
# Why a signature and not a list of allowed commands: the checks a
# host needs change with every housekeeping reference, and a list
# that could carry them would carry a shell. The signature moves
# the decision to the operator, whose signing key never lies on the
# operations host. Whoever takes that host over can replay a bundle
# the operator signed, until its date, whole or by its sections,
# and write read-only journal lines. Nothing else. Why not unsigned
# input: then this key would be root on every host that carries it.

set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

SIGNERS=/etc/fleet-read/allowed_signers
NS=fleet-read
MAX=262144
END='-----END SSH SIGNATURE-----'

fail() {
  echo "fleet-read: $1" >&2
  exit 1
}

[ "$#" -eq 1 ] || fail "the key's command must name the operations host"
NAME=$1
case $NAME in
  '' | *[!A-Za-z0-9._@-]*) fail "bad name in the key's command" ;;
esac
[ "${#NAME}" -le 64 ] || fail "bad name in the key's command"

case ${SSH_ORIGINAL_COMMAND:-} in
collect | 'collect '*)
  # The section names, split on blanks once every character has
  # been checked: nothing a shell would expand or a bundle would
  # misread gets as far as the split.
  WANT=${SSH_ORIGINAL_COMMAND#collect}
  # Counted, not tested for emptiness: a newline is one of the
  # characters to refuse, and command substitution would drop it.
  [ "$(printf '%s' "$WANT" | LC_ALL=C tr -d 'a-z0-9_ ' | wc -c)" -eq 0 ] \
    || fail "a section name is lowercase letters, digits and underscores"
  # shellcheck disable=SC2086 # the split is the point
  set -- $WANT
  [ "$#" -le 32 ] || fail "more than 32 section names"
  for s; do
    case $s in [a-z]*) ;; *) fail "a section name starts with a letter" ;; esac
    [ "${#s}" -le 40 ] || fail "section name longer than 40 characters"
  done
  [ -r "$SIGNERS" ] || fail "no $SIGNERS"
  DIR=$(mktemp -d) || fail "no temporary directory"
  trap 'rm -rf "$DIR"' EXIT
  trap 'exit 1' HUP INT TERM
  head -c $((MAX + 1)) >"$DIR/in"
  [ "$(wc -c <"$DIR/in" | tr -d ' ')" -le "$MAX" ] \
    || fail "input larger than $MAX bytes"
  [ "$(head -n 1 "$DIR/in")" = '-----BEGIN SSH SIGNATURE-----' ] \
    || fail "input does not start with a signature"
  grep -qx -- "$END" "$DIR/in" || fail "signature is not terminated"
  sed -n "1,/^$END\$/p" "$DIR/in" >"$DIR/sig"
  sed "1,/^$END\$/d" "$DIR/in" >"$DIR/bundle"
  [ -s "$DIR/bundle" ] || fail "no bundle after the signature"
  if ! ssh-keygen -Y verify -f "$SIGNERS" -I "$NS" -n "$NS" \
    -s "$DIR/sig" <"$DIR/bundle" >/dev/null 2>"$DIR/err"; then
    # OpenSSH before 8.1 has no -Y and says so as an option error.
    grep -qi 'option' "$DIR/err" \
      && fail "ssh-keygen here cannot verify signatures (needs OpenSSH 8.1)"
    fail "signature not valid"
  fi
  UNTIL=$(sed -n 's/^# valid-until: \([0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}\)$/\1/p' \
    "$DIR/bundle" | head -n 1)
  [ -n "$UNTIL" ] || fail "bundle has no valid-until line"
  [ "$(date -u +%Y%m%d)" -le "$(echo "$UNTIL" | tr -d -)" ] \
    || fail "bundle expired on $UNTIL"
  if [ "$#" -gt 0 ]; then
    # The names the signed bundle offers: its SECTIONS='…' line,
    # the one list its dispatcher runs from. A name it does not
    # carry stops the run here, so a typo reads nothing at all
    # rather than everything.
    HAVE=$(sed -n "s/^SECTIONS='\([a-z0-9_ ]*\)'\$/\1/p" "$DIR/bundle" \
      | head -n 1)
    [ -n "$HAVE" ] \
      || fail "bundle has no sections line; collect takes no names for it"
    for s; do
      case " $HAVE " in
        *" $s "*) ;;
        *) fail "no section '$s' in the bundle" ;;
      esac
    done
  fi
  cd /
  # set -e passes the bundle's exit status on; the trap cleans up.
  sh "$DIR/bundle" "$@" </dev/null
  ;;
log)
  LINE=$(head -c 1024 | head -n 1 | LC_ALL=C tr -cd '[:print:]' \
    | cut -c 1-250)
  [ -n "$LINE" ] || fail "empty line"
  exec logger -t hostwarden -- "[$NAME as $(id -un)] read-only: $LINE"
  ;;
*)
  fail "only collect and log are allowed"
  ;;
esac
